<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Index</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        
    </style>
</head>
<body class="polaroid">
    <a href="/h" class="hidden">home</a>

    <div class="left width60 col">
        <div class="top relative">
            <i class="fas fa-stethoscope absolute opacity1  top38 size90 h160 w160 padding20 corner500 porcelain" style="left: 120px;"></i>
            <div class="height0 width0 index50">
                <img src="/images/logo.png" alt="" class="corner500 h140">
            </div>
            <div class="col width0 alignStart colorPrimary index50">
                <p class="size90 str500">AuCare</p>
                <p class="size30 textWrap" style="margin-top:-25px !important;">PHINMA Araullo University South Campus</p>
            </div>
        </div>
        <div class="bottom justifyStart paddingInline75 paddingBottom70 paddingTop20">
            <section class=" h300 corner15 padding20 glass col alignStart gap15">
                <p class="size18 str500 marginLeft10 colorPrimary">Need Help? <a href="" class="inline sizeInherit underline">Learn More </a></p>
                <video class="abstractBG2 width100 height100 corner15" src="/image/video.mp4"></video>
            </section>
        </div>
    </div>
    <div class="right width40 col">
        <section class="down">
            <section class="bgWhite shadow1 width80 col padding20 gap10 corner15">
                <p class="size20 str500">Welcome User! New Here?</p>
                <a href="/s" class="nav snav width100">Get Started Here!</a>
            </section>
        </section>
        <div class="up height0 padding20">
            <form class="bgWhite shadow1 height0 gap10 padding30 width80" action="/login" method="POST">
                <p class="size20 str500">Already have an account?</p>
                  <% if (error) { %>
                  <section class="noteRed"><%= error %></section>
                  <% } %>
                <div class="field">
                    <label class="str500" for="username"> Username</label> 
                    <input type="text" name="username" placeholder="Enter your email" required>
                </div>
                <div class="field">
                    <label for="" class="str500"> Password </label>
                    <section class="padding0 relative">
                        <input type="password" name="password" placeholder="enter your password" id="" required >
                        <button type="button" class="absolute right10" style="top: 50%; transform: translateY(-50%);"><i class="fas fa-eye"></i></button>
                    </section>
                </div>
    
                <div class="row">
                    <input type="text" id="num1" class="width20 textCenter" value="" readonly> 
                    <div class="nav cnav border0"><i class="fas fa-plus"></i></div>
                    <input type="text" id="num2" class="width20 textCenter" value="" readonly> 
                    <div class="nav cnav border0"><i class="fas fa-equals"></i></div>
                    <input type="number" name="captcha_input" id="captcha_input" class="width20 textCenter" placeholder="" required> 
                    <input type="hidden" name="captcha_expected" id="captcha_expected">
                    
     <a id="refreshCaptcha" class="nav cnav marginLeft10">
        <i class="fas fa-rotate"></i>
    </a>
                </div>
                <div class="field">
                    <button type="submit" class="nav pnav  width100 ">Log In</button>
                </div>
                <a href="/f">Forgot Password</a>
            </form>
        </div>
        
    </div>
<script>
    function generateCaptcha() {
      // 1. Pick a random target sum between 50 and 100
        const total = Math.floor(Math.random() * 51) + 50; 
        
        // 2. Pick n1 to be anything less than the total (at least 1)
        const n1 = Math.floor(Math.random() * (total - 1)) + 1;
        
        // 3. n2 is simply the remainder
        const n2 = total - n1;
        
        document.getElementById('num1').value = n1;
        document.getElementById('num2').value = n2;
        document.getElementById('captcha_expected').value = n1 + n2;
        document.getElementById('captcha_input').value = ""; 
        // Reset color when generating new
        document.getElementById('captcha_input').style.color = "";
    }

    document.addEventListener('DOMContentLoaded', function() {
        generateCaptcha();

        const refreshBtn = document.getElementById('refreshCaptcha');
        if (refreshBtn) {
            refreshBtn.addEventListener('click', function(e) {
                e.preventDefault();
                generateCaptcha();
            });
        }

        // --- NEW LOGIC FOR COLOR FEEDBACK ---
        const captchaInput = document.getElementById('captcha_input');
        const captchaExpected = document.getElementById('captcha_expected');

        captchaInput.addEventListener('input', function() {
            const val = parseInt(this.value);
            const expected = parseInt(captchaExpected.value);

            if (this.value === "") {
                this.style.color = ""; // Neutral if empty
            } else if (val === expected) {
                this.style.color = "green"; // Correct
            } else {
                this.style.color = "red"; // Incorrect
            }
        });
    });
</script>
<script>
    document.querySelector('.fa-eye').parentElement.addEventListener('click', function(e) {
        e.preventDefault();
        const input = this.previousElementSibling;
        const icon = this.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    });
</script>
</body>
</html>