<% layout('layout') %>

<div class="height0 justifyBetween">
    <div class="width0">
        <p class="size40 str400">Employee Accounts Management</p>
    </div>
    <div class="width0 gap8 ">
        <a href="/ea" class="nav w100"> Archive</a>
    </div>
</div>

<br>


<div class="height0 justifyStart bgTint13 corner15 padding10">
    <div class="corner15 justifyStart wrap padding5 gap20">
        <% allAdmins.forEach(function(admin) { %>
            <a href="/emv/<%= admin._id %>" class="empCard height0 str500 width0 col bgWhite corner15 padding10 w200">
                <img class="h100 w100 shadow1 corner500" src="<%= admin.photo || '/images/profile.png' %>" alt="">
                <br>
                <p class="size18 textCenter textWrap"><%= admin.fName %> <%= admin.lName %></p>
                <p class="size14"><%= admin.role %></p>
            </a>
        <% }); %>
        <a href="/ne" class="height0 corner15 w200 col borderDotted borderGray padding10 relative">
                <div class="corner500 border0 h100 w100">
                    <i class="fas fa-plus absolute translateCenter size50 gray"></i>
                </div>
                <br>
                <p class="opacity0">Jess</p>
                <p class="opacity0">Admin</p>
        </a>
    </div>
</div>