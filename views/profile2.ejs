<% layout('template') %>
    <style>
        .mainf {
            padding: 0;
        }
        .shape {
            clip-path: polygon(0% 0%, 100% 0%, 80% 100%, 0% 100%);
        }
        .bura{
        border: 8px solid var(--tint2);

        }
        .profile-name{
        width:100%;
        text-align:center;
        overflow: hidden;
        font-weight:600;
        margin-top:10px;
    }

    .modal{
    position: fixed;
    inset: 0;
    width:100vw;
    height:100vh;
    background:rgba(0,0,0,.45);
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:99999;
    overflow-y: auto;
}
    .hidden{
        display:none;
    }
    .password-card{
        width:520px;
        max-width:95%;
        padding:25px;
        gap:18px;
        border-radius:18px;
    }

    .password-card h2{
        color:#0d3b66;
        font-size:30px;
        font-weight:500;
    }

    .password-note{
        display:flex;
        flex-direction:column;
        align-items:flex-start;
        gap:8px;

        border:1px solid #444;
        border-radius:12px;
        padding:10px 15px;
        width:100%;
        box-sizing:border-box;
    }

    .password-note p{
        margin:0;
        text-align:left;
    }

    .password-list{
        width:100%;
    }

    .password-item{
        position:relative;
        padding-left:18px;
        margin:6px 0;
        text-align:left;
        line-height:1.5;
    }

    .password-item::before{
    content:"•";
    position:absolute;
    left:0;
    top:50%;
    transform:translateY(-50%);
    font-size:18px;
    font-weight:bold;
    color:#000;
    line-height:1;
}


    .password-input{
        display:flex;
        align-items:center;
        border:1px solid #999;
        border-radius:14px;
        overflow:hidden;
    }

    .password-input input{
        border:none;
        flex:1;
        padding:14px;
        outline:none;
    }

    .password-input i{
        padding:15px;
        cursor:pointer;
    }

    .otp-row{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    flex-wrap:nowrap;
}


#getOtpBtn{
    flex-shrink:0;
    white-space:nowrap;
}

#getOtpBtn.disabled{
    opacity:0.5;
    pointer-events:none;
    cursor:not-allowed;
}

.otp-resend{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:6px;
    margin-bottom:2px;
    font-size:10px;
}

.otp-resend p{
    margin:0;
}

.otp-resend a{
    color:#0d3b66;
    font-weight:600;
    text-decoration:underline;
}

    .button-row{
        display:flex;
        justify-content:center;
        gap:25px;
    }

    .button-row button{
        width: 100%;
    }
    *{
        list-style:none;
    }
    ul{
        padding:0;
    }
    .password-list {
        list-style: disc;
        padding-left: 20px;
    }
    .field-error{
        color:red;
        font-size:12px;
        display:none;
        margin-top:-5px;
    }
    </style>

    <div class=" gap10 polaroid alignStart">
        <div class="padding10 width25 height100 col alignStart gap15">
            <a href="/h" class="nav"><i class="fas fa-chevron-left"></i> Return</a> 
            <div class="bgWhite corner15 justifyStart col padding20">
                <section class="col ">
                    <img class="h100 w100 bura corner500" src="/images/profile.png" alt="">
                    <p class="size28 colorPrimary profile-name">
                        <%= user.fName %> <%= user.mName %> <%= user.lName %> <%= user.xName %>
                    </p>
                    <p class="size16 blue"> <%= user.schoolId %></p>
                    <p class="size16 gray"><%= user.email %></p>
                </section>
                <section class="col gap5">
                    <a href="javascript:void(0)" id="openPassword" class="nav pnav width100">
                        Change Password
                    </a>
                    <a href="javascript:void(0)" id="openLogout" class="nav pnav width100">
                        Log Out
                    </a>
                </section>
            </div>
        </div>
        <div class="width75 col justifyStart padding15 gap15">
            <div class="height3"></div>
            <div class="height0 justifyBetween gap10 padding0">
                <p class="size28 str400 blue"></p>
                <a href="" class="nav gnav hidden"><i class="fas fa-check-circle"></i> Approve Account</a>
            </div>
        
                
            <div class="height0 gap10">
                <section class="left width50 bgWhite corner14 col alignStart gap5 padding15 borderGray relative height0">
                    <a href="javascript:void(0)" class="nav cnav absolute right16 top10 lgBtn" data-target="editForm"><i class="fas fa-pen"></i></a>
                    <p class="size20 str400">Personal Details</p>
                    <p class="size14 gray">Gender: <%= user.gender %></p>
                    <p class="size14 gray">Address: <%= user.address %></p>
                    <p class="size14 gray">Date of Birth: <%= user.bMonth %> <%= user.bDay %> <%= user.bYear %> </p>

                </section>
                <section class="left width50 bgWhite corner14 col alignStart gap5 padding15 borderGray relative height0">
                    <a href="javascript:void(0)" class="nav cnav absolute right16 top10 lgBtn" data-target="eseditForm"><i class="fas fa-pen"></i></a>
                    <p class="size20 str400">School Information</p>
                    <p class="size14 gray">School ID: <%= user.schoolId %></p>
                    <p class="size14 gray">Year Level: <%= user.yearLevel %></p>
                    <p class="size14 gray">Course: <%= user.course %></p>
                </section>
            </div>
            
            <div class="height0 justifyStart gap10 padding0 ">
                <section class="left width100 bgWhite corner14 col alignStart padding15 borderGray relative height0">
                    <a href="javascript:void(0)" class="nav cnav absolute right16 top10 lgBtn" data-target="eceditForm"><i class="fas fa-pen"></i></a>
                    <p class="size20 str400">Emergency Contact</p>
                    <p class="size14 gray">Name: <%= user.eName %></p>
                    <p class="size14 gray">Contact: <%= user.ePhone %></p>
                    <p class="size14 gray">Address: <%= user.eAddress %></p>
                </section>
            </div>
            
                <section class="left width100 bgWhite corner14 col alignStart gap5 padding10 borderGray relative height0">
                    <a href="javascript:void(0)" class="nav cnav absolute right16 top10 lgBtn" data-target="eaeditForm"><i class="fas fa-pen"></i></a>
                    <p class="size20 str400">Allergies</p>
                    <p class="size14 gray">Food Allergies: <%= user.fAllergy %></p>
                    <p class="size14 gray">Medicines Allergies: <%= user.mAllergy %></p>
        

                </section>
        </div>
    </div>

    <div id="modal" class="modal hidden">

    <!-- PASSWORD CARD -->
    <form id="passCard" class="password-card bgWhite corner15 shadow1 col padding5 hidden">
        <p class="size24 str500">Change Password</p>

        <div class="password-note padding0">
            <p class="size12"><strong class="str500">Take Note!</strong> Password must contain the following:</p>
            <ul class="password-list padding0">
                <li class="size12 password-item">At least 1 upper case letter</li>
                <li class="size12 password-item">At least 1 special character</li>
                <li class="size12 password-item">Combination of letter and number</li>
                <li class="size12 password-item">Minimum of 8 characters</li>
            </ul>
        </div>

        <div class="field">
            <label>Current Password</label>
            <div class="password-input">
                <input type="password" id="currentPassword">
                <i class="far fa-eye toggle-password"></i>
            </div>
        </div>

        <div class="field">
            <label>New Password</label>
            <div class="password-input">
                <input type="password" id="newPassword">
                <i class="far fa-eye toggle-password"></i>
            </div>
        </div>

        <div class="field">
            <label>Confirm Password</label>
            <div class="password-input">
                <input type="password" id="confirmPassword">
                <i class="far fa-eye-slash toggle-password"></i>
            </div>
        </div>

        <div class="col padding10 borderGray corner10 gap5">
            <div class="otp-row justifyBetween gap10">
                <a href="javascript:void(0)" id="getOtpBtn" class="nav pnav size12">Get OTP</a>
                <div class="field otp-field">
                    <input type="text" id="otpCode" maxlength="6" placeholder="Enter OTP code here">
                </div>
            </div>
            <div id="otpStatus" class="size13 gray"></div>
            <p id="otpTimer" class="size12 gray hidden"></p>
            <div class="otp-resend hidden" id="otpResendRow">
                <p class="alignStart">Didn't get the code?</p>
                <a href="javascript:void(0)" id="resendOtp">Resend</a>
            </div>
        </div>

        <p id="passError" class="size13" style="color:red; display:none;"></p>

        <div class="button-row">
            <button type="button" class="nav" id="closePassword">Cancel</button>
            <button type="button" class="nav pnav" id="submitPassword">Update</button>
        </div>
    </form>

    <!-- LOGOUT CARD -->
    <section class="width25 bgWhite corner15 col padding20 shadow1 relative hidden" id="lgCard">
        <div class="nav cnavLG">
            <i class="fas fa-sign-out-alt"></i>
        </div>
        <br>
        <p class="size18 textCenter textBalance">
            Are you sure you want to Log Out?
        </p>
        <br>
        <section class="padding0 justifyBetween gap10">
            <a href="javascript:void(0)" class="nav width100" id="closeLogout">Cancel</a>
            <a href="/" class="nav pnav width100">Log Out</a>
        </section>
    </section>

    <section class="absolute translateCenter shadow3 width30 padding30 gap10 index500 bgWhite col corner15 height0 hidden" id="notificationBox">
        <img class="h100 w100" src="/images/like.png" alt="">
            <section class="padding0 col alignCenter">
                <p class="size23 str500">Success</p>
                <p class="size17">Your password has been changed successfully.</p>
            </section>
        <a class="nav w120 size15" href="javascript:void(0)" id="gotItBtn">Got It!</a>
    </section>

        <!-- EDIT PERSONAL INFORMATION -->
        <form id="editForm" action="/profile2/update" method="POST" class="width40 col justifyStart alignStart padding20 gap5 height0 shadow1 absolute translateCenter hidden" style="z-index:700;" novalidate>
            <p class="size30 str500">Edit Personal Information</p>
            <div class="field">
                <section class="gap10 justifyStart">
                    <label>
                        <input type="radio" name="gender" value="Male" <%= user.gender === 'Male' ? 'checked' : '' %> required> Male
                    </label>
                    <label>
                        <input type="radio" name="gender" value="Female" <%= user.gender === 'Female' ? 'checked' : '' %> required> Female
                    </label>
                </section>
            </div>
                <section class="gap10">
                    <div class="field">
                        <label>First Name</label>
                        <input type="text" name="fName" id="editFName" value="<%= user.fName %>" maxlength="50" pattern="^[A-Za-z\s\-']+$" title="Letters, spaces, hyphens and apostrophes only" required>
                    </div>
                    <div class="field">
                        <label>Middle Name</label>
                        <input type="text" name="mName" id="editMName" value="<%= user.mName %>" maxlength="50" pattern="^[A-Za-z\s\-']*$" title="Letters, spaces, hyphens and apostrophes only">
                    </div>
                </section>
                <section class="gap10">
                    <div class="field">
                        <label>Last Name</label>
                        <input type="text" name="lName" id="editLName" value="<%= user.lName %>" maxlength="50" pattern="^[A-Za-z\s\-']+$" title="Letters, spaces, hyphens and apostrophes only" required>
                    </div>
                    <div class="field">
                        <label>Extension Name</label>
                        <input type="text" name="xName" id="editXName" value="<%= user.xName %>" maxlength="10" pattern="^[A-Za-z.\s]*$" title="e.g. Jr., Sr., III" placeholder="e.g. Jr., III">
                    </div>
                </section>
                <section class="gap10">
                    <div class="field">
                        <label>Email</label>
                        <input type="email" name="email" id="editEmail" value="<%= user.email %>" maxlength="100" required>
                    </div>
                    <div class="field">
                        <label>Contact Number</label>
                        <input type="tel" name="phone" id="editPhone" value="<%= user.phone %>" placeholder="09XXXXXXXXX" inputmode="numeric" maxlength="11" pattern="^09[0-9]{9}$" title="Enter an 11-digit PH mobile number starting with 09" required>
                    </div>
                </section>
                <section>
                    <div class="field">
                        <label>Address</label>
                        <input type="text" name="address" id="editAddress" value="<%= user.address %>" maxlength="150" required>
                    </div>
                </section>
                <div class="field padding10">
                    <label>Date of Birth</label>
                    <div class="row gap5">
                        <div class="selectBar">
                            <select name="bMonth" id="bMonth" required>
                                <option value="" selected disabled>--Month--</option>
                                <option value="1">01</option>
                                <option value="2">02</option>
                                <option value="3">03</option>
                                <option value="4">04</option>
                                <option value="5">05</option>
                                <option value="6">06</option>
                                <option value="7">07</option>
                                <option value="8">08</option>
                                <option value="9">09</option>
                                <option value="10">10</option>
                                <option value="11">11</option>
                                <option value="12">12</option>
                            </select>
                        </div>
                        <input type="text" name="bDay" id="bDay" placeholder="Day" inputmode="numeric" maxlength="2" required>
                        <div class="selectBar">
                            <select name="bYear" id="bYear" required>
                                <option value="" selected disabled>--Year--</option>
                                <% const currentYear = new Date().getFullYear(); %>
                                <% for (let y = currentYear - 10; y >= currentYear - 80; y--) { %>
                                    <option value="<%= y %>"><%= y %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>
                    <p class="field-error" id="dobError"></p>
                </div>
                <p class="field-error"></p>
                <section class="gap20">
                    <a href="javascript:void(0)" class="nav width100 closeEditBtn">Cancel</a>
                    <button type="submit" class="nav pnav width100">Save Changes</button>
                </section>
    </form>

