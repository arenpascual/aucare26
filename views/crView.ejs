<% layout('layout') %>
<style>
    .headf { display: none; }

    .modal-overlay {
        display: none;
        position: absolute;
        top: 0;
        left: 0;
        width: 35%;
        height: auto;
        z-index: 999;
        margin-left: 350px;
        margin-top: 200px;
        align-items: center;
        justify-content: center;
    }
    .modal-overlay.active {
        display: flex;
    }
</style>

<%
const visit = v;
const complaints = v.complaints || [];
const dispensedMedicines  = v.dispensed || [];
%>

<div class="polaroid gap0 colorPrimary justifyEnd relative">
    <a href="/cr/<%= visit.patient._id %>" class="nav cnav absolute left20 top20"><i class="fas fa-chevron-left"></i></a>

    <div class="col justifyStart padding10 gap10 width45">
        <section class="justifyBetween gap10 padding0 paddingInline10">
            <p class="size16 str500"><%= v.createdAt ? 
                new Date(v.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' ' + 
                new Date(v.createdAt).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }).toLowerCase().replace(' ', '') 
                : 'No Date' %>
            </p>
            <section class="width0 gap5">
                <p class="size16">Status: </p>
                <p class="size16 str500"> <i class="fas fa-check-square green"></i> <%= v.status %></p>
            </section>
        </section>

        <section class="glass bgWhite col alignStart colorPrimary padding20 borderWhite">
            <p class="size16"><i class="fas fa-user w20"></i> <%= v.patient ? v.patient.fName + ' ' + v.patient.lName : 'Unknown Patient' %></p>
            <p class="size16"><i class="fas fa-check-circle w20"></i> <%= v.patient ? v.patient.role : 'N/A' %></p>
            <p class="size16"><i class="fas fa-address-book w20"></i> <%= v.patient ? v.patient.schoolId : 'No ID' %></p>
            <p class="size16 textWrap">
                <i class="fas fa-layer-group w20"></i> 
                <%= v.patient ? v.patient.yearLevel : 'N/A' %> &bull; <%= v.patient ? v.patient.course : 'N/A' %>
            </p>
            <p class="size16"><i class="fas fa-phone w20"></i> <%= v.patient && v.patient.phone ? v.patient.phone : 'No Contact' %></p>
            <p class="size16"><i class="fas fa-envelope w20"></i> <%= v.patient ? v.patient.email : 'No Email' %></p>
            
            <% if (v.patientAllergies && v.patientAllergies.length > 0) { %>
                <div class="padding10 corner10 bgRed size14 str500 colorWhite marginT10">
                    <i class="fas fa-exclamation-triangle"></i> Allergies: <%= v.patientAllergies.map(a => a.isAllergy).join(', ') %>
                </div>
            <% } %>
        </section>

        <section class="col alignStart colorPrimary padding10">
            <section class="padding0 justifyBetween">
                <p class="size18 str500">Vital Sign</p>
                <button id="openVitals" class="nav cnav glass shadowNone pointer"><i class="fas fa-pen"></i></button>
            </section>
            <section class="gap20 justifyStart">
                <div class="col width20">
                    <img src="/images/bp.png" alt="" class="corner500 bgWhite h60 w60 porcelain padding5">
                    <p class="size18 str500"><%= v.bloodPressure?.systolic || '--' %> / <%= v.bloodPressure?.diastolic || '--' %></p>
                    <p class="size12">Blood Pressure</p>
                </div>
                <div class="col width20">
                    <img src="/images/hb.png" alt="" class="corner500 bgWhite h60 w60 porcelain padding5">
                    <p class="size18 str500"><%= v.hBeat || '--' %></p>
                    <p class="size12">Heart Rate</p>
                </div>
                <div class="col width20">
                    <img src="/images/fever.png" alt="" class="corner500 bgWhite h60 w60 porcelain padding5">
                    <p class="size18 str500"><%= v.temperature || '--' %>°C</p>
                    <p class="size12">Temperature</p>
                </div>
            </section>
        </section>

        <section class="bgWhite corner10 justifyBetween gap10 padding0 paddingInline10">
            <section class="gap5 justifyBetween">
                <p class="size18 str500 width20">Concern:</p>
                <p class="size18 str500 navy textWrap"><%= v.concern %></p>
            </section>
        </section>

        <section class="glass col alignStart colorPrimary padding20 borderWhite"> 
            <section class="padding0 justifyBetween">
                <p class="size18 str500">Complaint</p>
                <button id="openComplaint" class="nav cnav glass shadowNone pointer"><i class="fas fa-plus"></i></button>
            </section>
            <section class="gap30 justifyStart padding0" style="align-items: start !important;">
                <% if (v.complaints && v.complaints.length > 0) { %>
                    <% v.complaints.forEach(item => { %>
                        <div class="col width0 gap3 justifyStart padding0" style="max-width: 100px !important;">
                            <section class="width0 padding0 relative" style="border-bottom-left-radius: 50%; border-bottom-right-radius: 50%;">
                                <img src="/images/<%= item.type %>.png" onerror="this.src='/images/item.png'" alt="" class="corner500 bgWhite h60 w60 porcelain padding5">
                                <form action="/visit/complaint2/delete/<%= item._id %>" method="POST" class="absolute right0 top0 corner500 height0 width0 padding0">
                                    <button type="submit" class="h20 w20 corner500 pointer"><i class="fa-solid fa-circle-minus red h15 w15"></i></button>
                                </form>
                            </section>
                            <p class="size14 str500 textCenter"><%= item.type %></p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="size16 opacity50">No complaints recorded.</p>
                <% } %>
            </section>
        </section>
    </div>

    <div class="col justifyStart padding10 paddingInline15 colorPrimary gap15 width50">

        
        <% if (v.status !== "Attended") { %>
        <section class="glass justifyBetween colorPrimary borderWhite">
            <p class="size16">Action Panel</p>
            <section class="padding0 width0 gap10">
                <% if (!v.treatment || v.treatment.length === 0) { %>
                    <button id="openTreatment1" class="nav pointer"><i class="fas fa-plus"></i> Treatment</button>
                <% } %>
                <% if (v.dispensed && v.dispensed.length === 0) { %>
                <button id="openMedicine1" class="nav pointer"><i class="fas fa-plus"></i> Medicine</button>
                <% } %>
                <button id="successVisit" class="nav gnav pointer"><i class="fas fa-check-circle"></i> Done Attending</button>
            </section>
        </section>
        <% } %>

        <% if (v.treatment && v.treatment.length > 0) { %>
            <section class="glass borderWhite col gap5 alignStart colorPrimary">
                <section class="padding0 justifyBetween">
                    <p class="size22 str500">Treatment</p>
                    <button id="openTreatment2" class="nav cnav pointer"><i class="fas fa-pen"></i></button>
                </section>
                <section class="bgWhite corner10 padding15 width100">
                    <p class="size14"><%= v.treatment || 'No treatment details provided.' %></p>
                </section>
            </section>
        <% } %>
        
        <% if (v.dispensed && v.dispensed.length > 0) { %>
        <section class="col alignStart gap10 padding15">
            <section class="padding0 justifyBetween">
                <p class="size22 str500">Medication</p>
                <button id="openMedicine2" class="nav cnav pointer"><i class="fas fa-plus"></i></button>
            </section>
            
            <% if (v.dispensed && v.dispensed.length > 0) { %>
                <% v.dispensed.forEach(med => { %>
                    <section class="padding5 gap5 bgWhite justifyStart corner16 shadow1 relative">
                        <img src="/images/item.png" alt="" class="h80 width0">
                        <section class="col padding0 alignStart">
                            <p class="size18 str500"><%= med.item %></p>
                            <p class="size14 str400 textWrap"><%= med.remarks %></p>
                        </section>
                        <p class="size14 str500 absolute right15 top15"><%= med.qty %> piece(s)</p>
                        <form action="/visit/medicine2/delete/<%= med._id %>" method="POST" class="corner0 height0 width0 absolute right10 bottom5 padding0">
                            <button type="submit" class="pointer size12 nav red str600 borderNone">
                                <i class="fas fa-trash"></i> Remove
                            </button>
                        </form>
                    </section>
                <% }) %>
            <% } else { %>
                <p class="opacity50 size14">No medicine dispensed.</p>
            <% } %>
        </section>
        <% } %>

        
    </div>
</div>

<div id="vitalModal" class="modal-overlay shadow1 corner20">
    <div class="modal-content bgWhite padding20 corner16 col gap0">
        <section class="justifyCenter gap10">
            <p class="size24 str600 colorPrimary textCenter">Vital Signs</p>
            <% if(v.hBeat || v.bloodPressure?.systolic || v.temperature) { %>
                <form action="/visit/vitals2/delete/<%= v._id %>" method="POST" class="height0 padding0 width50 alignEnd corner0">
                    <button type="submit" class="nav borderNone pointer">Clear All</button>
                </form>
            <% } %>
        </section>

        <form action="/visit/vitals2/<%= v._id %>" method="POST" class="col alignStart width100" id="vitalsForm">
            <section class="row gap10 width100 padding0">
                <section class="col width100 alignStart padding0">
                    <label class="size12 opacity50">Blood Pressure (Sys/Dia)</label>
                    <section class="row gap10 width100 padding0">
                        <input type="number" name="systolic" placeholder="120" class="input width100" min="40" max="300" step="1" inputmode="numeric" value="<%= v.bloodPressure?.systolic %>">
                        <input type="number" name="diastolic" placeholder="80" class="input width100" min="20" max="200" step="1" inputmode="numeric" value="<%= v.bloodPressure?.diastolic %>">
                    </section>
                </section>
            </section>

            <section class="row gap10 width100 padding0">
                <section class="col width50 alignStart gap5 padding0">
                    <label class="size12 opacity50">Heart Rate (bpm)</label>
                    <input type="number" name="hBeat" placeholder="72" class="input width100" min="20" max="250" step="1" inputmode="numeric" value="<%= v.hBeat %>">
                </section>
                <section class="col width50 alignStart gap5 padding0">
                    <label class="size12 opacity50">Temperature (°C)</label>
                    <input type="number" name="temperature" placeholder="36.5" class="input width100" min="30" max="45" step="0.1" inputmode="decimal" value="<%= v.temperature %>" required>
                </section>
            </section>
            <p id="vitalsError" class="size12" style="color:red; display:none;"></p>

            <br>
            
            <section class="justifyBetween gap10 padding0">
                <a href="#" class="nav width50 closeModal">Cancel</a>
                <button type="submit" class="nav pnav pointer width50">Update Vitals</button>
            </section>
        </form>
    </div>
</div>

<div id="treatmentModal" class="modal-overlay">
    <div class="modal-content glass bgWhite padding20 corner16 col gap15">
        <section class="justifyBetween padding0">
            <p class="size20 str600 colorPrimary">Treatment</p>
            <% if(v.treatment) { %>
                <form action="/visit/treatment2/delete/<%= v._id %>" method="POST" class="width0 height0">
                    <button type="submit" class="nav red borderNone pointer size12">Remove</button>
                </form>
            <% } %>
        </section>
        <form action="/visit/update-treatment2/<%= v._id %>" method="POST" class="col gap10 width100" id="treatmentForm">
            <textarea name="treatment" class="input width100" rows="5" placeholder="Enter treatment..." maxlength="1000" required><%= v.treatment %></textarea>
            <p id="treatmentError" class="size12" style="color:red; display:none;"></p>
            <br>
            <section class="justifyBetween gap10">
                <a href="#" class="nav width50 closeModal">Cancel</a>
                <button type="submit" class="nav pnav pointer width50 "> Save Treatment</button>
            </section>
        </form>
    </div>
</div>

<div id="medicineModal" class="modal-overlay">
    <div class="modal-content bgWhite padding20 corner16 col gap15">
        <a href="#" id="lgBtn" class="nav cnav absolute right10 top10"><i class="fas fa-times"></i></a>
        <p class="size20 str600 colorPrimary">Dispense Medicine</p>

        <% const availableMedicines = (typeof medicines !== 'undefined' ? medicines : []).filter(m => m.remaining > 0); %>

        <% if (availableMedicines.length === 0) { %>
            <div class="padding10 corner10 size14 str500 colorWhite">
                <i class="fas fa-exclamation-triangle"></i> No medicines currently in stock.
            </div>
        <% } else { %>
            <form action="/visit/add-medicine2/<%= v._id %>" method="POST" class="col gap10 alignStart width100" id="dispenseMedicineForm">

                <div class="col alignStart gap5 width100">
                    <label class="size12 opacity50">Medicine Name</label>
                    <div class="selectBar width100" style="width: 100% !important; min-width: 100%;">
                        <select name="item" id="medicineSelect" class="input" required>
                            <option value="" disabled selected>Select Medicine</option>
                            <% availableMedicines.forEach(m => { %>
                                <option
                                    value="<%= m.name %>"
                                    data-unit="<%= m.unit %>"
                                    data-remaining="<%= m.remaining %>">
                                    <%= m.name %><% if (m.brandName) { %> (<%= m.brandName %>)<% } %> — <%= m.remaining %> <%= m.unit %> left
                                </option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div class="row gap10 width100">
                    <div class="col width50 alignStart gap5">
                        <label class="size12 opacity50">Qty</label>
                        <input type="number" name="qty" id="qtyInput" placeholder="Qty" class="input width100" min="1" step="1" inputmode="numeric" required>
                    </div>
                    <div class="col width50 alignStart gap5">
                        <label class="size12 opacity50">Unit</label>
                        <input type="text" name="unit" id="unitInput" placeholder="Unit" class="input width100" readonly required>
                    </div>
                </div>
                <div class="section justifyStart">
                    <p id="qtyHint" class="size12 gray"></p>
                </div>

                <textarea name="remarks" class="input width100" placeholder="Instructions (e.g. 1 tab after meal)" maxlength="300" required></textarea>

                <p id="dispenseError" class="size13" style="color:red; display:none;"></p>

                <br>
                <button type="submit" class="nav pnav pointer borderNone width100" id="dispenseSubmitBtn"><i class="fas fa-plus"></i> Add Medicine(s)</button>
            </form>
        <% } %>
    </div>
</div>

<div id="complaintModal" class="modal-overlay">
    <div class="modal-content bgWhite padding20 corner16 col gap15 corner20 shadow1">
        <p class="size20 str600 colorPrimary">Add Complaint</p>
        <form action="/visit/complaint2/add/<%= v._id %>" method="POST" class="col gap10 alignStart width100" id="complaintForm">
            <div class="field width100">
                <label for="complaintSelect" class="size12 opacity50">Complaint</label>
                <div class="selectBar width100" style="width: 100% !important; min-width: 100%;">
                    <select name="type" id="complaintSelect" class="input" required>
                        <option value="" disabled selected>Select Complaint</option>
                        <option value="Abdominal Pain Cramps">Abdominal pain/cramps</option>
                        <option value="Allergy">Allergy</option>
                        <option value="Body Muscle Pain">Body/Muscle pain</option>
                        <option value="Colds">Colds</option>
                        <option value="Cough">Cough</option>
                        <option value="Difficulty of Breathing">Difficulty of Breathing</option>
                        <option value="Dizziness">Dizziness</option>
                        <option value="Dysmenorrhea Menstrual Cramps">Dysmenorrhea/Menstrual cramps</option>
                        <option value="Fever">Fever</option>
                        <option value="Headache">Headache</option>
                        <option value="Hyperacidity">Hyperacidity</option>
                        <option value="Lbm">LBM</option>
                        <option value="Toothache">Toothache</option>
                        <option value="Others">Others</option>
                    </select>
                </div>
            </div>

            <div id="othersFieldWrap" class="field width100" style="display:none;">
                <label for="othersInput" class="size12 opacity50">Please specify</label>
                <input type="text" name="typeOther" id="othersInput" placeholder="Specify complaint" class="input width100" maxlength="50">
            </div>

            <p id="complaintError" class="size12" style="color:red; display:none;"></p>
            <br>
            <section class="justifyBetween gap10 width100">
                <a href="#" class="nav width50 closeModal">Cancel</a>
                <button type="submit" class="nav pnav pointer borderNone width50">Add Complaint</button>
            </section>
        </form>
    </div>
</div>

<div id="successModal" class="modal-overlay">
    <div class="modal-content glass bgWhite padding20 corner16 col gap15">
        <p class="size20 str600 colorPrimary">Confirm</p>
        <p class="size14">Mark this visit as attended?</p>
        <form id="successForm" method="POST" class="col gap10 width100">
            <section class="justifyBetween gap10">
                <a href="#" id="cancelSuccess" class="nav width50">Cancel</a>
                <button type="submit" class="nav pnav pointer width50">Confirm</button>
            </section>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const modalButtons = {
        'openVitals': 'vitalModal',
        'openComplaint': 'complaintModal',
        'openTreatment1': 'treatmentModal',
        'openTreatment2': 'treatmentModal',
        'openMedicine1': 'medicineModal',
        'openMedicine2': 'medicineModal'
    };

    function openModal(modal) {
        if (modal) modal.classList.add('active');
    }
    function closeModal(modal) {
        if (modal) modal.classList.remove('active');
    }

    Object.keys(modalButtons).forEach(btnId => {
        const btn = document.getElementById(btnId);
        if (btn) {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                openModal(document.getElementById(modalButtons[btnId]));
            });
        }
    });

    document.querySelectorAll('.modal-overlay').forEach(modal => {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal(modal);
            }
        });
    });

    document.querySelectorAll('.closeModal, #lgBtn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            closeModal(btn.closest('.modal-overlay'));
        });
    });
});
</script>

<script>
(function(){
    const vitalsForm = document.getElementById('vitalsForm');
    const vitalsError = document.getElementById('vitalsError');

    if (vitalsForm) {
        const systolicInput = vitalsForm.querySelector('[name="systolic"]');
        const diastolicInput = vitalsForm.querySelector('[name="diastolic"]');
        const hBeatInput = vitalsForm.querySelector('[name="hBeat"]');
        const temperatureInput = vitalsForm.querySelector('[name="temperature"]');

        function clampLive(input, allowDecimal){
            input.addEventListener('input', () => {
                let raw = input.value;
                raw = allowDecimal ? raw.replace(/[^0-9.]/g, '') : raw.replace(/[^0-9]/g, '');

                if (allowDecimal) {
                    const parts = raw.split('.');
                    if (parts.length > 2) raw = parts[0] + '.' + parts.slice(1).join('');
                }

                if (raw === '' || raw === '.') {
                    input.value = raw;
                    return;
                }

                const min = input.hasAttribute('min') ? Number(input.getAttribute('min')) : null;
                const max = input.hasAttribute('max') ? Number(input.getAttribute('max')) : null;
                const num = Number(raw);

                if (max !== null && num > max) {
                    raw = String(max);
                }
                input.value = raw;
            });
        }

        clampLive(systolicInput, false);
        clampLive(diastolicInput, false);
        clampLive(hBeatInput, false);
        clampLive(temperatureInput, true);

        function showVitalsError(msg){
            vitalsError.textContent = msg;
            vitalsError.style.display = "block";
        }
        function clearVitalsError(){
            vitalsError.style.display = "none";
            vitalsError.textContent = "";
        }

        vitalsForm.addEventListener('submit', (e) => {
            clearVitalsError();

            const sys = systolicInput.value.trim();
            const dia = diastolicInput.value.trim();
            const hb = hBeatInput.value.trim();
            const temp = temperatureInput.value.trim();

            if ((sys && !dia) || (dia && !sys)) {
                e.preventDefault();
                return showVitalsError("Please fill in both systolic and diastolic values.");
            }

            if (sys && (Number(sys) < 40 || Number(sys) > 300)) {
                e.preventDefault();
                return showVitalsError("Systolic must be between 40 and 300 mmHg.");
            }
            if (dia && (Number(dia) < 20 || Number(dia) > 200)) {
                e.preventDefault();
                return showVitalsError("Diastolic must be between 20 and 200 mmHg.");
            }
            if (sys && dia && Number(dia) >= Number(sys)) {
                e.preventDefault();
                return showVitalsError("Diastolic must be lower than systolic.");
            }
            if (hb && (Number(hb) < 20 || Number(hb) > 250)) {
                e.preventDefault();
                return showVitalsError("Heart rate must be between 20 and 250 bpm.");
            }
            if (!temp) {
                e.preventDefault();
                return showVitalsError("Temperature is required.");
            }
            if (Number(temp) < 30 || Number(temp) > 45) {
                e.preventDefault();
                return showVitalsError("Temperature must be between 30°C and 45°C.");
            }
        });
    }

    const treatmentForm = document.getElementById('treatmentForm');
    const treatmentError = document.getElementById('treatmentError');

    if (treatmentForm) {
        const textarea = treatmentForm.querySelector('[name="treatment"]');

        treatmentForm.addEventListener('submit', (e) => {
            treatmentError.style.display = "none";
            const val = textarea.value.trim();
            if (!val) {
                e.preventDefault();
                treatmentError.textContent = "Treatment details cannot be empty.";
                treatmentError.style.display = "block";
                return;
            }
            if (val.length > 1000) {
                e.preventDefault();
                treatmentError.textContent = "Treatment details must be 1000 characters or fewer.";
                treatmentError.style.display = "block";
            }
        });
    }

    const complaintForm = document.getElementById('complaintForm');
    const complaintError = document.getElementById('complaintError');

    if (complaintForm) {
        const typeSelect = complaintForm.querySelector('[name="type"]');
        const othersWrap = document.getElementById('othersFieldWrap');
        const othersInput = document.getElementById('othersInput');
        const pattern = /^[A-Za-z\s\-]+$/;

        function clearComplaintError(){
            complaintError.style.display = "none";
            complaintError.textContent = "";
        }

        typeSelect.addEventListener('change', () => {
            clearComplaintError();
            if (typeSelect.value === 'Others') {
                othersWrap.style.display = 'flex';
                othersInput.setAttribute('required', 'required');
            } else {
                othersWrap.style.display = 'none';
                othersInput.removeAttribute('required');
                othersInput.value = '';
            }
        });

        complaintForm.addEventListener('submit', (e) => {
            clearComplaintError();

            const selected = typeSelect.value;

            if (!selected) {
                e.preventDefault();
                complaintError.textContent = "Please select a complaint.";
                complaintError.style.display = "block";
                return;
            }

            if (selected === 'Others') {
                const otherVal = othersInput.value.trim();
                if (!otherVal) {
                    e.preventDefault();
                    complaintError.textContent = "Please specify the complaint.";
                    complaintError.style.display = "block";
                    return;
                }
                if (otherVal.length > 50) {
                    e.preventDefault();
                    complaintError.textContent = "Complaint must be 50 characters or fewer.";
                    complaintError.style.display = "block";
                    return;
                }
                if (!pattern.test(otherVal)) {
                    e.preventDefault();
                    complaintError.textContent = "Only letters, spaces and hyphens are allowed.";
                    complaintError.style.display = "block";
                    return;
                }
                typeSelect.removeAttribute('name');
                othersInput.setAttribute('name', 'type');
            }
        });
    }
})();
</script>

<script>
(function(){
    const medicineSelect = document.getElementById('medicineSelect');
    if (!medicineSelect) return;

    const qtyInput = document.getElementById('qtyInput');
    const unitInput = document.getElementById('unitInput');
    const qtyHint = document.getElementById('qtyHint');
    const dispenseError = document.getElementById('dispenseError');
    const form = document.getElementById('dispenseMedicineForm');

    function getSelectedOption(){
        return medicineSelect.options[medicineSelect.selectedIndex];
    }

    function showDispenseError(msg){
        dispenseError.textContent = msg;
        dispenseError.style.display = "block";
    }
    function clearDispenseError(){
        dispenseError.style.display = "none";
        dispenseError.textContent = "";
    }

    medicineSelect.addEventListener('change', () => {
        const opt = getSelectedOption();
        clearDispenseError();

        if (!opt || !opt.value) {
            unitInput.value = "";
            qtyHint.textContent = "";
            qtyInput.removeAttribute('max');
            return;
        }

        const unit = opt.getAttribute('data-unit') || "";
        const remaining = parseInt(opt.getAttribute('data-remaining') || "0", 10);

        unitInput.value = unit;
        qtyHint.textContent = `Available: ${remaining} ${unit}`;
        qtyInput.setAttribute('max', remaining);
        qtyInput.value = "";
    });

    qtyInput.addEventListener('input', () => {
        let raw = qtyInput.value.replace(/[^0-9]/g, '');
        const max = qtyInput.hasAttribute('max') ? parseInt(qtyInput.getAttribute('max'), 10) : null;

        if (raw !== '' && max !== null && parseInt(raw, 10) > max) {
            raw = String(max);
        }
        qtyInput.value = raw;
    });

    form.addEventListener('submit', (e) => {
        clearDispenseError();

        const opt = getSelectedOption();
        if (!opt || !opt.value) {
            e.preventDefault();
            return showDispenseError("Please select a medicine.");
        }

        const remaining = parseInt(opt.getAttribute('data-remaining') || "0", 10);
        const qty = parseInt(qtyInput.value || "0", 10);
        const remarks = form.querySelector('[name="remarks"]').value.trim();

        if (qty <= 0 || isNaN(qty)) {
            e.preventDefault();
            return showDispenseError("Please enter a valid quantity.");
        }

        if (qty > remaining) {
            e.preventDefault();
            return showDispenseError(`Only ${remaining} ${unitInput.value} left in stock.`);
        }

        if (!remarks) {
            e.preventDefault();
            return showDispenseError("Please enter dosage instructions/remarks.");
        }

        if (remarks.length > 300) {
            e.preventDefault();
            return showDispenseError("Instructions must be 300 characters or fewer.");
        }
    });
})();
</script>

<script>
(function(){
    const successBtn = document.getElementById("successVisit");
    const successModal = document.getElementById("successModal");
    const cancelSuccess = document.getElementById("cancelSuccess");
    const successForm = document.getElementById("successForm");
    const visitId = "<%= v._id %>";

    if (successBtn) {
        successBtn.addEventListener("click", () => {
            successModal.classList.add("active");
            successForm.action = `/successVisit/${visitId}`;
        });
    }

    if (cancelSuccess) {
        cancelSuccess.addEventListener("click", (e) => {
            e.preventDefault();
            successModal.classList.remove("active");
        });
    }

    if (successModal) {
        successModal.addEventListener("click", (e) => {
            if (e.target === successModal) {
                successModal.classList.remove("active");
            }
        });
    }
})();
</script>