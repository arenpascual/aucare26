<!-- =========================================================
FILTERS
========================================================== -->
<section class="filter-container col padding0" style="background-color: transparent;">
<div class="filter-grid gap10 alignEnd padding0">
<div class="filter-group padding0">
<select id="period">
<option value="today">
Today
</option>
<option value="yesterday">

Yesterday
</option>
<option value="this_week">
This Week
</option>
<option value="last_week">
Last Week
</option>
<option
value="this_month"
selected
>
This Month
</option>
<option value="last_month">
Last Month
</option>
<option value="this_year">
This Year
</option>
<option value="last_year">
Last Year
</option>
<option value="overall">
Overall
</option>
<option value="custom">
Custom Date Range
</option>
</select>
</div>
<div class="filter-group">
    <select id="role">
        <option value="all">All Roles</option>
        <% (filterOptions.roles || []).forEach(role => { %>
            <option value="<%= role %>"><%= role %></option>
        <% }) %>
    </select>
</div>

<div class="filter-group">
    <select id="department">
        <option value="all">All Departments</option>
        <% (filterOptions.departments || []).forEach(dept => { %>
            <option value="<%= dept %>"><%= dept %></option>
        <% }) %>
    </select>
</div>

<div class="filter-group"> 
    <select id="campus">
        <% if (user && (user.role === 'Admin' || user.role === 'Sub Admin')) { %>

            <option value="<%= user.campus %>" selected>
                <%= user.campus %>
            </option>

        <% } else { %>

            <option value="all">All Campuses</option>

            <% (filterOptions.campuses || []).forEach(campus => { %>
                <option value="<%= campus %>">
                    <%= campus %>
                </option>
            <% }) %>

        <% } %>
    </select>
</div>

<div class="filter-group">
    <select id="gender">
        <option value="all">All Gender</option>
        <% (filterOptions.genders || []).forEach(gender => { %>
            <option value="<%= gender %>"><%= gender %></option>
        <% }) %>
    </select>
</div>

<div class="filter-group">
    <select id="visitStatus">
        <option value="all">All Statuses</option>
        <% (filterOptions.visitStatuses || []).forEach(status => { %>
            <option value="<%= status %>"><%= status %></option>
        <% }) %>
    </select>
</div>

