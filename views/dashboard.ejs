
<% layout('layout') %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>
<title><%= title || 'Dashboard' %></title>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
/* =========================================================
RESET
========================================================= */
* {
box-sizing: border-box;
margin: 0;
padding: 0;
}
body {
font-family: Arial, Helvetica, sans-serif;
color: #222;
min-height: 100vh;
padding: 0;
}
.mainf {
    padding: 0;
}
button,
select,

input {
font-family: inherit;
}
button {
cursor: pointer;
}

/* =========================================================
MAIN CONTAINER
========================================================= */
main {
width: 100%;
max-width: 1600px;
margin: 0 auto;
padding: 30px;
}

/* =========================================================
HEADER
========================================================= */
.dashboard-header {
display: flex;
justify-content: space-between;
align-items: flex-start;
gap: 20px;
margin-bottom: 15px;
}
.dashboard-header h1 {
font-size: 28px;
margin-bottom: 6px;
}
.dashboard-status {
display: flex;
gap: 5px;
height: 100% !important;
}
.status-indicator {
width: 9px;
height: 9px;
border-radius: 50%;
background: #999;
}
.status-indicator.online {
background: #28a745;
}
.status-indicator.error {
background: #dc3545;
}

/* =========================================================
FILTER SECTION
========================================================= */
.filter-container {
background: #fff;
border: 1px solid #ddd;
padding: 20px;
margin-bottom: 25px;
gap: 10px;
border-radius: 14px;
}
.filter-group {
display: flex;
flex-direction: column;
align-items: start;
gap: 6px;
}
.filter-group label {
font-size: 16px;
color: #555;
}
.filter-group select,
.filter-group input {
width: 100%;
height: 40px;
padding: 0 10px;
border: 1px solid #ccc;
border-radius: 12px !important;
background: #fff;
color: #222;
}
.filter-actions {
display: flex;
gap: 10px;
}

/* =========================================================
CUSTOM DATE RANGE
========================================================= */
.custom-date-container {
display: none;
grid-column: span 2;
grid-template-columns: 1fr 1fr;
gap: 15px;
}
.custom-date-container.visible {
display: grid;
}

/* =========================================================
KPI CARDS
========================================================= */
.kpi-grid {
display: grid;
grid-template-columns:
repeat(4, minmax(180px, 1fr));
gap: 8px;
margin-bottom: 25px;
}
.kpi-card {
border: 1px solid #ddd;
padding: 20px;
min-height: 125px;
border-radius: 16px;
color: white;
background: 
    radial-gradient(circle at 50% 90%, var(--shade9), transparent 50%),  /* Light Gray */
    radial-gradient(circle at 88% 99%,  var(--tint5), transparent 26%),  /* Very Light Blue */
    radial-gradient(circle at 20% 1%,  var(--tint3), transparent 70%),  /* Very Light Blue */
    radial-gradient(circle at 70% 30%,  var(--shade9), transparent 10%); /* White */
background-blend-mode: lighten;
backdrop-filter: blur(10px);
background-color: var(--shade10);
}

.kpi-label {
color: white;
font-size: 13px;
}
.kpi-value {
font-size: 40px;
}
.kpi-description {
color: white;
font-size: 12px;
}

/* =========================================================
DASHBOARD GRID
========================================================= */
.dashboard-grid {
display: grid;
grid-template-columns:
repeat(2, minmax(0, 1fr));
gap: 20px;
margin-bottom: 25px;
}
.dashboard-card {
background: #fff;
border: 1px solid #ddd;
padding: 20px;
min-width: 0;
border-radius: 14px;
color: rgb(8, 8, 36);
}
.dashboard-card.full-width {
grid-column: span 2;
}
.dashboard-card h2 {
font-size: 30px;
color: rgb(8, 8, 36);
}
.dashboard-card p {
font-size: 12px;
color: rgb(8, 8, 36);
}
.chart-container {
position: relative;
width: 100%;
height: 320px;
}

/* =========================================================
ALERTS
========================================================= */
.alert-list {
display: flex;
flex-direction: column;
gap: 10px;
}
.alert-item {
display: flex;
justify-content: space-between;
align-items: center;
gap: 15px;
padding: 12px;
border: 1px solid #ddd;
}
.alert-item strong {
font-size: 13px;
}
.alert-item span {
font-size: 12px;
color: #666;
}

.alert-critical {
border-left: 4px solid #dc3545;
}
.alert-warning {
border-left: 4px solid #ffc107;
}
.alert-info {
border-left: 4px solid #0d6efd;
}

/* =========================================================
INSIGHTS
========================================================= */
.insight-list {
display: flex;
flex-direction: column;
width: 100%;
gap: 5px;
}
.insight-item {
    justify-content: start;
text-align: left;
padding: 12px;
font-size: 13px;
line-height: 1.5;
background-color:rgb(235,245,255); border:0.5px solid rgba(0,102,255,0.4);color:royalblue; padding: 5px; border-radius: 0.7rem;
}

/* =========================================================
ACTIVITY
========================================================= */
.activity-list {
display: flex;
flex-direction: column;
gap: 0;
}
.activity-item {
display: flex;

justify-content: space-between;
gap: 20px;
padding: 14px 0;
border-bottom: 1px solid #eee;
}
.activity-item:last-child {
border-bottom: none;
}
.activity-message {
font-size: 13px;
}
.activity-user {
font-size: 12px;
margin-top: 4px;
}
.activity-date {
font-size: 12px;
white-space: nowrap;
}

/* =========================================================
LOADING
========================================================= */
.loading-container {
display: none;
text-align: center;
padding: 5px;
background: #fff;
width: auto;
border-radius: 10px;
border: 1px solid #ddd;
margin-bottom: 10px;
color: navy;
}
.loading-container.visible {
display: flex;
}

/* =========================================================
ERROR
========================================================= */
.error-container {
display: none;
padding: 0;
margin-bottom: 0;
height: 0 !important;
color: #dc3545;
font-size: 14px;
}
.error-container.visible {
height: 0 !important;
display: none;
padding: 0;
}

/* =========================================================
EMPTY STATE
========================================================= */
.empty-state {
text-align: center;
padding: 30px;
color: #777;
font-size: 13px;
}

/* =========================================================
RESPONSIVE
========================================================= */
@media (max-width: 1100px) {
.filter-grid {
grid-template-columns:
repeat(2, minmax(150px, 1fr));
}
.kpi-grid {

grid-template-columns:
repeat(2, minmax(180px, 1fr));
}
}

@media (max-width: 800px) {
main {
padding: 20px;
}
.dashboard-header {
flex-direction: column;
}
.dashboard-grid {
grid-template-columns: 1fr;
}
.dashboard-card.full-width {
grid-column: span 1;
}
.filter-grid {
grid-template-columns: 1fr;
}
.custom-date-container {
grid-column: span 1;
grid-template-columns: 1fr;
}
}

@media (max-width: 550px) {
main {
padding: 15px;
}
.kpi-grid {

grid-template-columns: 1fr;
}
.chart-container {
height: 260px;
}
.activity-item {
flex-direction: column;
gap: 5px;
}
}
</style>
</head>
