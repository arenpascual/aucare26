/* =========================================================
BUILD API URL
========================================================= */
function buildApiUrl() {
const params =
new URLSearchParams();
params.set(
'period',
periodElement.value
);
params.set(
'role',
roleElement.value
);
params.set(
'department',
departmentElement.value
);
params.set(
'campus',
campusElement.value
);
params.set(
'gender',
genderElement.value
);
params.set(
'visitStatus',
visitStatusElement.value
);

if (
periodElement.value ===

'custom'
) {
if (
!startDateElement.value ||
!endDateElement.value
) {
throw new Error(
'Please select both start and end dates.'
);
}
params.set(
'startDate',
startDateElement.value
);
params.set(
'endDate',
endDateElement.value
);
}

return `/api/dashboard/analytics?${params.toString()}`;
}

