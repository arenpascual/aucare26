<script>

/* =========================================================
GLOBAL VARIABLES
========================================================= */
let charts = {};
let currentDashboardData = null;

/* =========================================================
DOM ELEMENTS
========================================================= */
const periodElement =
document.getElementById('period');
const roleElement =
document.getElementById('role');
const departmentElement =
document.getElementById('department');
const campusElement =
document.getElementById('campus');
const genderElement =
document.getElementById('gender');
const visitStatusElement =
document.getElementById('visitStatus');
const startDateElement =
document.getElementById('startDate');
const endDateElement =
document.getElementById('endDate');
const customDateContainer =
document.getElementById(
'customDateContainer'
);
const loadingContainer =
document.getElementById(

'loadingContainer'
);
const errorContainer =
document.getElementById(
'errorContainer'
);
const statusIndicator =
document.getElementById(
'statusIndicator'
);
const statusText =
document.getElementById(
'statusText'
);

/* =========================================================
NUMBER FORMATTER
========================================================= */
function formatNumber(value) {
const number =
Number(value || 0);
return new Intl.NumberFormat(
'en-PH'
).format(number);
}

/* =========================================================
PERCENT FORMATTER
========================================================= */
function formatPercent(value) {
return `${Number(value || 0).toFixed(2)}%`;
}

/* =========================================================
DATE FORMATTER
========================================================= */
function formatDate(dateValue) {
if (!dateValue) {
return '-';
}
const date =
new Date(dateValue);
return date.toLocaleDateString(
'en-PH',
{
year: 'numeric',
month: 'short',
day: 'numeric'
}
);
}

/* =========================================================
DATE TIME FORMATTER
========================================================= */
function formatDateTime(dateValue) {
if (!dateValue) {
return '-';
}
const date =
new Date(dateValue);
return date.toLocaleString(
'en-PH',
{
year: 'numeric',

month: 'short',
day: 'numeric',
hour: 'numeric',
minute: '2-digit'
}
);
}

/* =========================================================
SHOW LOADING
========================================================= */
function showLoading() {
loadingContainer
.classList
.add('visible');
statusText.textContent =
'Loading';
statusIndicator
.classList
.remove('online');
statusIndicator
.classList
.remove('error');
}

/* =========================================================
HIDE LOADING
========================================================= */
function hideLoading() {
loadingContainer
.classList
.remove('visible');

}

/* =========================================================
SHOW ERROR
========================================================= */
function showError(message) {
errorContainer.textContent =
message;
errorContainer
.classList
.add('visible');
statusText.textContent =
'Error';
statusIndicator
.classList
.remove('online');
statusIndicator
.classList
.add('error');
}

/* =========================================================
CLEAR ERROR
========================================================= */
function clearError() {
errorContainer.textContent =
'';
errorContainer
.classList
.remove('visible');
}

/* =========================================================
BUILD API URL
========================================================= */
function buildApiUrl() {
const params =
new URLSearchParams();
params.set(
'period',
periodElement.value
);
params.set(
'role',
roleElement.value
);
params.set(
'department',
departmentElement.value
);
params.set(
'campus',
campusElement.value
);
params.set(
'gender',
genderElement.value
);
params.set(
'visitStatus',
visitStatusElement.value
);

if (
periodElement.value ===

'custom'
) {
if (
!startDateElement.value ||
!endDateElement.value
) {
throw new Error(
'Please select both start and end dates.'
);
}
params.set(
'startDate',
startDateElement.value
);
params.set(
'endDate',
endDateElement.value
);
}

return `/api/dashboard/analytics?${params.toString()}`;
}

/* =========================================================
UPDATE DATE RANGE TEXT
========================================================= */
function updateDateRangeText(
filters
) {
const dateRangeText =
document.getElementById(
'dateRangeText'
);

if (
filters.period ===
'overall'
) {
dateRangeText.textContent =
'Showing overall system analytics';
return;
}

if (
filters.startDate &&
filters.endDate
) {
dateRangeText.textContent =
`Showing data from ${formatDate(
filters.startDate
)} to ${formatDate(
filters.endDate
)}`;
}
}

/* =========================================================
UPDATE KPI CARDS
========================================================= */
function updateKPIs(kpis) {
document.getElementById(
'totalUsers'
).textContent =
formatNumber(
kpis.totalUsers
);

document.getElementById(
'totalVisits'
).textContent =
formatNumber(
kpis.totalVisits
);
document.getElementById(
'uniquePatients'
).textContent =
formatNumber(
kpis.uniquePatients
);
document.getElementById(
'todayVisits'
).textContent =
formatNumber(
kpis.todayVisits
);
document.getElementById(
'attendanceRate'
).textContent =
formatPercent(
kpis.attendanceRate
);
document.getElementById(
'pendingVisits'
).textContent =
formatNumber(
kpis.pending
);
document.getElementById(
'lowStock'
).textContent =
formatNumber(
kpis.lowStockCount
);
document.getElementById(
'outOfStock'

).textContent =
formatNumber(
kpis.outOfStockCount
);
}

/* =========================================================
DESTROY CHART
========================================================= */
function destroyChart(
chartName
) {
if (
charts[chartName]
) {
charts[chartName].destroy();
charts[chartName] =
null;
}
}

/* =========================================================
CREATE VISIT TREND CHART
========================================================= */
function createVisitTrendChart(
data
) {
destroyChart(
'visitTrend'
);
const labels =
data.map(

item => {
const id =
item._id;
return `${id.year}-${String(
id.month
).padStart(
2,
'0'
)}-${String(
id.day
).padStart(
2,
'0'
)}`;
}
);
const values =
data.map(
item =>
item.visits
);

charts.visitTrend =
new Chart(
document
.getElementById(
'visitTrendChart'
),
{
type: 'line',
data: {
labels,
datasets: [

{
label:
'Visits',
data:
values,
borderWidth:
2,
tension:
0.3,
fill:
false
}
]
},
options: {
responsive:
true,
maintainAspectRatio:
false,
scales: {
y: {
beginAtZero:
true,
ticks: {
precision:
