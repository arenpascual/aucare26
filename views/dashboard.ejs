AI INSIGHTS (DeepSeek-generated)
========================================================= */
// Kunin ang kasalukuyang filter sa dashboard
function getCurrentFilters() {
    const filters = {
        period: periodElement.value,
        role: roleElement.value,
        department: departmentElement.value,
        campus: campusElement.value,
        gender: genderElement.value,
        visitStatus: visitStatusElement.value
    };

    if (periodElement.value === 'custom') {
        if (!startDateElement.value || !endDateElement.value) {
            throw new Error('Please select both start and end dates.');
        }
        filters.startDate = startDateElement.value;
        filters.endDate = endDateElement.value;
    }

    return filters;
}

async function loadAiInsights() {
    const aiInsightList = document.getElementById('aiInsightList');
    const aiFilterLabel = document.getElementById('aiFilterLabel');
    aiInsightList.innerHTML = '<div class="empty-state">Loading AI insights...</div>';

    try {
        const res = await fetch('/api/ai-insights');
        const data = await res.json();

        if (!data.success || !data.insights || data.insights.length === 0) {
            aiFilterLabel.textContent = '';
            aiInsightList.innerHTML = '<div class="empty-state">No AI insights yet. Click Refresh to generate.</div>';
            return;
        }

        aiFilterLabel.textContent = data.filterLabel ? 'Based on: ' + data.filterLabel : '';

        aiInsightList.innerHTML = '';
        data.insights.forEach(insight => {
            const el = document.createElement('div');
            el.className = 'insight-item';
            el.innerHTML = `<strong class="jessBol" style="text-align: left !important;">${insight.title}:</strong> ${insight.message}`;
            aiInsightList.appendChild(el);
        });

    } catch (err) {
        console.error('AI Insights Fetch Error:', err);
        aiInsightList.innerHTML = '<div class="empty-state">Failed to load AI insights.</div>';
    }
}

async function generateAiInsights() {
    const aiInsightList = document.getElementById('aiInsightList');
    const btn = document.getElementById('refreshAiInsightsBtn');

    btn.disabled = true;
    btn.textContent = 'Generating...';
    aiInsightList.innerHTML = '<div class="empty-state">Generating new AI insights, please wait...</div>';

    try {
        const filters = getCurrentFilters();

        const res = await fetch('/api/ai-insights/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(filters)
        });
        const data = await res.json();

        if (!data.success) {
            throw new Error(data.message || 'Failed to generate insights.');
        }

        await loadAiInsights();

    } catch (err) {
        console.error('AI Insights Generate Error:', err);
        aiInsightList.innerHTML = `<div class="empty-state">${err.message}</div>`;
    } finally {
        btn.disabled = false;
        btn.textContent = 'Refresh';
    }
}

document.getElementById('refreshAiInsightsBtn')
    .addEventListener('click', generateAiInsights);


 /* INITIAL LOAD */
document.addEventListener('DOMContentLoaded', function () {
    loadDashboard();
    loadAiInsights();

    const exportBtn = document.getElementById('exportDashboardBtn');
    const exportModal = document.getElementById('exportPasswordModal');
    const cancelBtn = document.getElementById('cancelExportBtn');
    const exportForm = document.getElementById('exportPasswordForm');
    const passwordInput = document.getElementById('exportPassword');
    const exportError = document.getElementById('exportPasswordError');
    const confirmBtn = document.getElementById('confirmExportBtn');

    if (!exportBtn || !exportModal || !cancelBtn || !exportForm) {
        console.error('Export modal elements are missing.');
        return;
    }

    exportBtn.addEventListener('click', function () {
        exportForm.reset();
        exportError.textContent = '';
        exportModal.classList.add('show');
        passwordInput.focus();
    });

    cancelBtn.addEventListener('click', function () {
        exportModal.classList.remove('show');
        exportForm.reset();
        exportError.textContent = '';
    });

    exportForm.addEventListener('submit', async function (event) {
        event.preventDefault();

        exportError.textContent = '';
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Verifying...';

        try {
           
        const chartImages = {};

        [
            'inventoryChart',
            'topDispensedItemsChart',
            'topComplaintsChart',
            'dispensingChart',
            'visitTrendChart',
            'demographicGenderChart',
            'demographicCampusChart',
            'demographicDepartmentChart',
            'visitsByRoleChart',
            'visitStatusChart'
        ].forEach(id => {
            const canvas = document.getElementById(id);

            if (canvas) {
                chartImages[id] = canvas.toDataURL('image/png');
            }
        });

        const response = await fetch('/api/dashboard/export-pdf', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/pdf, application/json'
            },
            body: JSON.stringify({
                password: passwordInput.value,
                dashboardData: currentDashboardData,
                chartImages: chartImages
            })
        });

            if (!response.ok) {
                const data = await response.json().catch(() => ({}));
                throw new Error(data.message || 'Export failed.');
            }

            const blob = await response.blob();

            if (blob.type !== 'application/pdf') {
                throw new Error('The server did not return a PDF file.');
            }

            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');

            link.href = url;
            link.download = 'dashboard-report.pdf';
            document.body.appendChild(link);
            link.click();
            link.remove();

            setTimeout(() => URL.revokeObjectURL(url), 1000);

            exportModal.classList.remove('show');
            exportForm.reset();

        } catch (error) {
            exportError.textContent = error.message;
        } finally {
            confirmBtn.disabled = false;
            confirmBtn.textContent = 'Verify & Export';
        }
    });
});

</script>

<!-- BACK TO TOP SCRIPT -->
<script>
(function () {
    const btn = document.getElementById('backToTopBtn');
    let scroller = window;

    function currentTop() {
        return scroller === window
            ? (window.scrollY || document.documentElement.scrollTop)
            : scroller.scrollTop;
    }

    // Lalabas lang ang button kapag nag-scroll na pababa (>300px)
    document.addEventListener('scroll', function (e) {
        const t = e.target;
        scroller = (t === document || t === document.documentElement) ? window : t;
        btn.classList.toggle('show', currentTop() > 300);
    }, true);

    // Pag-click, smooth scroll papunta sa taas ng dashboard
    btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        if (scroller !== window) {
            scroller.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });
})();
</script>

<!-- NOTIFICATION POPUP SCRIPT -->
<script>
(function () {
    function init() {
        const bell = document.getElementById('notifBell');
        const panel = document.getElementById('notifPanel');
        const list = document.getElementById('notifList');
        const badge = document.getElementById('notifBadge');

        // Walang bell = hindi Admin, kaya walang gagawin
        if (!bell || !panel || !list) return;

        // Ilipat sa body para hindi ma-clip ng parent
        document.body.appendChild(panel);
        panel.classList.remove('hidden');

        // Ayusin ang layout ng list para hindi maapektuhan ng global styles
        list.style.setProperty('display', 'block', 'important');
        list.style.setProperty('height', 'auto', 'important');
        list.style.setProperty('min-height', '0', 'important');
        list.style.setProperty('width', '100%', 'important');
        list.style.setProperty('padding', '0', 'important');
        list.style.setProperty('margin', '0', 'important');

        let notifications = [];

        function renderNotifications() {
            list.innerHTML = '';

            const unread = notifications.filter(n => !n.read).length;
            if (badge) {
                badge.textContent = unread;
                badge.classList.toggle('hidden', unread === 0);
            }

            if (notifications.length === 0) {
                list.innerHTML = '<div class="notifEmpty">No notifications</div>';
                return;
            }

            notifications.forEach(n => {
                const item = document.createElement('div');
                item.className = 'notifItem';

                // Layout: message sa taas, oras sa ilalim
                item.style.setProperty('display', 'flex', 'important');
                item.style.setProperty('flex-direction', 'column', 'important');
                item.style.setProperty('align-items', 'flex-start', 'important');
                item.style.setProperty('justify-content', 'flex-start', 'important');
                item.style.setProperty('gap', '4px', 'important');
                item.style.setProperty('height', 'auto', 'important');
                item.style.setProperty('width', '100%', 'important');
                item.style.setProperty('padding', '12px', 'important');
                item.style.setProperty('margin-bottom', '8px', 'important');
                item.style.setProperty('border-radius', '10px', 'important');
                item.style.setProperty('text-align', 'left', 'important');
                item.style.cursor = 'pointer';
                item.style.border = '1px solid #eeeeee';
                item.style.borderLeft = n.read ? '4px solid transparent' : '4px solid royalblue';
                item.style.background = n.read ? '#ffffff' : 'rgb(235,245,255)';

                const msg = document.createElement('span');
                msg.textContent = n.message;
                msg.style.display = 'block';
                msg.style.width = '100%';
                msg.style.textAlign = 'left';
                msg.style.fontSize = '14px';
                msg.style.lineHeight = '1.4';
                msg.style.fontWeight = n.read ? '400' : '600';
                msg.style.color = 'rgb(8, 8, 36)';
                item.appendChild(msg);

                const time = document.createElement('small');
                time.textContent = formatDateTime(n.createdAt);
                time.style.display = 'block';
                time.style.margin = '0';
                time.style.fontSize = '12px';
                time.style.color = '#888888';
                item.appendChild(time);

                // Pag na-click: markahan as read, tapos pumunta sa profile
                item.addEventListener('click', async function () {
                    try {
                        if (!n.read) {
                            await fetch('/api/notifications/read/' + n._id, { method: 'POST' });
                            n.read = true;
                        }
                    } catch (err) {
                        console.error('Mark read error:', err);
                    }
                    window.location.href = n.link || '/p';
                });

                list.appendChild(item);
            });
        }

        async function loadNotifications() {
            try {
                const res = await fetch('/api/dashboard/notifications');
                const data = await res.json();
                notifications = data.success ? data.notifications : [];
            } catch (err) {
                console.error('Load notifications error:', err);
                notifications = [];
            }
            renderNotifications();
        }

        loadNotifications();
        setInterval(loadNotifications, 30000); // auto-refresh every 30 seconds

        let isOpen = false;

        function openPanel() {
            const rect = bell.getBoundingClientRect();
            const width = Math.min(340, window.innerWidth - 20);
            const left = Math.max(10, rect.right - width);

            panel.style.setProperty('position', 'fixed', 'important');
            panel.style.setProperty('top', (rect.bottom + 10) + 'px', 'important');
            panel.style.setProperty('left', left + 'px', 'important');
            panel.style.setProperty('right', 'auto', 'important');
            panel.style.setProperty('width', width + 'px', 'important');
            panel.style.setProperty('height', 'auto', 'important');
            panel.style.setProperty('max-height', '420px', 'important');
            panel.style.setProperty('overflow-y', 'auto', 'important');
            panel.style.setProperty('padding', '16px', 'important');
            panel.style.setProperty('text-align', 'left', 'important');
            panel.style.setProperty('z-index', '2147483647', 'important');
            panel.style.setProperty('display', 'block', 'important');
            isOpen = true;
        }

        function closePanel() {
            panel.style.setProperty('display', 'none', 'important');
            isOpen = false;
        }

        closePanel();

        document.addEventListener('click', function (e) {
            const clickedBell = e.target.closest('#notifBell');

            if (clickedBell) {
                e.preventDefault();
                e.stopPropagation();
                if (isOpen) {
                    closePanel();
                } else {
                    loadNotifications();
                    openPanel();
                }
                return;
            }

            if (isOpen && !panel.contains(e.target)) {
                closePanel();
            }
        }, true);

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closePanel();
        });

        window.addEventListener('resize', function () {
            if (isOpen) openPanel();
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
</script>
