/* =========================================================
CREATE VISIT TREND CHART
JANUARY - DECEMBER
========================================================= */
function createVisitTrendChart(data) {
    destroyChart('visitTrend');

 const pad = n => String(n).padStart(2, '0');
 const months = new Set(data.map(i => `${i._id.year}-${i._id.month}`));
 const daily = months.size <= 1;
 const buckets = {};
 data.forEach(i => {
   const { year, month, day } = i._id || {};
   if (!year) return;
   const key = daily ? `${year}-${pad(month)}-${pad(day)}` : `${year}-${pad(month)}`;
   buckets[key] = (buckets[key] || 0) + (Number(i.visits) || 0);
 });
 const monthLabels = Object.keys(buckets);
 const monthlyVisits = Object.values(buckets);

    charts.visitTrend = new Chart(
        document.getElementById('visitTrendChart'),
        {
            type: 'line',

            data: {
                labels: monthLabels,

                datasets: [{
                    label: 'Visits',
                    data: monthlyVisits,
                    borderWidth: 2,
                    tension: 0.3,
                    fill: false
                }]
            },

            options: {
    responsive: true,
    maintainAspectRatio: false,

    plugins: {
        legend: {
            display: false
        }
    },

    scales: {
                    x: {
                        grid: {
                            display: true,
                            drawBorder: true,
                            color: "#e5e7eb"
                        },

                        ticks: {
                            autoSkip: false
                        }
                    },

                    y: {
                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        },

                        grid: {
                            display: false
                        }
                    }
                }
            }
        }
    );
}

