);
}

/* =========================================================
UPDATE ACTIVITY
========================================================= */
function updateActivity(
activities
) {
const activityList =
document.getElementById(
'activityList'
);
activityList.innerHTML =
'';

if (
!activities ||
activities.length === 0
) {

activityList.innerHTML =
'<div class="empty-state">No recent activity found.</div>';
return;
}

activities.forEach(
activity => {
const element =
document.createElement(
'div'
);
element.className =
'activity-item';

const user =
activity.who;
let userName =
'Unknown user';

if (user) {
userName =
user.fName ||
user.lName
?
`${user.fName || ''} ${user.lName || ''}`.trim()
:
user.username ||
'Unknown user';

}

element.innerHTML = `
<div>
<div class="activity-message">
${activity.what || 'System activity'}
</div>
<div class="activity-user">
${userName}
</div>
</div>
<div class="activity-date">
${formatDateTime(
activity.createdAt
)}
</div>
`;

activityList.appendChild(
element
);
}
);
}

