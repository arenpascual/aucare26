<% layout('layout') %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>
<title><%= title || 'Dashboard' %></title>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
/* =========================================================
RESET
========================================================= */
* {
box-sizing: border-box;
margin: 0;
padding: 0;
}
body {
font-family: Arial, Helvetica, sans-serif;
color: #222;
min-height: 100vh;
padding: 0;
}
.mainf {
    padding: 0;
}
button,
select,

input {
font-family: inherit;
}
button {
cursor: pointer;
}

/* =========================================================
MAIN CONTAINER
========================================================= */
main {
width: 100%;
max-width: 1600px;
margin: 0 auto;
padding: 20px;
}

/* =========================================================
HEADER
========================================================= */
.dashboard-header {
display: flex;
justify-content: space-between;
align-items: flex-start;
gap: 20px;
margin-bottom: 15px;
}
.dashboard-header h1 {
font-size: 28px;
margin-bottom: 6px;
}
.dashboard-status {
display: flex;
gap: 5px;
height: 100% !important;
}
.status-indicator {
width: 9px;
height: 9px;
border-radius: 50%;
background: #999;
}
.status-indicator.online {
background: #28a745;
}
.status-indicator.error {
background: #dc3545;
}

/* =========================================================
FILTER SECTION
========================================================= */
.filter-container {
background: #fff;
padding: 0;
margin-bottom: 25px;
gap: 10px;
border-radius: 14px;
}
.filter-group {
display: flex;
flex-direction: column;
align-items: start;
gap: 6px;
}
.filter-group label {
font-size: 16px;
color: #555;
}
.filter-group select,
.filter-group input {
width: 100%;
height: 40px;
padding: 0 10px;
border: 1px solid #ccc;
border-radius: 12px !important;
background: #fff;
color: #222;
}
.filter-actions {
display: flex;
gap: 10px;
}

/* =========================================================
CUSTOM DATE RANGE
========================================================= */
.custom-date-container {
display: none;
grid-column: span 2;
grid-template-columns: 1fr 1fr;
gap: 15px;
}
.custom-date-container.visible {
display: grid;
}

/* =========================================================
KPI CARDS
========================================================= */
.kpi-grid {
display: grid;
grid-template-columns:
repeat(6, minmax(180px, 1fr));
gap: 5px;
margin-bottom: 25px;
}
.kpi-card {
border: 1px solid #ddd;
padding: 10px !important;
border-radius: 16px;
color: white;
background: 
    radial-gradient(circle at 50% 90%, var(--shade9), transparent 50%),  /* Light Gray */
    radial-gradient(circle at 88% 99%,  var(--tint6), transparent 26%),  /* Very Light Blue */
    radial-gradient(circle at 20% 1%,  var(--tint4), transparent 70%),  /* Very Light Blue */
    radial-gradient(circle at 70% 30%,  var(--shade9), transparent 10%); /* White */
background-blend-mode: lighten; 
backdrop-filter: blur(10px);
background-color: var(--shade4);
gap: 0 !important;
}

.kpi-label {
color: white;
font-size: 13px;
display: none !important;
}
.kpi-value {
font-size: 40px;
padding: 2px;
}
.kpi-description {
color: white;
font-size: 16px;
padding: 0 !important;
}
.kpi-description:hover {
    transform: scale(1.08);
}

/* =========================================================
DASHBOARD GRID
========================================================= */
.dashboard-grid {
display: grid;
grid-template-columns:
repeat(2, minmax(0, 1fr));
gap: 20px;
margin-bottom: 25px;
}
.dashboard-card {
background: #fff;
border: 1px solid #ddd;
padding: 20px;
min-width: 0;
border-radius: 14px;
color: rgb(8, 8, 36);
}
.dashboard-card.full-width {
grid-column: span 2;
}
.dashboard-card h2 {
font-size: 30px;
color: rgb(8, 8, 36);
}
.dashboard-card p {
font-size: 12px;
color: rgb(8, 8, 36);
}
.chart-container {
position: relative;
width: 100%;
height: 230px;
}
.chart-container.small {
position: relative;
width: 100%;
height: 180px;
}

/* =========================================================
ALERTS
========================================================= */
.alert-list {
display: flex;
flex-direction: column;
gap: 10px;
}
.alert-item {
display: flex;
justify-content: space-between;
align-items: center;
gap: 15px;
padding: 12px;
border: 1px solid #ddd;
}
.alert-item strong {
font-size: 13px;
}
.alert-item span {
font-size: 12px;
color: #666;
}

.alert-critical {
border-left: 4px solid #dc3545;
}
.alert-warning {
border-left: 4px solid #ffc107;
}
.alert-info {
border-left: 4px solid #0d6efd;
}

/* =========================================================
INSIGHTS
========================================================= */
.insight-list {
display: flex;
flex-direction: column;
width: 100%;
gap: 5px;
}
.insight-item {
justify-content: start;
align-items: left;
flex-direction: column;
text-align: left !important;
padding: 12px;
font-size: 13px;
line-height: 1.5;
background-color:rgb(235,245,255); border:0.5px solid rgba(0,102,255,0.4);color:royalblue; padding: 5px; border-radius: 0.7rem;
}
strong.jessBol {
    text-align: left !important;
    width: 100%;
    font-weight: 600;
    font-size: 14px;
    color: rgb(14, 10, 120);
    
}

/* =========================================================
ACTIVITY
========================================================= */
.activity-list {
display: flex;
flex-direction: column;
gap: 0;
}
.activity-item {
display: flex;

justify-content: space-between;
gap: 20px;
padding: 14px 0;
border-bottom: 1px solid #eee;
}
.activity-item:last-child {
border-bottom: none;
}
.activity-message {
font-size: 13px;
}
.activity-user {
font-size: 12px;
margin-top: 4px;
}
.activity-date {
font-size: 12px;
white-space: nowrap;
}

/* =========================================================
LOADING
========================================================= */
.loading-container {
display: none;
text-align: center;
padding: 5px;
background: #fff;
width: auto;
border-radius: 10px;
border: 1px solid #ddd;
margin-bottom: 10px;
color: navy;
}
.loading-container.visible {
display: flex;
}

/* =========================================================
ERROR
========================================================= */
.error-container {
display: none;
padding: 0;
margin-bottom: 0;
height: 0 !important;
color: #dc3545;
font-size: 14px;
}
.error-container.visible {
height: 0 !important;
display: none;
padding: 0;
}

/* =========================================================
EMPTY STATE
========================================================= */
.empty-state {
text-align: center;
padding: 30px;
color: #777;
font-size: 13px;
}
/* Four demographic charts in one row */
.demographics-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.demographics-grid > .dashboard-card {
    min-width: 0;
    width: 100%;
}

.demographics-grid .chart-container {
    max-height: 180px;
}

/* Responsive layout for smaller screens */
@media (max-width: 1200px) {
    .demographics-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .demographics-grid {
        grid-template-columns: 1fr;
    }
}

/* =========================================================
RESPONSIVE
========================================================= */
@media (max-width: 1100px) {
.filter-grid {
grid-template-columns:
repeat(2, minmax(150px, 1fr));
}
.kpi-grid {

grid-template-columns:
repeat(2, minmax(180px, 1fr));
}
}

@media (max-width: 800px) {
main {
padding: 20px;
}
.dashboard-header {
flex-direction: column;
}
.dashboard-grid {
grid-template-columns: 1fr;
}
.dashboard-card.full-width {
grid-column: span 1;
}
.filter-grid {
grid-template-columns: 1fr;
}
.custom-date-container {
grid-column: span 1;
grid-template-columns: 1fr;
}
}

@media (max-width: 550px) {
main {
padding: 15px;
}
.kpi-grid {

grid-template-columns: 1fr;
}
.chart-container {
height: 260px;
}
.activity-item {
flex-direction: column;
gap: 5px;
}
}

#exportPasswordModal {
    display: none !important;
}

/* Show modal only when explicitly opened */
#exportPasswordModal.show {
    display: flex !important;
}

/* =========================================================
BACK TO TOP
========================================================= */
#backToTopBtn {
    position: fixed;
    right: 20px;
    bottom: 20px;
    width: 46px;
    height: 46px;
    border: none;
    border-radius: 50%;
    background: royalblue;
    color: #fff;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(0,0,0,.25);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity .25s, transform .25s, visibility .25s;
    z-index: 9999;
}
#backToTopBtn.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}
#backToTopBtn:hover {
    background: rgb(14, 10, 120);
}

/* =========================================================
NOTIFICATION POPUP
========================================================= */
#notifPanel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 340px;
    max-height: 420px;
    overflow-y: auto;
    padding: 16px;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
    z-index: 1000;
    text-align: left;
}

#notifPanel.hidden {
    display: none !important;
}

#notifPanel .notifTitle {
    font-size: 22px;
    font-weight: 700;
    color: rgb(8, 8, 36);
    margin: 0 0 10px;
}

.notifItem {
    padding: 10px 8px;
    border-bottom: 1px solid #eeeeee;
    font-size: 14px;
    color: rgb(8, 8, 36);
}

.notifItem:last-child {
    border-bottom: none;
}

.notifItem small {
    display: block;
    color: #888888;
    margin-top: 2px;
}

.notifEmpty {
    padding: 20px 0;
    text-align: center;
    font-size: 14px;
    color: #888888;
}
</style>
</head>
