/* =========================================================
UPDATE ALERTS
========================================================= */
function updateAlerts(
kpis
) {
const alertList =
document.getElementById(
'alertList'
);
alertList.innerHTML =
'';

const alerts = [];

if (
Number(
kpis.outOfStockCount
) > 0
) {
alerts.push({
type:
'critical',
title:
'Out of stock items',
value:
`${formatNumber(
kpis.outOfStockCount
)} item(s) currently have zero remaining quantity.`
});
}

if (
Number(
kpis.expiredCount
) > 0
) {
alerts.push({
type:
'critical',
title:
'Expired inventory',
value:
`${formatNumber(
kpis.expiredCount
)} item(s) have expired.`
});
}

if (
Number(
kpis.lowStockCount
) > 0
) {
alerts.push({
type:
'warning',
title:
'Low stock items',
value:
`${formatNumber(
kpis.lowStockCount
)} item(s) have between 1 and 10 remaining.`

});
}

if (
Number(
kpis.expiringSoon
) > 0
) {
alerts.push({
type:
'warning',
title:
'Expiring soon',
value:
`${formatNumber(
kpis.expiringSoon
)} item(s) expire within 30 days.`
});
}

if (
Number(
kpis.pending
) > 0
) {
alerts.push({
type:
'info',
title:
'Pending visits',
value:

`${formatNumber(
kpis.pending
)} visit(s) are currently pending.`
});
}

if (
alerts.length === 0
) {
alertList.innerHTML =
'<div class="empty-state">No active alerts.</div>';
return;
}

alerts.forEach(
alert => {
const element =
document.createElement(
'div'
);
element.className =
`alert-item alert-${alert.type}`;
element.innerHTML = `
<strong>
${alert.title}
</strong>
<span>
${alert.value}
</span>
`;

alertList.appendChild(
element
);
}
);
}

/* =========================================================
UPDATE INSIGHTS
========================================================= */
function updateInsights(
data
) {
const insightList =
document.getElementById(
'insightList'
);
insightList.innerHTML =
'';

const insights = [];

const kpis =
data.kpis;
const complaints =
data.charts.topComplaints;
const roles =
data.charts.visitsByRole;
const items =
data.charts.topDispensedItems;

if (

complaints &&
complaints.length > 0
) {
insights.push(
`The most frequently recorded complaint is "${complaints[0]._id}" with
${formatNumber(

complaints[0].count
)} recorded case(s).`
);
}

if (
roles &&
roles.length > 0
) {
insights.push(
`The user role with the highest number of clinic visits is "${roles[0]._id}" with
${formatNumber(
roles[0].count
)} visit(s).`
);
}

if (
items &&
items.length > 0
) {
insights.push(
`"${items[0]._id}" is the most frequently dispensed item with ${formatNumber(
items[0].quantity
)} unit(s) dispensed.`

);
}

insights.push(
`The current attendance rate is ${formatPercent(
kpis.attendanceRate
)}.`
);

insights.push(
`There are ${formatNumber(
kpis.uniquePatients
)} unique patient(s) across ${formatNumber(
kpis.totalVisits
)} clinic visit(s) in the selected period.`
);

if (
Number(
kpis.lowStockCount
) > 0
) {
insights.push(
`${formatNumber(
kpis.lowStockCount
)} inventory item(s) require stock monitoring because they have 10 or fewer units
remaining.`
);
}

insights.forEach(

insight => {
const element =
document.createElement(
'div'
);
element.className =
'insight-item';
element.textContent =
insight;
insightList.appendChild(
element
);
}
);
}

/* =========================================================
UPDATE ACTIVITY
========================================================= */
function updateActivity(
activities
) {
const activityList =
document.getElementById(
'activityList'
);
activityList.innerHTML =
'';

if (
!activities ||
activities.length === 0
) {

activityList.innerHTML =
'<div class="empty-state">No recent activity found.</div>';
return;
}

activities.forEach(
activity => {
const element =
document.createElement(
'div'
);
element.className =
'activity-item';

const user =
activity.who;
let userName =
'Unknown user';

if (user) {
userName =
user.fName ||
user.lName
?
`${user.fName || ''} ${user.lName || ''}`.trim()
:
user.username ||
'Unknown user';

}

element.innerHTML = `
<div>
<div class="activity-message">
${activity.what || 'System activity'}
</div>
<div class="activity-user">
${userName}
</div>
</div>
<div class="activity-date">
${formatDateTime(
activity.createdAt
)}
</div>
`;

activityList.appendChild(
element
);
}
);
}

