// NEW: DEMOGRAPHIC CHARTS (PERCENT VERSION)

function createDemographicCharts(chartData) {
    const definitions = [
        {
            key: 'demographicGenderChart',
            data: chartData.visitsByGender || [],
            type: 'doughnut',
            title: 'Visits by Gender',
            colors: ['#36A2EB', '#9AD0F5']
        },
        {
            key: 'demographicCampusChart',
            data: chartData.visitsByCampus || [],
            type: 'bar',
            title: 'Visits by Campus',
            colors: '#36A2EB',
            vertical: true
        },
        {
            key: 'demographicDepartmentChart',
            data: chartData.visitsByDepartment || [],
            type: 'bar',
            title: 'Visits by Department',
            colors: '#36A2EB',
            vertical: false
        },
        //{
        //    key: 'demographicRoleChart',
        //    data: chartData.visitsByRoleComparison || [],
        //    type: 'doughnut',
        //    title: 'Visits by Role',
        //    colors: ['#36A2EB', '#9AD0F5','blue']
        //}
    ];

    definitions.forEach(item => {
        const canvas = document.getElementById(item.key);
        if (!canvas) return;

        if (charts[item.key]) {
            charts[item.key].destroy();
        }

        const isBar = item.type === 'bar';
        const isVertical = isBar && item.vertical;

        // NEW: convert counts to percentages
        const percentValues = toPercentList(item.data.map(row => row.count));

        // NEW: doughnut legend shows percent beside the label
        const chartLabels = item.data.map((row, i) =>
            isBar ? row._id : `${row._id} (${percentValues[i]}%)`
        );

        charts[item.key] = new Chart(canvas, {
            type: item.type,

            data: {
                labels: chartLabels,
                datasets: [{
                    label: item.title + ' (%)',
                    data: percentValues,
                    backgroundColor: item.colors,
                    borderColor: isBar ? '#36A2EB' : '#FFFFFF',
                    borderWidth: isBar ? 1 : 2,
                    borderRadius: isBar ? 4 : 0
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                // Campus: vertical bars; others: horizontal bars
                indexAxis: isVertical ? 'x' : 'y',

                plugins: {
                    legend: {
                        display: item.type === 'doughnut',
                        position: 'bottom'
                    },
                    // NEW: tooltip shows percent
                    tooltip: {
                        callbacks: {
                            label: ctx => isBar
                                ? `${ctx.raw}%`
                                : ctx.label
                        }
                    }
                },

                scales: isBar ? {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            // NEW: show % on the value axis (horizontal bars)
                            callback: function(value) {
                                return isVertical ? this.getLabelForValue(value) : value + '%';
                            }
                        },
                        grid: {
                            // Vertical grid lines only for Campus
                            display: isVertical,
                            drawTicks: true
                        },
                        border: {
                            display: true
                        }
                    },

                    y: {
                        beginAtZero: true,
                        ticks: {
                            // NEW: show % on the value axis (vertical bars)
                            callback: function(value) {
                                return isVertical ? value + '%' : this.getLabelForValue(value);
                            }
                        },
                        grid: {
                            // Horizontal grid lines only for horizontal bars
                            display: !isVertical,
                            drawTicks: true
                        },
                        border: {
                            display: true
                        }
                    }
                } : {}
            }
        });
    });
}



