/* =========================================================
NUMBER FORMATTER
========================================================= */
function formatNumber(value) {
const number =
Number(value || 0);
return new Intl.NumberFormat(
'en-PH'
).format(number);
}

/* =========================================================
PERCENT FORMATTER
========================================================= */
function formatPercent(value) {
return `${Number(value || 0).toFixed(2)}%`;
}

function toPercentList(values) {
    const total = values.reduce((sum, v) => sum + Number(v || 0), 0);
    return values.map(v =>
        total > 0 ? Number(((Number(v || 0) / total) * 100).toFixed(2)) : 0
    );
}

/* =========================================================
DATE FORMATTER
========================================================= */
function formatDate(dateValue) {
if (!dateValue) {
return '-';
}
const date =
new Date(dateValue);
return date.toLocaleDateString(
'en-PH',
{
year: 'numeric',
month: 'short',
day: 'numeric'
}
);
}

/* =========================================================
DATE TIME FORMATTER
========================================================= */
function formatDateTime(dateValue) {
if (!dateValue) {
return '-';
}
const date =
new Date(dateValue);
return date.toLocaleString(
'en-PH',
{
year: 'numeric',

month: 'short',
day: 'numeric',
hour: 'numeric',
minute: '2-digit'
}
);
}

