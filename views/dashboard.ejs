/* =========================================================
UPDATE ALERTS
========================================================= */
function updateAlerts(
kpis
) {
const alertList =
document.getElementById(
'alertList'
);
alertList.innerHTML =
'';

const alerts = [];

if (
Number(
kpis.outOfStockCount
) > 0
) {
alerts.push({
type:
'critical',
title:
'Out of stock items',
value:
`${formatNumber(
kpis.outOfStockCount
)} item(s) currently have zero remaining quantity.`
});
}

if (
Number(
kpis.expiredCount
) > 0
) {
alerts.push({
type:
'critical',
title:
'Expired inventory',
value:
`${formatNumber(
kpis.expiredCount
)} item(s) have expired.`
});
}

if (
Number(
kpis.lowStockCount
) > 0
) {
alerts.push({
type:
'warning',
title:
'Low stock items',
value:
`${formatNumber(
kpis.lowStockCount
)} item(s) have between 1 and 10 remaining.`

});
}

if (
Number(
kpis.expiringSoon
) > 0
) {
alerts.push({
type:
'warning',
title:
'Expiring soon',
value:
`${formatNumber(
kpis.expiringSoon
)} item(s) expire within 30 days.`
});
}

if (
Number(
kpis.pending
) > 0
) {
alerts.push({
type:
'info',
title:
'Pending visits',
value:

`${formatNumber(
kpis.pending
)} visit(s) are currently pending.`
});
}

if (
alerts.length === 0
) {
alertList.innerHTML =
'<div class="empty-state">No active alerts.</div>';
return;
}

alerts.forEach(
alert => {
const element =
document.createElement(
'div'
);
element.className =
`alert-item alert-${alert.type}`;
element.innerHTML = `
<strong>
${alert.title}
</strong>
<span>
${alert.value}
</span>
`;

alertList.appendChild(
element
);
}
);
}

