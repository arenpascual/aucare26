<% layout('layout') %>

<div class="height10 justifyBetween">
    <div class="width0">
        <p class="size40 str400">Patient Account Management</p>
    </div>
    <div class="width0 gap8 ">
        <div class="width0 relative height0 paddingTop5">
            <a href="/pd" class="nav pnav w140"> Pending Account </a>
            <div class="h20 w20 corner500 bgWhite absolute right0 top0" style="border: 0.5px rgb(9, 27, 163) solid;"></div>
        </div>
        |
        <a href="/nu" class="nav pnav w100 marginTop5"> <i class="fas fa-plus"></i> New User</a>
        |
        <a href="/ua" class="nav w100 marginTop5">Archive</a>
    </div>
</div>
<div class="height90 col justifyStart padding10">
    <div class="height0 justifyBetween">
        <div class="width0">
            <div class="selectBar w190"><i class="fas fa-filter"></i><select name="" id="">
                <option value=""></i> Filter By</option>
            </select></div>
        </div>
        <div class="width0 gap8 ">
            <div class="searchBar w220"><i class="fas fa-search"></i><input type="search" name="" id=""></div>
        </div>
    </div>
    <br>
    <table>
        <thead>
            <tr>
                <th class="width10 bgTint10">#</th>
                <th class="width25 bgTint10"><i class="marginRight5 fa-solid fa-user"></i>Name</th>
                <th class="width20 bgTint10"><i class="marginRight5 fa-solid fa-id-card"></i>School ID</th>
                <th class="width20 bgTint10"><i class="marginRight5 fa-solid fa-user-gear"></i>Role</th>
                <th class="width25 bgTint10"><i class="marginRight5 fa-solid fa-building"></i>Department</th>
            </tr>
        </thead>
        <tbody>
            <% if (allUsers && allUsers.length > 0) { %>
                <% allUsers.forEach((user, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><a href="/uv/<%= user._id %>" class="underline navy"><%= user.fName %> <%= user.lName %></a></td>
                        <td><%= user.schoolId || '—' %></td>
                        <td><%= user.role %></td>
                        <td><%= user.course || user.department || '—' %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="center">No users found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>