<% layout('layout') %>
<style>

    
/* Keep the page within the viewport */
html,
body {
    height: 100%;
    margin: 0;
}

/* Prevent the whole page from scrolling */
body {
    overflow: hidden;
}

/* Keep the account management content inside the available height */
.height90.col.justifyStart.padding10.overflow-y1.block {
    height: calc(100vh - 100px);
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* Keep the filters and search at the top */
.height90.col.justifyStart.padding10.overflow-y1.block > .height0.justifyBetween {
    flex-shrink: 0;
}

/* Make the table area scroll independently */
#userTable {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
}

/* Scrollable table body */
#userTable tbody {
    display: block;
    max-height: calc(100vh - 300px);
    overflow-y: auto;
    overflow-x: hidden;
}

/* Keep header and body columns aligned */
#userTable thead,
#userTable tbody tr {
    display: table;
    width: 100%;
    table-layout: fixed;
}

/* Keep the table headings visible */
#userTable thead {
    position: sticky;
    top: 0;
    z-index: 2;
}

    
#userPaginationButtons button {
    min-width: 36px;
    min-height: 36px;
    padding: 6px 10px;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    background: #fff;
    color: #1b5f99;
    cursor: pointer;
}

#userPaginationButtons button.active {
    background: #1b5f99;
    color: #fff;
    border-color: #1b5f99;
}

#userPaginationButtons button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
}

#userPaginationButtons button:hover:not(:disabled):not(.active) {
    background: #edf5fc;
}

</style>

<div class="height10 justifyBetween">
    <div class="width0">
        <p class="size40 str400">Patient Account Management</p>
    </div>
    <div class="width0 gap8 ">
        <div class="width0 relative height0 paddingTop5">
            <a href="/pd" class="nav pnav w140">Pending Account</a>
            <% if (pendingCount > 0) { %>
                <div class="h20 w20 corner500 bgWhite absolute right0 top0" style="border:0.5px rgb(9,27,163) solid; display:flex; align-items:center; justify-content:center;">
                    <p class="size12 str600" style="color:rgb(9,27,163); margin:0;">
                        <%= pendingCount > 9 ? '9+' : pendingCount %>
                    </p>
                </div>
            <% } %>
        </div>
        |
        <a href="/nu" class="nav pnav w100 marginTop5">
            <i class="fas fa-plus"></i> New User
        </a>
        |
        <a href="/ua" class="nav w100 marginTop5">Archive</a>
    </div>
</div>

<div class="height90 col justifyStart padding10 overflow-y1 block">

    <div class="height0 justifyBetween">

        <div class="width0 gap8">

            <div class="selectBar w170">
                <i class="fas fa-user-tag"></i>
                <select id="roleFilter">
                    <option value="">All Roles</option>
                    <% [...new Set(allUsers.map(u => u.role).filter(Boolean))].sort().forEach(role => { %>
                        <option value="<%= role %>"><%= role %></option>
                    <% }) %>
                </select>
            </div>

            <div class="selectBar w200"><i class="fas fa-building"></i>
                <select id="departmentFilter">
                    <option value="">All Departments</option>
                    <% [...new Set(allUsers.map(u => (u.course || u.department)).filter(Boolean))].sort().forEach(dept => { %>
                        <option value="<%= dept %>"><%= dept %></option>
                    <% }) %>
                </select>
            </div>

            <% if (user && user.role === 'Super Admin') { %>
            <div class="selectBar w200"><i class="fas fa-building"></i>
                <select id="Campus">
                    <option value="">All Campus</option>
                    <option value="Main">Main</option>
                    <option value="South">South</option>
                    <option value="San Jose">San Jose</option>
                </select>
            </div>
            <% } %>

        </div>

        <div class="width0 gap8">
            <div class="searchBar w220">
                <i class="fas fa-search"></i>
                <input
                        type="search"
                        id="userSearchInput"
                        name="account-directory-filter"
                        placeholder="Search..."
                        value=""
                        autocomplete="new-password"
                        autocapitalize="off"
                        spellcheck="false"
                    >
            </div>
        </div>

    </div>

    <br>

    <table id="userTable">
        <thead>
            <tr>
                <th class="width10 bgTint10">#</th>
                <th class="width25 bgTint10 "><i class="marginRight5 fa-solid fa-user"></i>Name</th>
                <th class="width20 bgTint10"><i class="marginRight5 fa-solid fa-id-card"></i>School ID</th>
                <th class="width20 bgTint10"><i class="marginRight5 fa-solid fa-user-gear"></i>Role</th>
                <th class="width25 bgTint10"><i class="marginRight5 fa-solid fa-building"></i>Course / Department</th>
            </tr>
        </thead>

        <tbody id="userTableBody">
            <% if (allUsers && allUsers.length > 0) { %>
                <% allUsers.forEach((user,index)=>{ %>
                    <tr data-campus="<%= user.campus || '' %>">
                        <td><%= index + 1 %></td>
                        <td>
                            <a href="/uv/<%= user._id %>" class="underline navy patientLink" data-href="/uv/<%= user._id %>" data-id="<%= user._id %>" >
                                <%= user.fName %> <%= user.lName %>
                            </a>
                        </td>
                        <td><%= user.schoolId || '—' %></td>
                        <td><%= user.role %></td>
                        <td><%= user.course || user.department || '—' %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="center">
                        No users found.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

    
<!-- USER TABLE PAGINATION -->
    <div id="userPagination"
        style="display:flex; justify-content:space-between; align-items:center; gap:12px; padding:15px 0; min-height: 10%;">

        <p id="userPaginationInfo" class="size14" style="margin:0;">
            Showing 0–0 of 0 users
        </p>

        <div style="display:flex; align-items:center; gap:8px;" class="width0">
            <label for="userPageSize" class="size14">Per page:</label>

            <select id="userPageSize"
                    style="padding:7px 10px; border:1px solid #ccc; border-radius:6px; width: 100px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>

        <div id="userPaginationButtons" class="width0"
            style="display:flex; align-items:center; gap:5px; flex-wrap:wrap;">
        </div>
    </div>


    <p id="noResultsMsg"
       class="size14 gray hidden"
       style="padding:15px 0;">
       No matching users found.
    </p>

</div> <!-- dulo ng .height90 container -->

<div id="proceedOverlay" class="hidden"
     style="position:fixed; top:0; right:0; bottom:0; left:240px; background:rgba(0,0,0,0.4); z-index:1000;">
</div>

<section id="proceednotif"
         class="hidden shadow3 width25 padding30 gap10 bgWhite col corner15 height0"
         style="position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:1001; background:#fff; opacity:1;">
    <img src="/images/password.png" alt="" class="h100 w100 corner500">
    <p class="size14">Please enter the password to proceed.</p>

    <input type="password" id="proceedPassword" placeholder="Password" autocomplete="current-password">
    <p id="proceedError" class="size12 hidden" style="color:red; margin:0;">Incorrect password.</p>

    <section class="justifyBetween gap10 padding0">
        <a id="proceedCancel" class="nav width100">Cancel</a>
        <button type="button" id="proceedConfirm" class="nav pnav width100">Proceed</button>
    </section>
</section>


<script>
(function () {
    // =========================================================
    // USER TABLE + FILTERS + PAGINATION
    // =========================================================

    const searchInput = document.getElementById("userSearchInput");
    searchInput.value = "";
    const roleFilter = document.getElementById("roleFilter");
    const departmentFilter = document.getElementById("departmentFilter");
    const campusFilter = document.getElementById("Campus");
    const tableBody = document.getElementById("userTableBody");
    const noResults = document.getElementById("noResultsMsg");

    const pageSizeSelect = document.getElementById("userPageSize");
    const paginationButtons = document.getElementById("userPaginationButtons");
    const paginationInfo = document.getElementById("userPaginationInfo");

    if (!tableBody) return;

    const rows = Array.from(tableBody.querySelectorAll("tr"))
        .filter(row => row.querySelectorAll("td").length >= 5);

    let currentPage = 1;
    let pageSize = pageSizeSelect
        ? parseInt(pageSizeSelect.value, 10) || 10
        : 10;

    let filteredRows = [];

    // =========================================================
    // FILTER ALL USERS FIRST, THEN PAGINATE
    // =========================================================

    function filterUsers() {
        const keyword = (searchInput.value || "").toLowerCase().trim();
        const role = roleFilter.value;
        const department = departmentFilter.value;
        const campus = campusFilter ? campusFilter.value : "";

        filteredRows = rows.filter(row => {
            const cells = row.querySelectorAll("td");

            const name = cells[1].innerText.toLowerCase();
            const schoolId = cells[2].innerText.toLowerCase();
            const userRole = cells[3].innerText.trim();
            const userDepartment = cells[4].innerText.trim();
            const userCampus = row.dataset.campus || "";

            const matchesSearch =
                name.includes(keyword) ||
                schoolId.toLowerCase().includes(keyword) ||
                userRole.toLowerCase().includes(keyword) ||
                userDepartment.toLowerCase().includes(keyword);

            const matchesRole =
                role === "" || userRole === role;

            const matchesDepartment =
                department === "" || userDepartment === department;

            const matchesCampus =
                campus === "" || userCampus === campus;

            return (
                matchesSearch &&
                matchesRole &&
                matchesDepartment &&
                matchesCampus
            );
        });

        // New search/filter always starts on page 1
        currentPage = 1;
        renderTable();
    }

    // =========================================================
    // RENDER TABLE PAGE
    // =========================================================

    function renderTable() {
        const total = filteredRows.length;
        const totalPages = Math.ceil(total / pageSize);

        if (totalPages > 0 && currentPage > totalPages) {
            currentPage = totalPages;
        }

        if (total === 0) {
            currentPage = 1;
        }

        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = Math.min(startIndex + pageSize, total);

        const visibleRows = new Set(
            filteredRows.slice(startIndex, endIndex)
        );

        // Hide all rows not on the current filtered page
        rows.forEach(row => {
            row.style.display = visibleRows.has(row) ? "" : "none";
        });

        // Update the row number column for the visible page
        filteredRows.slice(startIndex, endIndex).forEach((row, index) => {
            row.cells[0].textContent = startIndex + index + 1;
        });

        // No results message
        if (noResults) {
            noResults.classList.toggle("hidden", total > 0);
        }

        renderPagination(total, totalPages, startIndex, endIndex);
    }

    // =========================================================
    // RENDER PAGINATION BUTTONS
    // =========================================================

    function renderPagination(total, totalPages, startIndex, endIndex) {
        if (!paginationButtons || !paginationInfo) return;

        paginationButtons.innerHTML = "";

        if (total === 0) {
            paginationInfo.textContent = "Showing 0–0 of 0 users";
            return;
        }

        paginationInfo.textContent =
            `Showing ${startIndex + 1}–${endIndex} of ${total} users`;

        function addButton(label, page, disabled, active = false) {
            const button = document.createElement("button");

            button.type = "button";
            button.textContent = label;
            button.disabled = disabled;

            if (active) {
                button.classList.add("active");
                button.setAttribute("aria-current", "page");
            }

            button.addEventListener("click", () => {
                currentPage = page;
                renderTable();
            });

            paginationButtons.appendChild(button);
        }

        addButton("‹", currentPage - 1, currentPage <= 1);

        // Show all pages when there are few; compact when there are many
        let pages;

        if (totalPages <= 7) {
            pages = Array.from(
                { length: totalPages },
                (_, index) => index + 1
            );
        } else {
            pages = [...new Set([
                1,
                currentPage - 1,
                currentPage,
                currentPage + 1,
                totalPages
            ])]
                .filter(page => page >= 1 && page <= totalPages)
                .sort((a, b) => a - b);
        }

        let previousPage = 0;

        pages.forEach(page => {
            if (previousPage && page - previousPage > 1) {
                const dots = document.createElement("span");
                dots.textContent = "…";
                paginationButtons.appendChild(dots);
            }

            addButton(
                String(page),
                page,
                false,
                page === currentPage
            );

            previousPage = page;
        });

        addButton("›", currentPage + 1, currentPage >= totalPages);
    }

    // =========================================================
    // FILTER EVENTS
    // =========================================================

    if (searchInput) {
        searchInput.addEventListener("input", filterUsers);
    }

    if (roleFilter) {
        roleFilter.addEventListener("change", filterUsers);
    }

    if (departmentFilter) {
        departmentFilter.addEventListener("change", filterUsers);
    }

    if (campusFilter) {
        campusFilter.addEventListener("change", filterUsers);
    }

    if (pageSizeSelect) {
        pageSizeSelect.addEventListener("change", function () {
            pageSize = parseInt(this.value, 10) || 10;
            currentPage = 1;
            renderTable();
        });
    }

    // Initial render
    filterUsers();

    // =========================================================
    // PASSWORD POPUP — EXISTING FUNCTIONALITY PRESERVED
    // =========================================================

    const proceedNotif = document.getElementById("proceednotif");
    const proceedOverlay = document.getElementById("proceedOverlay");
    const proceedPassword = document.getElementById("proceedPassword");
    const proceedError = document.getElementById("proceedError");
    const proceedConfirm = document.getElementById("proceedConfirm");
    const proceedCancel = document.getElementById("proceedCancel");

    let targetHref = null;
    let targetId = null;
    let isSubmitting = false;

    function openProceed(href, id) {
        targetHref = href;
        targetId = id;

        proceedPassword.value = "";
        proceedError.textContent = "Incorrect password.";
        proceedError.classList.add("hidden");

        proceedNotif.classList.remove("hidden");
        proceedOverlay.classList.remove("hidden");
        proceedPassword.focus();
    }

    function closeProceed() {
        targetHref = null;
        targetId = null;
        proceedPassword.value = "";

        proceedNotif.classList.add("hidden");
        proceedOverlay.classList.add("hidden");
    }

    // Clicking a patient name opens the password popup
    tableBody.addEventListener("click", function (event) {
        const link = event.target.closest(".patientLink");

        if (!link) return;

        event.preventDefault();
        openProceed(link.dataset.href, link.dataset.id);
    });

    async function submitProceed() {
        const password = proceedPassword.value;

        if (!password || !targetHref || !targetId || isSubmitting) {
            return;
        }

        isSubmitting = true;
        proceedConfirm.disabled = true;

        try {
            const response = await fetch("/verify-password", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    password,
                    patientId: targetId
                })
            });

            const data = await response.json();

            if (data.success) {
                window.location.href = targetHref;
            } else {
                proceedError.textContent = "Incorrect password.";
                proceedError.classList.remove("hidden");
                proceedPassword.value = "";
                proceedPassword.focus();
            }
        } catch (error) {
            proceedError.textContent = "Something went wrong. Try again.";
            proceedError.classList.remove("hidden");
        } finally {
            isSubmitting = false;
            proceedConfirm.disabled = false;
        }
    }

    proceedConfirm.addEventListener("click", submitProceed);
    proceedCancel.addEventListener("click", closeProceed);
    proceedOverlay.addEventListener("click", closeProceed);

    proceedPassword.addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            submitProceed();
        }
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeProceed();
        }
    });
})();
</script>
