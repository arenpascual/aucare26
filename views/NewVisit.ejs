<% layout('layout') %>

<div class="height10 justifyBetween hidden">
    <div class="width0">
        <p class="size40 str400">Visitation Record</p>
    </div>
        <div class="width0 gap8 ">
        <a href="javascript:void(0)" class="nav pnav w108" id="openConsultForm"> <i class="fas fa-plus"></i>New Visit</a>
        |
        <a href="/va" class="nav w100">Archive</a>
    </div>
</div>
<div class="height90 col justifyStart">
    <div class="height10 justifyBetween ">
        <div class="width0 gap5">
        <a href="" class="nav ">Pending</a>
        <a href="" class="nav ">Attended</a>
            <div class="selectBar w190"><i class="fas fa-filter"></i><select name="" id="">
                <option value=""></i> Filter By Date</option>
                <option value=""></i> Today</option>
                <option value=""></i> Yesterday</option>
                <option value=""></i> This Week</option>
                <option value=""></i> Last Week</option>
                <option value=""></i> This Month</option>
                <option value=""></i> Last Month</option>
                <option value=""></i> This Year</option>
                <option value=""></i> Last Year</option>
            </select>
        </div>
        <div class="selectBar w190 hidden" ><i class="fas fa-filter"></i><select name="" id="">
                <option value=""></i> Filter By Status</option>
                <option value=""></i> Pending</option>
                <option value=""></i> Attended</option>
            </select>
        </div>
        </div>
        <div class="width0 gap8 ">
            <div class="searchBar w220"><i class="fas fa-search"></i><input type="search" name="" id=""></div>
        </div>
    </div>
    <section class="height90 bgGray200 corner12 col gap10 block overflow-y1">
        <% if (allVisits && allVisits.length > 0) { %>

            <% if (allVisits.length > 0) { %>
                <% allVisits.forEach(request => { %>
                    <a href="/vv2/<%= request._id %>" class="height0 corner12 padding20 bgWhite col alignStart relative colorPrimary width100 hoverShadow1 marginBottom10">
                        
                        <p class="size14 absolute right15 top15">
                            <%= request.createdAt ? new Date(request.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'No Date' %>
                        </p>

                        <p class="size18 str500">
                            <%= request.patient.fName %> <%= request.patient.lName %> 
                            <span class="size12 border0 
                            <% if (request.status === 'Attended') { %>
                            bgBlue100
                            <% } else { %>
                            bgGreen100
                            <% } %>
                            " style="padding: 2px 8px; border-radius: 4px; margin-left: 10px;">
                                <%= request.status %>
                            </span>
                        </p>
                        
                          <p class="size14">
                        <%= request.patient.email %> 
                    </p>

                        <p class="size14"><%= request.patient.schoolId %></p>
                        <p class="size14">
                            <%= request.patient.yearLevel %> &bull; <%= request.patient.course %>
                        </p>

                        <p class="size14 str500" style="margin-top: 10px;">Complaint: 
                            <span class="sizeInherit str500" style="color: rgb(6, 74, 210);">
                                <%= request.complaints && request.complaints.length > 0 
                                    ? request.complaints.map(c => c.type).join(', ') 
                                    : request.complaint %> </span>
                        </p>

                        <p class="size14 str500" style="margin-top: 10px;">Concern: 
                            <span class="sizeInherit str500" style="color: rgb(6, 74, 210);"><%= request.concern %></span>
                        </p>
                        <% if (request.dispensed && request.dispensed.length > 0) { %>
                            <p class="size14 str500">Medicines: 
                                <span class="sizeInherit str500" style="color: rgb(6, 74, 210);">
                                    <%= request.dispensed.map(d => `${d.item} (${d.qty} ${d.unit})`).join(', ') %>
                                </span>
                            </p>
                        <% } %>
                        </a>
                <% }) %>
            <% } else { %>
                <div class="padding20 textCenter size16 colorPrimary">No Pending requests at the moment.</div>
            <% } %>

        <% } else { %>
            <div class="padding20 textCenter size16 colorPrimary">No requests found.</div>
        <% } %>
    </section>
</div>

<form action="/visitnow" method="POST" class="absolute translateCenter shadow3 width30 padding30 gap10 index500 height0 hidden" id="Consultationform">
    <p class="size24">Consultation Request Form:</p>
    <div class="field">
        <label for="">Concern</label>
        <div class="selectBar">
            <select name="concern" id="concernSelect" required>
                <option value="" title="" disabled selected >Select Concern</option>
                <option value="Rest/Observation" title="if you need to use a clinic bed or require a quiet space to rest.">Rest/Observation</option>
                <option value="Health Concern / Request Medicines" title="if you are seeking specific medication or basic first aid.">Health Concern / Request Medicines</option>
                <option value="Health Consultation" title="if you need to speak directly with a health professional for advice.">Health Consultation</option>
            </select>
        </div>
    </div>
    <section class="gap10 hidden" id="medicineField">
    <div class="field">
        <label for="">Type of Medicines <span class="gray inherit">( Optional )</span></label>
        <div class="selectBar">
            <select name="item" id="">
                <option value="" disabled selected >--Select--</option>
                <option value="Carbocisteine" title="Hello">Carbocisteine (SOLMUX)</option>
                <option value="Cetirizine" title="Hello">Cetirizine</option>
                <option value="Cinnarizine" title="Hello">Cinnarizine</option>
                <option value="Dicycloverine" title="Hello">Dicycloverine</option>
                <option value="Hyoscine" title="Hello">Hyoscine (BUSCOPAN)</option>
                <option value="Kremil-S" title="Hello">Kremil-S</option>
                <option value="Loperamide" title="Hello">Loperamide (DIATABS)</option>
                <option value="Mefenamic" title="Hello">Mefenamic Acid</option>
                <option value="Neozep" title="Hello">Neozep</option>
                <option value="Paracetamol" title="Hello">Paracetamol (BIOGESIC)</option>
                <option value="Salbutamol Neb" title="Hello">Salbutamol Neb</option>
            </select>
        </div>
    </div>
    <div class="field">
        <label for="">Quantity</label>
        <div class="selectBar">
            <select name="qty" id="">
                <option value="" >--Select--</option>
                <option value="1" title="Minimum">1</option>
                <option value="2" title="Maximum">2</option>
            </select>
        </div>
    </div>

    </section>
    
    <div class="field">
        <label for="">Complaint <span class="gray inherit">( Optional )</span></label>
        <div class="selectBar">
            <select name="complaint" id="">
                <option value="" disabled selected >Select Complaint</option>
                <option value="Allergy">Allergy</option>
                <option value="Body Muscle Pain">Body/Muscle pain</option>
                <option value="Colds">Colds</option>
                <option value="Cough">Cough</option>
                <option value="Difficulty of Breathing">Difficulty of Breathing</option>
                <option value="Dizziness">Dizziness</option>
                <option value="Dysmenorrhea Menstrual Cramps">Dysmenorrhea/Menstrual cramps</option>
                <option value="Fever">Fever</option>
                <option value="Headache">Headache</option>
                <option value="Hyperacidity">Hyperacidity</option>
                <option value="Lbm">LBM</option>
                <option value="Toothache">Toothache</option>
                <option value="Abdominal Pain Cramps">Abdominal pain/cramps</option>
            </select>
        </div>
    </div>
<section class="justifyBetween gap70 padding0">
    <div class="nav width100" id="closeForm">Cancel</div>
    <button type="submit" class="nav pnav width100">Submit</button>
</section>
</form>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('openConsultForm');
    const closeBtn = document.getElementById('closeForm');
    const form = document.getElementById('Consultationform');

    openBtn.addEventListener('click', () => {
        form.classList.remove('hidden');
    });

    closeBtn.addEventListener('click', () => {
        form.classList.add('hidden');
    });

    document.addEventListener('click', (e) => {
        if (!form.classList.contains('hidden') &&
            !form.contains(e.target) &&
            !openBtn.contains(e.target)) {
            form.classList.add('hidden');
        }
    });

    form.addEventListener('click', (e) => e.stopPropagation());
});

const concern = document.getElementById("concernSelect");
const medicineField = document.getElementById("medicineField");

concern.addEventListener("change", function() {
    if (this.value === "Health Concern / Request Medicines") {
        medicineField.classList.remove("hidden");
    } else {
        medicineField.classList.add("hidden");
    }
});
</script>