<% layout('layout') %>


<div class="height10 justifyBetween">
    <div class="width0">
        <p class="size40 str400">Visitation Record</p>
    </div>
        <div class="width0 gap8 ">
        <a href="" class="nav pnav w108"> <i class="fas fa-plus"></i>Add Record</a>
        |
        <a href="/va" class="nav w100">Archive</a>
    </div>
</div>
<div class="height90 col justifyStart">
    <div class="height10 justifyBetween">
        <div class="width0">
            <div class="selectBar w190"><i class="fas fa-filter"></i><select name="" id="">
                <option value=""></i> Filter By</option>
            </select></div>
        </div>
        <div class="width0 gap8 ">
            <div class="searchBar w220"><i class="fas fa-search"></i><input type="search" name="" id=""></div>
        </div>
    </div>
    <section class="height90 bgGray200 corner12 b col gap10 block overflow-y1">
        <a href="/vv2" class="height0 width100 corner12 shadow1 padding20 bgWhite col alignStart relative colorPrimary">
                <p class="size14 absolute right15 top15">August 20, 2025</p>
                <p class="size18 str500">Arenvie Pascual</p>
                <p class="size14">4th Year &bull; Bachelor of Science in Information Technology</p>
                <p class="size14 str500">Complaint: <span class="sizeInherit str500" style="color: rgb(6, 74, 210);">Headache</span></p>
        </a>
        <br>
        <section class="height0 alignStart bgGray200">
            <section class="height70 width25 bgWhite shadow1 col justifyStart corner5 ">
                <form class="justifyStart" action="">
                    <p class="size20 str500">New Visit:</p>
                    <div class="field">
                    <label class="str500" for="username"> Patient:</label> 
                    <input type="text" name="username" placeholder="Find Patient Name" required>
                    </div>
                    <div class="field">
                    <label for="">Reason:</label>
                    <div class="selectBar">
                        <select name="" id="">
                            <option value="" selected disabled>--Select--</option>
                            <option value="">Rest/Observation</option>
                            <option value="">Request Medicines</option>
                            <option value="">Health Concern</option>
                        </select>
                    </div>
                    <div class="field">
                    <label for="">Complaint:</label>
                    <div class="selectBar">
                        <select name="" id="">
                            <option value="" selected disabled>--Select--</option>
                            <option value="">Headache</option>
                            <option value="">Fever</option>
                            <option value="">Dizziness</option>
                            <option value="">Allergy</option>
                            <option value="">Hyperacidity</option>
                        </select>
                    </div>
                    <div class="justifyEnd padding10 justifyBetween">
                    <a class="nav" href="">Cancel</a>
                    <a class="nav pnav" href="">Submit</a>
                    </div>
                </form>
            </section>
        </section>
    </section>
</div>






