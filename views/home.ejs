<% layout('template') %>


<div class="col padding10 width35 justifyStart relative">
    <div class="height0 corner15 col alignStart padding20 relative">
        <p class="size40">Welcome</p>
        <p class="size40" style="margin-top: -24px !important;"><%= user.fName.toUpperCase() %> <%= user.lName.toUpperCase() %>!</p>
        

        <% if (!isClinicOpen) { %>
            <a href="javascript:void(0)" id="formBtn" class="nav pnav absolute bottom20 right20 width25">Visit Now</a>
            <p class="size18 str400 noteBlue"><i class="fas fa-exclamation-circle"></i> Clinic is closed. Open 7:30 AM - 5:30 PM</p>
        <% } else if (hasActiveVisit) { %>
            <p class="size18 str400 noteBlue"><i class="fas fa-exclamation-circle"></i> You already have a pending request. Please wait for it to be attended.</p>
        <% } else { %>
            <br>
            <p class="size20" style="margin-top: -15px !important;">Need Care?</p>
        <% } %>
    </div>

    <% if (!isClinicOpen || hasActiveVisit) { %>
        <p class="size12 red" style="padding: 0 20px; margin-top: -10px;">
            <% if (!isClinicOpen) { %>
                
            <% } else { %>
                
            <% } %>
        </p>
    <% } %>
    <div class="height0 corner15 col alignStart bgWhite padding20">
        <p class="size20">Services</p>
        <p class="size20"><i class="fas fa-check-circle"></i> Free Basic Medication</p>
        <p class="size20"><i class="fas fa-check-circle"></i> First Aid & Minor Injury</p>
        <p class="size20"><i class="fas fa-check-circle"></i> Vital Signs Monitoring</p>
        <p class="size20"><i class="fas fa-check-circle"></i> Rest & Recovery Area</p>
        <p class="size20"><i class="fas fa-check-circle"></i> Free Medicine</p>
    </div>
</div>
    <!-- TERMS AND CONDITIONS -->
    <section class="shadow1 col absolute bgWhite gap15 corner20 padding30 index100 height0 width30 textCenter justifyCenter alignCenter hidden" id="tnc">
        <a href="" id="lgBtn" class="nav cnav absolute right20 top20"><i class="fas fa-times"></i></a>
        <p class="size24 colorPrimary str600">Magandang AraU <%= user.fName %></p>
        <p class="size16 textBalance">In accordance with RA 10173 (Data Privacy Act of 2012), all information collected by AU Care will be used exclusively for PHINMA AU South Campus clinic records and inventory purposes. Your data is strictly confidential and protected.</p>
        
        <!-- ✅ CHECKBOX -->
        <div class="row gap10 alignCenter">
            <input type="checkbox" id="agreeCheck">
            <label for="agreeCheck" class="size13 str500">
                I agree to the Terms and Conditions
            </label>
        </div>
        
        <p class="size12 textBalance noteBlue"> <span class="str600">Before you proceed, </span>please be informed that this form is for non-emergency clinic requests. If you are experiencing a medical emergency, please seek immediate assistance from the nearest staff member.</p>

        <br>

        <!-- ✅ BUTTON -->
        <a id="agreeBtn" class="nav pnav" href="#"
        style="width: 70%; opacity: 0.5; pointer-events: none;">
        Proceed
        </a>
    </section>

<div class="col width35 justifyStart padding40">
    <div class="height0 width100 corner15 col alignStart porcelain padding20 gap10">
        <section class="padding0 justifyBetween">
        <p class="size20">Recents</p>
        <a href="/sa" class="size18">See All</a>
        </section>
   <% if (recentVisits && recentVisits.length > 0) { %>
        <% recentVisits.forEach(v => { %>
            <a href="/vv1/<%= v._id %>" class="width100 gap5 bgWhite corner10 shadow1 alignStart col relative padding10">
                <p class="size16 str5"><%= v.complaint %></p>
                <p class="size12 str4 <%= v.status === 'Attended' ? 'noteGreen' : 'noteBlue' %>"><%= v.status %></p>
                <p class="size12 gray absolute right10 top10">
                    <%= new Date(v.createdAt).toLocaleString('en-US', { 
                        month: 'short', day: 'numeric', year: 'numeric', 
                        hour: 'numeric', minute: '2-digit' 
                    }) %>
                </p>
            </a>
        <% }) %>
    <% } else { %>
        <p class="size14 gray">No visit records yet.</p>
    <% } %>
    </div>
    <div class="height0 corner15 col alignStart padding20">
        <p class="size40">About Us</p>
        <br>
        <p class="size20" style="margin-top: -5px !important;">AuCare | CSDL</p>
        <p class="size20" style="margin-top: -5px !important;">Phinma Araullo University South Campus</p>
        <p class="size20" style="margin-top: -5px !important;">Need Help? <a href="" class="sizeInherit inline navy">Learn More</a></p>
    </div>
    
</div>


<form action="/visitnow" method="POST" class="absolute translateCenter shadow3 width40 padding30 gap10 index500 height0 hidden" id="Consultationform">
    <p class="size24">Consultation Request Form</p>
    <section class="col height0 borderPrimary corner15 alignStart">
        <p class="size14 str600 marginBottom10">REQUEST GUIDELINES</p>
        <p class="size12"><span class="str600 size12">Concern:</span> Select the option that best matches the purpose of your visit.</p>
        <p class="size12"><span class="colorPrimary str600">&bull; Rest/Observation</span> For students who need to rest or use a clinic bed.</p>
        <p class="size12"><span class="colorPrimary str600">&bull; Health Concern/Request Medicine or Supply</span> For first aid, basic medication, or medical supplies.</p>
        <p class="size12"><span class="colorPrimary str600">&bull; Health Consultation</span> For consultation or assessment by the clinic staff.</p>
        <br>
        <p class="size12"><span class="str600 size12">Complaint:</span> If applicable, select the complaint that best describes your current symptoms or reason for visiting.</p>
    </section>
    <br>
    <div class="field">
        <label for="">Concern</label>
        <div class="selectBar">
            <select name="concern" id="concernSelect" required>
                <option value="" title="" disabled selected >Select Concern</option>
                <option value="Rest/Observation" title="if you need to use a clinic bed or require a quiet space to rest.">Rest/Observation</option>
                <option value="Health Concern / Request Medicines" title="if you are seeking specific medication or basic first aid.">Health Concern / Request Medicines</option>
                <option value="Health Consultation" title="if you need to speak directly with a health professional for advice.">Health Consultation</option>
            </select>
        </div>
    </div>
    <section class="gap10 hidden" id="medicineField">
    <div class="field">
        <label for="">Type of Medicines <span class="gray inherit">( Optional )</span></label>
        <div class="selectBar">
            <select name="item" id="">
                <option value="" disabled selected >--Select--</option>
                <option value="Carbocisteine" title="Hello">Carbocisteine (SOLMUX)</option>
                <option value="Cetirizine" title="Hello">Cetirizine</option>
                <option value="Cinnarizine" title="Hello">Cinnarizine</option>
                <option value="Dicycloverine" title="Hello">Dicycloverine</option>
                <option value="Hyoscine" title="Hello">Hyoscine (BUSCOPAN)</option>
                <option value="Kremil-S" title="Hello">Kremil-S</option>
                <option value="Loperamide" title="Hello">Loperamide (DIATABS)</option>
                <option value="Mefenamic" title="Hello">Mefenamic Acid</option>
                <option value="Neozep" title="Hello">Neozep</option>
                <option value="Paracetamol" title="Hello">Paracetamol (BIOGESIC)</option>
                <option value="Salbutamol Neb" title="Hello">Salbutamol Neb</option>
            </select>
        </div>
    </div>
    <div class="field">
        <label for="">Quantity</label>
        <div class="selectBar">
            <select name="qty" id="">
                <option value="" >--Select--</option>
                <option value="1" title="Minimum">1</option>
                <option value="2" title="Maximum">2</option>
            </select>
        </div>
    </div>

    </section>
    
    <div class="field">
        <label for="">Complaint <span class="gray inherit">( Optional )</span></label>
        <div class="selectBar">
            <select name="complaint" id="">
                <option value="" disabled selected >Select Complaint</option>
                <option value="Allergy">Allergy</option>
                <option value="Body Muscle Pain">Body/Muscle pain</option>
                <option value="Colds">Colds</option>
                <option value="Cough">Cough</option>
                <option value="Difficulty of Breathing">Difficulty of Breathing</option>
                <option value="Dizziness">Dizziness</option>
                <option value="Dysmenorrhea Menstrual Cramps">Dysmenorrhea/Menstrual cramps</option>
                <option value="Fever">Fever</option>
                <option value="Headache">Headache</option>
                <option value="Hyperacidity">Hyperacidity</option>
                <option value="Lbm">LBM</option>
                <option value="Toothache">Toothache</option>
                <option value="Abdominal Pain Cramps">Abdominal pain/cramps</option>
            </select>
        </div>
    </div>
    <br>
    <div class="noteBlue col textBalance">
        <p class="str400"><span class="str600">Before You Submit, </span>Please review your selected Concern and Complaint to ensure your request is accurate.</p>
    </div>
    <p class="str400 textCenter textBalance"><span class="str600">What Happens Next?</span> After submission, your request will be reviewed by the clinic staff. Please wait for approval before proceeding to the clinic.</p>
    

    <br>
<section class="justifyBetween gap70 padding0">
    <div class="nav width100" id="closeForm">Cancel</div>
    <button type="submit" class="nav pnav width100">Submit</button>
</section>
</form>

<section class="absolute translateCenter shadow3 width30 padding30 gap10 index500 bgWhite col corner15 height0 hidden" id="notificationBox">
    <img class="h100 w100" src="/images/like.png" alt="">
    <section class="padding0 col alignCenter">
        <p class="size23 str500">Request Submitted</p>
        <p class="size17">Wait for the approval notification.</p>
    </section>
    <a class="nav w120 size15" href="javascript:void(0)" id="gotItBtn">Got It!</a>
</section>

<script>
// =============================
// SHOW MEDICINE FIELD
// =============================
const concern = document.getElementById("concernSelect");
const medicineField = document.getElementById("medicineField");

concern.addEventListener("change", function() {
    if (this.value === "Health Concern / Request Medicines") {
        medicineField.classList.remove("hidden");
    } else {
        medicineField.classList.add("hidden");
    }
});


// =============================
// BUTTONS & MODALS
// =============================
const formBtn = document.getElementById("formBtn");
const tnc = document.getElementById("tnc");
const consultationForm = document.getElementById("Consultationform");
const closeForm = document.getElementById("closeForm");

const agreeBtn = document.getElementById("agreeBtn");
const agreeCheck = document.getElementById("agreeCheck");


// =============================
// STEP 1: CLICK "VISIT NOW"
// =============================
// Guard: kapag naka-disable ang button (clinic closed / may pending), wala itong id="formBtn"
if (formBtn) {
    formBtn.addEventListener("click", function(){
        tnc.classList.remove("hidden");
    });
}


// =============================
// STEP 2: ENABLE PROCEED BUTTON
// =============================
agreeCheck.addEventListener("change", function(){
    if(this.checked){
        agreeBtn.style.pointerEvents = "auto";
        agreeBtn.style.opacity = "1";
    } else {
        agreeBtn.style.pointerEvents = "none";
        agreeBtn.style.opacity = "0.5";
    }
});


// =============================
// STEP 3: PROCEED TO FORM
// =============================
agreeBtn.addEventListener("click", function(e){
    e.preventDefault();
    tnc.classList.add("hidden");
    consultationForm.classList.remove("hidden");
});


// =============================
// CLOSE FORM
// =============================
closeForm.addEventListener("click", function(){
    consultationForm.classList.add("hidden");
});


// =============================
// NOTIFICATION
// =============================
const gotItBtn = document.getElementById("gotItBtn");
const notification = document.getElementById("notificationBox");

gotItBtn.addEventListener("click", function(){
    notification.classList.add("hidden");
});
</script>