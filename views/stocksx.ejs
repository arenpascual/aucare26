<% layout('layout') %>

<form class="width30 absolute shadow2 corner10 translateCenter col index100 bgWhite alignStart gap10 hidden" id="editCard">
    <p class="size24 str5">Update Item</p>
    <div class="field">
        <label for="">Name</label>
        <input type="text">
    </div>
    <div class="field">
        <label for="">Stocks</label>
        <input type="text">
    </div>
    <div class="field">
        <label for="">Description</label>
        <input type="text">
    </div>
    <div class="height0 gap10">
        <button class="nav borderPrimary width100">Cancel</button>
        <button class="nav pnav width100">Update</button>
    </div>
</form>
<div class="height10 justifyBetween">
    <div class="width0">
        <p class="size40 str400">Stock Management</p>
    </div>
    <div class="width0 gap8 ">
        <a href="/sta" class="nav w100">Archive</a>
        |
        <a href="" class="nav ">Inventory History</a>
    </div>
</div>
<div class="height90 col justifyStart">
    <div class="height10 justifyBetween">
        <div class="width0 gap10">
            <div class="selectBar w60">
                All
            </div>
            <div class="selectBar w80 ">
                In Stock
            </div>
            <div class="selectBar w90">
                Low Stock
            </div>
            <div class="selectBar w100">
                Out of Stock
            </div>
                
        </div>
        <div class="width0 gap8 ">
            <div class="searchBar w220"><i class="fas fa-search"></i><input type="search" name="" id=""></div>
            <div class="selectBar w190"><i class="fas fa-filter"></i><select name="" id="">
                <option value=""></i> Filter By</option>
                <option value="">Medicines</option>
                <option value="">Supplies</option>
            </select>
        </div>
            
        </div>
    
    </div>
    <section class="wrap justifyStart alignStretch gap20">
        <section class="stCard width20 shadow1 corner10 padding15 relative height0 col alignStart justifyStart">
            <div class="cnav absolute top15 right15 borderGray"><i class="fas fa-stethoscope"></i></div>
            <img src="/images/item.png" alt="" class="h100 corner10">
            <p class="size20 str500">Salbutamol</p>
            <p class="size14">33 pcs</p>
            <p class="size12 textWrap">This is the sample description of the item listed above</p>
            <a href="javascript:void(0)" class="editBtn nav marginTop10"><i class="fas fa-pen"></i> Update Stock</a>
        </section>
        <section class="stCard width20 shadow1 corner10 padding15 relative height0 col alignStart justifyStart">
            <div class="cnav absolute top15 right15 borderGray"><i class="fas fa-stethoscope"></i></div>
            <img src="/images/item.png" alt="" class="h100 corner10">
            <p class="size20 str500">Band Aid</p>
            <p class="size14">33 packs</p>
            <p class="size12 textWrap">This is the sample description of the item listed above</p>
            <a href="javascript:void(0)" class="editBtn nav marginTop10"><i class="fas fa-pen"></i> Update Stock</a>
        </section>
        <section class="stCard width20 shadow1 corner10 padding15 relative height0 col borderDotted borderGray">
            <div class="cnavLG border0">
                <i class="fas fa-plus"></i>
            </div>
        </section>
    </section>
</div>

<script>
    const editCard = document.getElementById('editCard');
    const editBtns = document.querySelectorAll('.editBtn');
    const closeBtn = document.querySelector('.closeBtn');

    // Show edit card when ANY edit button is clicked
    editBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            editCard.classList.remove('hidden');
        });
    });

    // Hide edit card when close button is clicked
    closeBtn.addEventListener('click', () => {
        editCard.classList.add('hidden');
    });
</script>
