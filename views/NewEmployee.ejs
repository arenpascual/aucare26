<% layout('layout') %>

<div class="right col polaroid">

    <a href="/e" class="left20 top20 nav absolute">
        <i class="fas fa-chevron-left"></i> Return
    </a>

    <div class="width70 height0">

        <form class="bgWhite shadow1 height0 gap10 padding10 justifyStart width70 relative" action="/new-employee" method="POST">

            <p class="size30 str500">New Employee</p>

            <div class="field">
                <label>Role</label>
                <div class="selectBar">
                    <select name="role" required>
                        <option value="" selected disabled>Select Role</option>
                        <option value="Super Admin">Super Admin</option>
                        <option value="Admin">Admin</option>
                        <option value="Sub Admin">Sub Admin</option>
                    </select>
                </div>
            </div>

            <section class="gap5 padding0">

                <div class="field">
                    <label>First Name</label>
                    <input type="text" name="fName" required>
                </div>

                <div class="field">
                    <label>Last Name</label>
                    <input type="text" name="lName" required>
                </div>

            </section>

            <section class="gap5 padding0">

                <div class="field">
                    <label>Middle Name</label>
                    <input type="text" name="mName">
                </div>

                <div class="field">
                    <label>Extension Name</label>
                    <input type="text" name="xName">
                </div>

            </section>

            <div class="field">
                <label>Email</label>
                <input type="email" name="email" required>
            </div>

            <div class="field">
                <label>Contact Number</label>
                <input type="text" name="phone" required>
            </div>

            <div class="field">
                <label>Gender</label>
                <div class="selectBar">
                    <select name="gender" required>
                        <option value="" selected disabled>Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
            </div>

            <div class="field">
                <label>Address</label>
                <input type="text" name="address" required>
            </div>

            <div class="field">
                <label>Employee ID</label>
                <input type="text" name="schoolId" required>
            </div>

            <!-- Hidden Fields -->
            <input type="hidden" name="eName" value="none">
            <input type="hidden" name="ePhone" value="none">
            <input type="hidden" name="eAddress" value="none">

            <div class="justifyEnd height0">
                <button type="submit" class="nav pnav">
                    <i class="fas fa-check-circle"></i> Add to Record
                </button>
            </div>

        </form>

    </div>

</div>