<% layout('layout') %>
<div class="height10 justifyBetween">
    
    <div class="width0 ">
    <a href="/um" class="nav"><i class="fas fa-chevron-left"></i> Back</a> 
    </div>
    <p class="size40 str400 "> Archive User Management</p>
</div>
<div class="height90 col justifyStart padding10">
    <div class="height0 justifyBetween">
        <div class="width0">
            <div class="selectBar w190"><i class="fas fa-filter"></i><select name="" id="">
                <option value=""></i> Filter By</option>
            </select></div>
        </div>
        <div class="width0 gap8 ">
            <div class="searchBar w220"><i class="fas fa-search"></i><input type="search" name="" id=""></div>
        </div>
    
    </div>
    <br>
    <table>
        <thead>
            <tr>
                <th class="width5">#</th>
                <th class="width20">Name</th>
                <th class="width10">School ID</th>
                <th class="width20">Email</th>
                <th class="width15">Role</th>
                <th class="width30">Course</th>
            </tr>
        </thead>
      <tbody>
    <% if (allUsers && allUsers.length > 0) { %>
        <% allUsers.forEach((user, index) => { %>
            <tr>
                <td><%= index + 1 %></td>
                <td><a href="/uv/<%= user._id %>" class="underline navy"><%= user.fName %> <%= user.lName %></a></td>
                <td><%= user.schoolId || '—' %></td>
                <td><%= user.email || '—' %></td>
                <td><%= user.role %></td>
                <td><%= user.course || '—' %></td>
            </tr>
        <% }) %>
    <% } else { %>
        <tr>
            <td colspan="6" class="center">No archived users found.</td>
        </tr>
    <% } %>
</tbody>
    </table>
</div>