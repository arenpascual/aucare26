</head>
<body class="polaroid">
    <a href="/h" class="hidden">home</a>


    <div class="left width60 col" id="lC">
        <div class="top relative justifyStart padding30" id="h1">
            <i class="fas fa-stethoscope absolute opacity1 top38 size90 h160 w160 padding20 corner500 porcelain" id="stet" style="left: 150px;"></i>
            <div class="height0 width0 index50 " style="margin-left: 80px;" id="h5">
                <img src="/images/logo.png" alt="" class="corner500 h140">
            </div>
            <div class="height0 width0 index50 hidden" id="h6">
                <img src="/images/logo.png" alt="" class="corner500 h60">
            </div>
            <div class="col width0 alignStart colorPrimary index50" id="h3">
                <p class="size90 str500">AuCare</p>
                <p class="size30 textWrap" style="margin-top:-25px !important;">PHINMA Araullo University </p>
            </div>
            <div class="col width0 colorPrimary index50 hidden" id="h4">
                <p class="size20 str500">AuCare</p>
                <p class="size14 textWrap" style="margin-top:-5px !important;">PHINMA Araullo University </p>
            </div>
        </div>
        <div class="bottom justifyStart paddingInline75 paddingBottom70 paddingTop20" id="h2">
            <section class="h300 corner15 padding20 glass col alignStart gap15">
                <p class="size18 str500 marginLeft10 colorPrimary">Need Help? <a href="" class="inline sizeInherit underline">Learn More </a></p>
                <video class="abstractBG2 width100 height100 corner15" src="/image/video.mp4"></video>
            </section>
        </div>
    </div>
    <div class="right width40 col">
        <div class="up col gap10 alignStart height0 padding20">
            <a href="/" class="nav"><i class="fas fa-chevron-left"></i> Return</a>
            <form id="otpForm" class="bgWhite shadow1 height0 gap10 padding30 width80 kentoy" action="">
    <div class="nav cnavLG"><i class="fas fa-key"></i></div>
    <p class="size20 str500"> Confirm Code</p>
    <p>Please enter the OTP code sent to your email to continue.</p>
    <p class="noteGray">This code expires in 5 minutes.</p>
    <div class="field row gap5 padding0">
        <label for="" class="str500"></label>
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-input" name="otp1" id="otp1" required>
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-input" name="otp2" id="otp2" required>
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-input" name="otp3" id="otp3" required>
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-input" name="otp4" id="otp4" required>
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-input" name="otp5" id="otp5" required>
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-input" name="otp6" id="otp6" required>
    </div>
    <br>
    <div class="field">
        <button type="submit" class="nav pnav width100">Verify</button>
    </div>
</form>
        </div>
    </div>

<script>
    // Logic para pagsamahin ang 6 na digits at isend sa backend
    document.getElementById('otpForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const inputs = document.querySelectorAll('.otp-input');
        let otpCode = "";
        inputs.forEach(input => otpCode += input.value);

        try {
            const response = await fetch('/api/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ otp: otpCode })
            });

            const data = await response.json();

            if (response.ok) {
                window.location.href = '/success'; // Success page
            } else {
                alert(data.message); // Maling OTP o Expired
            }
        } catch (err) {
            alert("Error connecting to server.");
        }
    });

    // Auto-focus logic para sa boxes
    const inputs = document.querySelectorAll('.otp-input');
    inputs.forEach((input, index) => {
        input.addEventListener('input', () => {
            if (input.value && index < inputs.length - 1) inputs[index + 1].focus();
        });
    });
</script>
</body>
</html>