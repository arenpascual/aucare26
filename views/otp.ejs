<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <form id="otpForm" class="bgWhite shadow1 height0 gap10 padding30 width80">
    <div class="nav cnavLG"><i class="fas fa-key"></i></div>
    <p class="size20 str500"> Confirm Code</p>
    <p class="noteGray">Enter the OTP sent to your email. This code expires in 5 minutes.</p>
    
    <div class="field">
        <label class="str500">Please enter the 6-digit OTP code.</label>
        <section class="gap5" style="display: flex; justify-content: space-between;">
            <input type="text" class="otp-input" maxlength="1" required style="width: 40px; text-align: center;">
            <input type="text" class="otp-input" maxlength="1" required style="width: 40px; text-align: center;">
            <input type="text" class="otp-input" maxlength="1" required style="width: 40px; text-align: center;">
            <input type="text" class="otp-input" maxlength="1" required style="width: 40px; text-align: center;">
            <input type="text" class="otp-input" maxlength="1" required style="width: 40px; text-align: center;">
            <input type="text" class="otp-input" maxlength="1" required style="width: 40px; text-align: center;">
        </section>
    </div>
    <br>
    <div class="field">
        <button type="submit" class="nav pnav width100">Verify OTP</button>
    </div>
</form>

<script>
    // Logic para pagsamahin ang 6 na digits at isend sa backend
    document.getElementById('otpForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const inputs = document.querySelectorAll('.otp-input');
        let otpCode = "";
        inputs.forEach(input => otpCode += input.value);

        try {
            const response = await fetch('/api/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ otp: otpCode })
            });

            const data = await response.json();

            if (response.ok) {
                window.location.href = '/success'; // Success page
            } else {
                alert(data.message); // Maling OTP o Expired
            }
        } catch (err) {
            alert("Error connecting to server.");
        }
    });

    // Auto-focus logic para sa boxes
    const inputs = document.querySelectorAll('.otp-input');
    inputs.forEach((input, index) => {
        input.addEventListener('input', () => {
            if (input.value && index < inputs.length - 1) inputs[index + 1].focus();
        });
    });
</script>
</body>
</html>