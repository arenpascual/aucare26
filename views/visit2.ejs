                            No medicines currently in stock
                        </option>

                    <% } else { %>

                        <% availableMedicines.forEach(m => { %>

                            <option
                                value="<%= m.name %>"
                                data-remaining="<%= m.remaining %>"
                                title="<%= m.remaining %> <%= m.unit %> available"
                            >

                                <%= m.name %>

                                <% if (m.brandName) { %>
                                    (<%= m.brandName %>)
                                <% } %>

                            </option>

                        <% }) %>

                    <% } %>

                </select>

            </div>


            <% if (availableMedicines.length === 0) { %>

                <p
                    class="size12"
                    style="color:red;"
                >
                    No medicines currently in stock.
                </p>

            <% } %>

        </div>


        <div class="field">

            <label for="qtySelect">
                Quantity
            </label>

            <div class="selectBar">

                <select
                    name="qty"
                    id="qtySelect"
                >

                    <option
                        value=""
                        selected
                    >
                        --Select--
                    </option>

                </select>

            </div>

            <p
                id="qtyStockHint"
                class="size12 gray"
            ></p>

        </div>

    </section>


    <!-- =========================================================
         COMPLAINT
    ========================================================== -->

    <div class="field">

        <label for="">

            Complaint

            <span class="gray inherit">
                ( Optional )
            </span>

        </label>


        <div class="selectBar">

            <select
                name="complaint"
                id=""
            >

                <option
                    value=""
                    disabled
                    selected
                >
                    Select Complaint
                </option>

                <option value="Allergy">
                    Allergy
                </option>

                <option value="Body Muscle Pain">
                    Body/Muscle pain
                </option>

                <option value="Colds">
                    Colds
                </option>

                <option value="Cough">
                    Cough
                </option>

                <option value="Difficulty of Breathing">
                    Difficulty of Breathing
                </option>

                <option value="Dizziness">
                    Dizziness
                </option>

                <option value="Menstrual Cramps">
                    Menstrual cramps
                </option>

                <option value="Fever">
                    Fever
                </option>

                <option value="Headache">
                    Headache
                </option>

                <option value="Hyperacidity">
                    Hyperacidity
                </option>

                <option value="Lbm">
                    LBM
                </option>

                <option value="Toothache">
                    Toothache
                </option>

                <option value="Abdominal Pain Cramps">
                    Abdominal pain/cramps
                </option>

            </select>

        </div>

    </div>


    <!-- =========================================================
         BUTTONS
    ========================================================== -->

    <section class="justifyBetween gap70 padding0">

        <div
            class="nav width100"
            id="closeForm"
        >
            Cancel
        </div>

        <button
            type="submit"
            class="nav pnav width100"
        >
            Submit
        </button>

    </section>

</form>


<!-- =============================================================
     NEW VISIT FORM SCRIPT
============================================================== -->

<script>

document.addEventListener('DOMContentLoaded', () => {

    const openBtn =
        document.getElementById('openConsultForm');

    const closeBtn =
        document.getElementById('closeForm');

    const form =
        document.getElementById('Consultationform');


    openBtn.addEventListener('click', () => {

        form.classList.remove('hidden');

    });


    closeBtn.addEventListener('click', () => {

        form.classList.add('hidden');

    });


    document.addEventListener('click', (e) => {

        if (
            !form.classList.contains('hidden') &&
            !form.contains(e.target) &&
            !openBtn.contains(e.target)
        ) {

            form.classList.add('hidden');

        }

    });


    form.addEventListener('click', (e) => {

        e.stopPropagation();

    });

});


// ============================================================
// CONCERN -> MEDICINE FIELD
// ============================================================

const concern =
    document.getElementById("concernSelect");

const medicineField =
    document.getElementById("medicineField");


concern.addEventListener("change", function() {

    if (
        this.value ===
        "Health Concern / Request Medicines"
    ) {

        medicineField.classList.remove("hidden");

    } else {

        medicineField.classList.add("hidden");

    }

});


// ============================================================
// MEDICINE ITEM -> DYNAMIC QTY
// ============================================================

const itemSelect =
    document.getElementById("itemSelect");

const qtySelect =
    document.getElementById("qtySelect");

const qtyStockHint =
    document.getElementById("qtyStockHint");


if (itemSelect && qtySelect) {

    itemSelect.addEventListener(
        "change",
        function() {

            const opt =
                itemSelect.options[
                    itemSelect.selectedIndex
                ];


            const remaining =
                parseInt(
                    opt.getAttribute(
                        "data-remaining"
                    ) || "0",
                    10
                );


            qtySelect.innerHTML =
                '<option value="" selected>--Select--</option>';


            if (
                !opt.value ||
                remaining <= 0
            ) {

                qtyStockHint.textContent = "";

                return;

            }


            // Maximum 2 per request
            const maxOption =
                Math.min(
                    remaining,
                    2
                );


            for (
                let i = 1;
                i <= maxOption;
                i++
            ) {

                const o =
                    document.createElement("option");


                o.value = i;

                o.textContent = i;


                if (i === 1) {
                    o.title = "Minimum";
                }


                if (i === maxOption) {
                    o.title = "Maximum";
                }


                qtySelect.appendChild(o);

            }


            qtyStockHint.textContent =
                `${remaining} in stock`;

        }
    );

}

</script>


<!-- =============================================================
     PATIENT SEARCH SCRIPT
============================================================== -->

<script>

const search =
    document.getElementById("patientSearch");

const list =
    document.getElementById("patientList");


search.addEventListener(
    "input",
    function () {

        const keyword =
            this.value.toLowerCase();


        list.style.display =
            "flex";


        let visible = 0;


        [
            ...list.options
        ].forEach(option => {

            if (
                option.dataset.name
                    .includes(keyword)
            ) {

                option.hidden = false;

                visible++;

            } else {

                option.hidden = true;

            }

        });


        if (visible === 0) {

            list.style.display =
                "none";

        }

    }
);


list.addEventListener(
    "change",
    function () {

        search.value =
            list.options[
                list.selectedIndex
            ].text;


        list.style.display =
            "none";

    }
);

</script>


<!-- =============================================================
     VISIT LIST:
     TABS + DATE FILTER + CUSTOM RANGE + SEARCH
============================================================== -->

<script>
(function () {
    const container = document.getElementById('visitsContainer');
    if (!container) return;

    const cards = Array.from(container.querySelectorAll('.visitCard'));
const noResultsMsg = document.getElementById('noResultsMsg');

// SORT: latest visit first (newest -> oldest)
cards.sort((a, b) => {
    const dateA = parseInt(a.dataset.date, 10) || 0;
    const dateB = parseInt(b.dataset.date, 10) || 0;
    return dateB - dateA;
});

// Re-arrange the cards in the DOM using the sorted order
cards.forEach(card => {
    container.insertBefore(card, noResultsMsg);
});

    const tabAll = document.getElementById('tabAll');
    const tabProceed = document.getElementById('tabProceed');
    const tabAttended = document.getElementById('tabAttended');

    const dateFilterSelect = document.getElementById('dateFilterSelect');
    const customDateRange = document.getElementById('customDateRange');
    const customDateFrom = document.getElementById('customDateFrom');
    const customDateTo = document.getElementById('customDateTo');
    const searchInput = document.getElementById('visitSearchInput');

    // Pagination controls
    const pageSizeSelect = document.getElementById('pageSizeSelect');
    const paginationButtons = document.getElementById('paginationButtons');
    const paginationInfo = document.getElementById('paginationInfo');

    // Status filter
    let statusFilter = 'all';

    // Pagination state
    let currentPage = 1;
    let pageSize = pageSizeSelect
        ? (parseInt(pageSizeSelect.value, 10) || 10)
        : 10;

    // Store the currently filtered cards
    let filteredCards = [];

    // =========================================================
    // ACTIVE TAB
    // =========================================================

    function setActiveTab(tab) {
        [tabAll, tabProceed, tabAttended].forEach(element => {
            if (element) element.classList.remove('navTabActive');
        });

        if (tab === 'all' && tabAll) {
            tabAll.classList.add('navTabActive');
        } else if (tab === 'proceed' && tabProceed) {
            tabProceed.classList.add('navTabActive');
        } else if (tab === 'attended' && tabAttended) {
            tabAttended.classList.add('navTabActive');
        }
    }

    setActiveTab('all');

    // =========================================================
    // RESET PAGE WHEN FILTERS OR SEARCH CHANGE
    // =========================================================

    function resetPageAndApplyFilters() {
        currentPage = 1;
        applyFilters();
    }

    // =========================================================
    // STATUS TABS
    // =========================================================

    if (tabProceed) {
        tabProceed.addEventListener('click', () => {
            statusFilter = statusFilter === 'proceed' ? 'all' : 'proceed';

            setActiveTab(statusFilter);
            resetPageAndApplyFilters();
        });
    }

    if (tabAttended) {
        tabAttended.addEventListener('click', () => {
            statusFilter = statusFilter === 'attended' ? 'all' : 'attended';

            setActiveTab(statusFilter);
            resetPageAndApplyFilters();
        });
    }

    if (tabAll) {
        tabAll.addEventListener('click', () => {
            statusFilter = 'all';
            setActiveTab('all');
            resetPageAndApplyFilters();
        });
    }

    // =========================================================
    // DATE HELPERS
    // =========================================================

    function startOfDay(date) {
        const result = new Date(date);
        result.setHours(0, 0, 0, 0);
        return result;
    }

    function endOfDay(date) {
        const result = new Date(date);
        result.setHours(23, 59, 59, 999);
        return result;
    }

    function startOfWeek(date) {
        const result = startOfDay(date);
        result.setDate(result.getDate() - result.getDay());
        return result;
    }

    function endOfWeek(date) {
        const result = startOfWeek(date);
        result.setDate(result.getDate() + 6);
        return endOfDay(result);
    }

    // =========================================================
    // PRESET DATE RANGE
    // =========================================================

    function getDateRange(filterValue) {
        const now = new Date();

        switch (filterValue) {
            case 'today':
                return [
                    startOfDay(now).getTime(),
                    endOfDay(now).getTime()
                ];

            case 'yesterday': {
                const yesterday = new Date(now);
                yesterday.setDate(yesterday.getDate() - 1);

                return [
                    startOfDay(yesterday).getTime(),
                    endOfDay(yesterday).getTime()
                ];
            }

            case 'thisWeek':
                return [
                    startOfWeek(now).getTime(),
                    endOfWeek(now).getTime()
                ];

            case 'lastWeek': {
                const lastWeek = new Date(now);
                lastWeek.setDate(lastWeek.getDate() - 7);

                return [
                    startOfWeek(lastWeek).getTime(),
                    endOfWeek(lastWeek).getTime()
                ];
            }

            case 'thisMonth': {
                const start = new Date(now.getFullYear(), now.getMonth(), 1);
                const end = new Date(now.getFullYear(), now.getMonth() + 1, 0);

                return [
                    startOfDay(start).getTime(),
                    endOfDay(end).getTime()
                ];
            }

            case 'lastMonth': {
                const start = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                const end = new Date(now.getFullYear(), now.getMonth(), 0);

                return [
                    startOfDay(start).getTime(),
                    endOfDay(end).getTime()
                ];
            }

            case 'thisYear': {
                const start = new Date(now.getFullYear(), 0, 1);
                const end = new Date(now.getFullYear(), 11, 31);

                return [
                    startOfDay(start).getTime(),
                    endOfDay(end).getTime()
                ];
            }

            case 'lastYear': {
                const start = new Date(now.getFullYear() - 1, 0, 1);
                const end = new Date(now.getFullYear() - 1, 11, 31);

                return [
                    startOfDay(start).getTime(),
                    endOfDay(end).getTime()
                ];
            }

            case 'custom':
                return getCustomDateRange();

            default:
                return null;
        }
    }

    // =========================================================
    // CUSTOM DATE RANGE
    // =========================================================

    function getCustomDateRange() {
        const fromValue = customDateFrom.value;
        const toValue = customDateTo.value;

        if (!fromValue || !toValue) {
            return null;
        }

        const fromParts = fromValue.split('-');
        const toParts = toValue.split('-');

        const fromDate = new Date(
            Number(fromParts[0]),
            Number(fromParts[1]) - 1,
            Number(fromParts[2])
        );

        const toDate = new Date(
            Number(toParts[0]),
            Number(toParts[1]) - 1,
            Number(toParts[2])
        );

        fromDate.setHours(0, 0, 0, 0);
        toDate.setHours(23, 59, 59, 999);

        if (fromDate.getTime() > toDate.getTime()) {
            return 'invalid';
        }

        return [fromDate.getTime(), toDate.getTime()];
    }

    // =========================================================
    // DATE FILTER EVENTS
    // =========================================================

    if (dateFilterSelect) {
        dateFilterSelect.addEventListener('change', function () {
            if (this.value === 'custom') {
                customDateRange.classList.remove('hidden');
            } else {
                customDateRange.classList.add('hidden');

                customDateFrom.value = '';
                customDateTo.value = '';

                customDateFrom.removeAttribute('max');
                customDateTo.removeAttribute('min');
            }

            resetPageAndApplyFilters();
        });
    }

    if (customDateFrom) {
        customDateFrom.addEventListener('change', function () {
            if (this.value) {
                customDateTo.min = this.value;
            } else {
                customDateTo.removeAttribute('min');
            }

            resetPageAndApplyFilters();
        });
    }

    if (customDateTo) {
        customDateTo.addEventListener('change', function () {
            if (this.value) {
                customDateFrom.max = this.value;
            } else {
                customDateFrom.removeAttribute('max');
            }

            resetPageAndApplyFilters();
        });
    }

    // =========================================================
    // SEARCH EVENT
    // =========================================================

    if (searchInput) {
        searchInput.addEventListener('input', resetPageAndApplyFilters);
    }

    // =========================================================
    // PAGE SIZE EVENT
    // =========================================================

    if (pageSizeSelect) {
        pageSizeSelect.addEventListener('change', function () {
            pageSize = parseInt(this.value, 10) || 10;
            currentPage = 1;
            applyFilters();
        });
    }

    // =========================================================
    // RENDER PAGINATION
    // =========================================================

    function renderPagination(totalItems) {
        if (!paginationButtons || !paginationInfo) return;

        paginationButtons.innerHTML = '';

        if (totalItems === 0) {
            paginationInfo.textContent = 'Showing 0–0 of 0 visits';
            return;
        }

        const totalPages = Math.ceil(totalItems / pageSize);

        currentPage = Math.min(
            Math.max(currentPage, 1),
            totalPages
        );

        const firstItem = (currentPage - 1) * pageSize + 1;
        const lastItem = Math.min(currentPage * pageSize, totalItems);

        paginationInfo.textContent =
            `Showing ${firstItem}–${lastItem} of ${totalItems} visits`;

        function addButton(label, page, disabled, active = false) {
            const button = document.createElement('button');

            button.type = 'button';
            button.textContent = label;
            button.disabled = disabled;

            if (active) button.classList.add('active');

            button.addEventListener('click', () => {
                currentPage = page;
                applyFilters();
            });

            paginationButtons.appendChild(button);
        }

        addButton('‹', currentPage - 1, currentPage === 1);

        // Keep page buttons compact for many pages
        let pages = [];

        if (totalPages <= 7) {
            pages = Array.from(
                { length: totalPages },
                (_, index) => index + 1
            );
        } else {
            pages = [...new Set([
                1,
                currentPage - 1,
                currentPage,
                currentPage + 1,
                totalPages
            ])]
                .filter(page => page >= 1 && page <= totalPages)
                .sort((a, b) => a - b);
        }

        let previousPage = 0;

        pages.forEach(page => {
            if (previousPage && page - previousPage > 1) {
                const dots = document.createElement('span');
                dots.textContent = '…';
                dots.style.padding = '0 4px';
                paginationButtons.appendChild(dots);
            }

            addButton(
                String(page),
                page,
                false,
                page === currentPage
            );

            previousPage = page;
        });

        addButton(
            '›',
            currentPage + 1,
            currentPage === totalPages
        );
    }

    // =========================================================
    // APPLY SEARCH + FILTERS + PAGINATION
    // =========================================================

    function applyFilters() {
        const dateRange = getDateRange(dateFilterSelect.value);
        const searchTerm = searchInput.value.trim().toLowerCase();

        // Invalid custom range
        if (dateRange === 'invalid') {
            cards.forEach(card => card.classList.add('hidden'));

            noResultsMsg.textContent =
                'Invalid date range. Please check the selected dates.';

            noResultsMsg.classList.remove('hidden');
            renderPagination(0);
            return;
        }

        // Require both custom dates
        if (
            dateFilterSelect.value === 'custom' &&
            (!customDateFrom.value || !customDateTo.value)
        ) {
            cards.forEach(card => card.classList.add('hidden'));

            noResultsMsg.textContent =
                'Please select both From Date and To Date.';

            noResultsMsg.classList.remove('hidden');
            renderPagination(0);
            return;
        }

        // Filter every card first, not just the current page
        filteredCards = cards.filter(card => {
            const cardStatus = (card.dataset.status || '').toLowerCase();
            const cardDate = parseInt(card.dataset.date, 10) || 0;
            const cardSearchText = (card.dataset.search || '').toLowerCase();

            let matchesStatus = true;

            if (statusFilter === 'proceed') {
                matchesStatus = cardStatus === 'proceed';
            } else if (statusFilter === 'attended') {
                matchesStatus = cardStatus === 'attended';
            }

            let matchesDate = true;

            if (dateRange) {
                matchesDate =
                    cardDate >= dateRange[0] &&
                    cardDate <= dateRange[1];
            }

            const matchesSearch = cardSearchText.includes(searchTerm);

            return matchesStatus && matchesDate && matchesSearch;
        });

        // If no results, hide all cards and show message
        if (filteredCards.length === 0) {
            cards.forEach(card => card.classList.add('hidden'));

            if (dateFilterSelect.value === 'custom') {
                noResultsMsg.textContent =
                    'No visits found within the selected date range.';
            } else {
                noResultsMsg.textContent = 'No matching visits found.';
            }

            noResultsMsg.classList.remove('hidden');
            renderPagination(0);
            return;
        }

        noResultsMsg.classList.add('hidden');

        const totalPages = Math.ceil(filteredCards.length / pageSize);

        if (currentPage > totalPages) {
            currentPage = totalPages;
        }

        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = startIndex + pageSize;
        const currentPageCards = new Set(
            filteredCards.slice(startIndex, endIndex)
        );

        // Only show matching cards on the current page
        cards.forEach(card => {
            card.classList.toggle('hidden', !currentPageCards.has(card));
        });

        renderPagination(filteredCards.length);
    }

    // Initial display
    applyFilters();
})();
</script>
