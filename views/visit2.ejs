<% layout('layout') %>

<div class="height10 justifyBetween">
    <div class="width0">
        <p class="size40 str400">Visitation Record</p>
    </div>
        <div class="width0 gap8 ">
        <a href="/nv" class="nav pnav w108"> <i class="fas fa-plus"></i>New Visit</a>
        |
        <a href="/va" class="nav w100">Archive</a>
    </div>
</div>
<div class="height90 col justifyStart">
    <div class="height10 justifyBetween ">
        <div class="width0 gap5">
        <a href="" class="nav ">Pending</a>
        <a href="" class="nav ">Attended</a>
            <div class="selectBar w190"><i class="fas fa-filter"></i><select name="" id="">
                <option value=""></i> Filter By</option>
            </select></div>
        </div>
        <div class="width0 gap8 ">
            <div class="searchBar w220"><i class="fas fa-search"></i><input type="search" name="" id=""></div>
        </div>
    </div>

    <section class="height90 bgGray200 corner12 col gap2 block overflow-y1 relative hidden">
        <a href="" class="height0 width100 corner12 shadow1 padding15 bgWhite col alignStart relative colorPrimary gap0">
                <p class="size14 absolute right15 top15">August 20, 2025</p>
                <p class="size18 str500">Arenvie Pascual <span class="size12 border0 bgGreen100">Pending</span></p>
                <p class="size14">01-2223-037426</p>
                <p class="size14">4th Year &bull; Bachelor of Science in Information Technology</p>
                <p class="size14">arbo.pascual.au@phinmaed.com</p>
                <p class="size14 str500">Complaint: <span class="sizeInherit str500" style="color: rgb(6, 74, 210);">Headache</span></p>
                <p class="size14 str500">Medicines: <span class="sizeInherit str500" style="color: rgb(6, 74, 210);">Paracetamol</span></p>
                <div class="area0 absolute bottom15 right15 width0 height0 gap10">
                
                </div>
        </a>
    </section>
    <section class="height90 bgGray200 corner12 col gap10 block overflow-y1">
        <% if (allVisits && allVisits.length > 0) { %>

            <% if (allVisits.length > 0) { %>
                <% allVisits.forEach(request => { %>
                    <a href="/vv2/<%= request._id %>" class="height0 corner12 padding20 bgWhite col alignStart relative colorPrimary width100 hoverShadow1 marginBottom10">
                        
                        <p class="size14 absolute right15 top15">
                            <%= request.createdAt ? new Date(request.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'No Date' %>
                        </p>

                        <p class="size18 str500">
                            <%= request.patient.fName %> <%= request.patient.lName %> 
                            <span class="size12 border0 bgGreen100" style="padding: 2px 8px; border-radius: 4px; margin-left: 10px;">
                                <%= request.status %>
                            </span>
                        </p>

                        <p class="size14"><%= request.patient.schoolId %></p>
                        <p class="size14">
                            <%= request.patient.yearLevel %> &bull; <%= request.patient.course %>
                        </p>

                        <p class="size14 str500" style="margin-top: 10px;">Complaint: 
                            <span class="sizeInherit str500" style="color: rgb(6, 74, 210);">
                                <%= request.complaints && request.complaints.length > 0 
                                    ? request.complaints.map(c => c.type).join(', ') 
                                    : request.complaint %> </span>
                        </p>

                        <p class="size14 str500" style="margin-top: 10px;">Concern: 
                            <span class="sizeInherit str500" style="color: rgb(6, 74, 210);"><%= request.concern %></span>
                        </p>
                        <% if (request.dispensed && request.dispensed.length > 0) { %>
                            <p class="size14 str500">Medicines: 
                                <span class="sizeInherit str500" style="color: rgb(6, 74, 210);">
                                    <%= request.dispensed.map(d => `${d.item} (${d.qty} ${d.unit})`).join(', ') %>
                                </span>
                            </p>
                        <% } %>
                        </a>
                <% }) %>
            <% } else { %>
                <div class="padding20 textCenter size16 colorPrimary">No Pending requests at the moment.</div>
            <% } %>

        <% } else { %>
            <div class="padding20 textCenter size16 colorPrimary">No requests found.</div>
        <% } %>
    </section>
</div>


