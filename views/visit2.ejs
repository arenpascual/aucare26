<% layout('layout') %>

<style>
    
/* ============================================================
   VISIT PAGINATION
   ============================================================ */

#visitsPagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

#paginationButtons button {
    min-width: 36px;
    min-height: 36px;
    padding: 6px 10px;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    background: #ffffff;
    color: #1b5f99;
    cursor: pointer;
    font: inherit;
}

#paginationButtons button.active {
    background: #1b5f99;
    color: #ffffff;
    border-color: #1b5f99;
}

#paginationButtons button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
}

#paginationButtons button:hover:not(:disabled):not(.active) {
    background: #edf5fc;
}

@media (max-width: 600px) {
    #visitsPagination {
        justify-content: center;
    }

    #paginationInfo {
        width: 100%;
        text-align: center;
    }
}



.ts-wrapper{
    width:100%;
}

.ts-control{
    min-height:45px;
    height:auto !important;
}

.ts-dropdown{
    height:auto !important;
    max-height:220px;
    overflow-y:auto;
}

.ts-dropdown-content{
    height:auto !important;
}

.ts-control input{
    height:auto !important;
}

.ts-wrapper div,
.ts-wrapper span{
    height:auto !important;
}

.navTabActive{
    background: #1b5f99;
    color: #ffffff !important;
    padding-inline: 20px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    transition: all 0.15s ease;
}

.tabN {
    border-bottom: none !important;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

/* ============================================================
   CUSTOM DATE RANGE
   ============================================================ */

.customDateRange{
    align-items:center;
}

.customDateRange .field{
    margin:0;
}

.customDateRange input[type="date"]{
    height:45px;
    padding:0 10px;
    border:1px solid #d0d0d0;
    border-radius:8px;
    background:#ffffff;
    font-family:inherit;
    font-size:14px;
    outline:none;
}

.customDateRange input[type="date"]:focus{
    border-color:#1b5f99;
}
</style>


<div class="height10 justifyBetween">

    <div class="width0">
        <p class="size40 str400">Visitation Record</p>
    </div>

    <div class="width0 gap8">

        <a href="javascript:void(0)"
           class="nav pnav w108"
           id="openConsultForm">
            <i class="fas fa-plus"></i>New Visit
        </a>

        <div class="width0 gap8">
            <a href="/va" class="nav w100">
                Archive
            </a>
        </div>

    </div>

</div>


<div class="height90 col justifyStart">

    <div class="height10 justifyBetween">

        <div class="width0 gap5">

            <a href="javascript:void(0)"
               class="nav tabN"
               id="tabAll">
                All Records
            </a>

            <a href="javascript:void(0)"
               class="nav tabN"
               id="tabProceed">
                Proceed
            </a>

            <a href="javascript:void(0)"
               class="nav tabN"
               id="tabAttended">
                Attended
            </a>


            <!-- =================================================
                 DATE FILTER
            ================================================== -->

            <div class="selectBar w190">
                <i class="fas fa-filter"></i>

                <select name="" id="dateFilterSelect">

                    <option value="">
                        Filter By Date
                    </option>

                    <option value="today">
                        Today
                    </option>

                    <option value="yesterday">
                        Yesterday
                    </option>

                    <option value="thisWeek">
                        This Week
                    </option>

                    <option value="lastWeek">
                        Last Week
                    </option>

                    <option value="thisMonth">
                        This Month
                    </option>

                    <option value="lastMonth">
                        Last Month
                    </option>

                    <option value="thisYear">
                        This Year
                    </option>

                    <option value="lastYear">
                        Last Year
                    </option>

                    <option value="custom">
                        Custom Range
                    </option>

                </select>

            </div>


            <!-- =================================================
                 CUSTOM DATE RANGE
            ================================================== -->

            <div
                id="customDateRange"
                class="width0 gap5 customDateRange hidden"
            >

                <div class="field">

                    <input
                        type="date"
                        id="customDateFrom"
                        title="From Date"
                    >

                </div>

                <span class="size14 w40 textCenter">
                    to
                </span>

                <div class="field " style="padding-left: 10px;">

                    <input
                        type="date"
                        id="customDateTo"
                        title="To Date"
                    >

                </div>

            </div>


            <!-- =================================================
                 STATUS FILTER
                 EXISTING / HIDDEN
            ================================================== -->

            <div class="selectBar w190 hidden">

                <i class="fas fa-filter"></i>

                <select name="" id="">

                    <option value="">
                        Filter By Status
                    </option>

                    <option value="">
                        Proceed
                    </option>

                    <option value="">
                        Attended
                    </option>

                </select>

            </div>

        </div>


        <!-- =====================================================
             SEARCH
        ====================================================== -->

        <div class="width0 gap8">

            <div class="searchBar w220">

                <i class="fas fa-search"></i>

                <input
                    type="search"
                    name=""
                    id="visitSearchInput"
                    placeholder="Search patient..."
                >

            </div>

        </div>

    </div>


    <!-- =========================================================
         VISIT CONTAINER
    ========================================================== -->

    <section
        class="height90 bgGray200 corner12 col gap10 block overflow-y1"
        id="visitsContainer"
    >

        <% if (allVisits && allVisits.length > 0) { %>

            <% if (allVisits.length > 0) { %>

                <% allVisits.forEach(request => { %>

                    <a
                        href="/vv2/<%= request._id %>"
                        class="visitCard height0 corner12 padding20 bgWhite col alignStart relative colorPrimary width100 hoverShadow1 marginBottom10"

                        data-status="<%= request.status %>"

                        data-date="<%= request.createdAt ? new Date(request.createdAt).getTime() : 0 %>"

                        data-search="<%= (
                            (request.patient.fName || '') + ' ' +
                            (request.patient.lName || '') + ' ' +
                            (request.patient.email || '') + ' ' +
                            (request.patient.schoolId || '')
                        ).toLowerCase() %>"
                    >

                        <p class="size14 absolute right15 top15">

                            <%= request.createdAt
                                ? new Date(request.createdAt).toLocaleDateString(
                                    'en-US',
                                    {
                                        month: 'long',
                                        day: 'numeric',
                                        year: 'numeric'
                                    }
                                )
                                : 'No Date'
                            %>

                        </p>


                        <p class="size18 str500">

                            <%= request.patient.fName %>
                            <%= request.patient.lName %>

                            <span
                                class="size12 border0
                                <% if (request.status === 'Attended') { %>
                                    bgBlue100
                                <% } else { %>
                                    bgGreen100
                                <% } %>
                                "
                                style="
                                    padding: 2px 8px;
                                    border-radius: 4px;
                                    margin-left: 10px;
                                "
                            >

                                <%= request.status %>

                            </span>

                        </p>


                        <p class="size14">

                            <%= request.patient.email %>

                        </p>


                        <p class="size14">

                            <%= request.patient.schoolId %>
                            &bull;
                            <%= request.patient.campus %>

                        </p>


                        <p class="size14">

                            <%= request.patient.yearLevel %>
                            &bull;
                            <%= request.patient.course %>

                        </p>


                        <p
                            class="size14 str500"
                            style="margin-top: 10px;"
                        >

                            Complaint:

                            <span
                                class="sizeInherit str500"
                                style="color: rgb(6, 74, 210);"
                            >

                                <%= request.complaints &&
                                    request.complaints.length > 0

                                    ? request.complaints
                                        .map(c => c.type)
                                        .join(', ')

                                    : request.complaint
                                %>

                            </span>

                        </p>


                        <p
                            class="size14 str500"
                            style="margin-top: 10px;"
                        >

                            Concern:

                            <span
                                class="sizeInherit str500"
                                style="color: rgb(6, 74, 210);"
                            >

                                <%= request.concern %>

                            </span>

                        </p>


                        <% if (
                            request.dispensed &&
                            request.dispensed.length > 0
                        ) { %>

                            <p class="size14 str500">

                                Medicines:

                                <span
                                    class="sizeInherit str500"
                                    style="color: rgb(6, 74, 210);"
                                >

                                    <%= request.dispensed
                                        .map(d =>
                                            `${d.item} (${d.qty} ${d.unit})`
                                        )
                                        .join(', ')
                                    %>

                                </span>

                            </p>

                        <% } %>


                    </a>

                <% }) %>

            <% } else { %>

                <div
                    class="padding20 textCenter size16 colorPrimary"
                >
                    No Pending requests at the moment.
                </div>

            <% } %>

        <% } else { %>

            <div
                class="padding20 textCenter size16 colorPrimary"
            >
                No requests found.
            </div>

        <% } %>


        <!-- =====================================================
             NO RESULTS
        ====================================================== -->

        <div
            class="padding20 textCenter size16 colorPrimary hidden"
            id="noResultsMsg"
        >
            No matching visits found.
        </div>

 
    </section>

    <!-- PAGINATION CONTROLS -->
    <div id="visitsPagination"
         class="width100 justifyBetween alignCenter gap10 height10"
         style="padding: 12px 0;">

        <p id="paginationInfo" class="size14">
            Showing 0–0 of 0 visits
        </p>

        <div class="width0 gap8 alignCenter" style="min-width: fit-content !important;">
            <label for="pageSizeSelect" class="size14">
                Per page:
            </label>

            <select id="pageSizeSelect"
                    style="padding: 8px; border: 1px solid #ccc; border-radius: 6px; width: 100px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>

        <div id="paginationButtons"
             class="width0 gap5 alignCenter"
             style="flex-wrap: wrap;">
        </div>
    </div>

</div>



<!-- =============================================================
     NEW VISIT FORM
============================================================== -->

<form
    action="/visitnow2"
    method="POST"
    class="absolute translateCenter shadow3 width36 padding30 gap10 index500 height0 hidden"
    id="Consultationform"
>

    <p class="size24">
        New Visit Form:
    </p>


    <!-- =========================================================
         PATIENT
    ========================================================== -->

    <div class="field">

        <label>
            Patient
        </label>

        <input
            type="text"
            id="patientSearch"
            placeholder="Search patient..."
            autocomplete="off"
        >


        <select
            id="patientList"
            name="patient"
            size="10"
            style="
                display:none;
                margin-top:5px;
                overflow-y:auto !important;
            "
        >

            <% allUsers.forEach(user => { %>

                <option
                    value="<%= user._id %>"
                    data-name="<%= (
                        user.fName +
                        ' ' +
                        user.mName +
                        ' ' +
                        user.lName +
                        ' ' +
                        user.xName
                    ).toLowerCase() %>"
                >

                    <%= user.fName %>
                    <%= user.mName %>
                    <%= user.lName %>
                    <%= user.xName %>

                </option>

            <% }) %>

        </select>

    </div>


    <!-- =========================================================
         CONCERN
    ========================================================== -->

    <div class="field">

        <label for="">
            Concern
        </label>

        <div class="selectBar">

            <select
                name="concern"
                id="concernSelect"
                required
            >

                <option
                    value=""
                    title=""
                    disabled
                    selected
                >
                    Select Concern
                </option>

                <option
                    value="Rest/Observation"
                    title="if you need to use a clinic bed or require a quiet space to rest."
                >
                    Rest/Observation
                </option>

                <option
                    value="Health Concern / Request Medicines"
                    title="if you are seeking specific medication or basic first aid."
                >
                    Health Concern / Request Medicines
                </option>

                <option
                    value="Health Consultation"
                    title="if you need to speak directly with a health professional for advice."
                >
                    Health Consultation
                </option>

            </select>

        </div>

    </div>


    <!-- =========================================================
         MEDICINE
    ========================================================== -->

    <section
        class="gap10 hidden"
        id="medicineField"
    >

        <div class="field">

            <label for="itemSelect">

                Type of Medicines

                <span class="gray inherit">
                    ( Optional )
                </span>

            </label>


            <div class="selectBar">

                <select
                    name="item"
                    id="itemSelect"
                >

                    <option
                        value=""
                        selected
                    >
                        --Select--
                    </option>


                    <%
                        const availableMedicines =
                            (
                                typeof medicines !== 'undefined'
                                ? medicines
                                : []
                            )
                            .filter(m => m.remaining > 0);
                    %>


                    <% if (availableMedicines.length === 0) { %>

                        <option
                            value=""
