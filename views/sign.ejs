<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Registration</title>
</head>
<body class="polaroid">
    <a href="/h" class="hidden">home</a>

    <div class="left width60 col">
        <div class="top relative">
            <i class="fas fa-stethoscope absolute opacity2  top40 size90 h160 w160 padding20 corner500 porcelain" style="left: 120px;"></i>
            <div class="height0 width0 index50">
                <img src="/images/logo.png" alt="" class="corner500 h140">
            </div>
            <div class="col width0 alignStart colorPrimary index50">
                <p class="size90 str500">AuCare</p>
                <p class="size30 textWrap" style="margin-top:-25px !important;">PHINMA Araullo University South Campus</p>
            </div>
        </div>
        <div class="bottom justifyStart paddingInline75 paddingBottom70">
            <section class=" width60 h300 corner15 padding20 bgWhite col alignStart gap15">
                <p class="size18 str500 marginLeft10">Need Help? <a href="" class="inline sizeInherit underline">Learn More </a></p>
                <video class="abstractBG2 width100 height100 corner15" src="/image/video.mp4"></video>
            </section>
        </div>
    </div>
    <div class="right width40 col alignEnd">
        <div class="up height0 padding20 block overflow-y1 width75">
            <form class="bgWhite shadow1 height0 gap10 padding30 width100 justifyStart" action="">
                <p class="size20 str500">Sign Up</p>
                <div class="field">
                    <label for="">Role</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">First Name</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Middle Name</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Last Name</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Extension Name</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Email</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">School ID</label>
                    <input type="text"></div>
                <div class="field">
                    <label for="">Contact Number</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Address</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Birthday</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Gender</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Year Level</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Course</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Section</label>
                    <input type="text">
                </div>
                <div class="field">
                    <label for="">Department</label>
                    <input type="text">
                </div>
                <div class="field ">
                    <label for="">Any Allergies to Medicines?</label>
                    <div class="selectBar">
                        <select name="" id="">
                            <option value="" selected disabled>--Select--</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                </div>
                <div class="field ">
                    <label for="">Any Food Allergies?</label>
                    <div class="selectBar">
                        <select name="" id="">
                            <option value="" selected disabled>--Select--</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                </div>
                <div class="justifyEnd height0">
                    <button class="nav pnav ">Submit</button>
                </div>
            </form>
        </div>
        
    </div>
</body>
</html>