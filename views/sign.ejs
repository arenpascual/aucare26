<script>
(function(){
    const step1 = document.getElementById('step-1');
    const step2 = document.getElementById('step-2');
    const step3 = document.getElementById('step-3');
    const bDayInput = document.getElementById('bDay');
    const phoneInput = document.getElementById('phoneInput');
    const ePhoneInput = document.getElementById('ePhoneInput');
    const dobError = document.getElementById('dobError');

    // ---- Live clamp: digits only, cap length (phone numbers) ----
    function digitsOnlyLive(input, maxLen){
        if (!input) return;
        input.addEventListener('input', () => {
            let raw = input.value.replace(/[^0-9]/g, '');
            if (raw.length > maxLen) raw = raw.slice(0, maxLen);
            input.value = raw;
        });
    }

    // ---- Live clamp: letters, spaces + extra allowed chars (names) ----
    function lettersOnlyLive(input, extraAllowedChars){
        if (!input) return;
        const allowed = new RegExp(`[^A-Za-z\\s${extraAllowedChars || ''}]`, 'g');
        input.addEventListener('input', () => {
            const start = input.selectionStart;
            const before = input.value;
            const cleaned = before.replace(allowed, '');
            if (cleaned !== before) {
                input.value = cleaned;
                const diff = before.length - cleaned.length;
                const pos = Math.max(0, (start || 0) - diff);
                input.setSelectionRange(pos, pos);
            }
        });
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            const text = (e.clipboardData || window.clipboardData).getData('text');
            const cleanedText = text.replace(allowed, '');
            const startPos = input.selectionStart;
            const endPos = input.selectionEnd;
            input.value = input.value.slice(0, startPos) + cleanedText + input.value.slice(endPos);
            const pos = startPos + cleanedText.length;
            input.setSelectionRange(pos, pos);
        });
    }

    // ---- Live clamp: letters, numbers, accented letters + extra chars (address) ----
    function alphaNumericLive(input, extraAllowedChars){
        if (!input) return;
        const allowed = new RegExp(`[^A-Za-z0-9À-ÿ\\s${extraAllowedChars || ''}]`, 'g');
        input.addEventListener('input', () => {
            const start = input.selectionStart;
            const before = input.value;
            const cleaned = before.replace(allowed, '');
            if (cleaned !== before) {
                input.value = cleaned;
                const diff = before.length - cleaned.length;
                const pos = Math.max(0, (start || 0) - diff);
                input.setSelectionRange(pos, pos);
            }
        });
    }

    digitsOnlyLive(phoneInput, 11);
    digitsOnlyLive(ePhoneInput, 11);

    // Names
    lettersOnlyLive(document.getElementById('fName'), '\\-\'');
    lettersOnlyLive(document.getElementById('mName'), '\\-\'');
    lettersOnlyLive(document.getElementById('lName'), '\\-\'');
    lettersOnlyLive(document.getElementById('eName'), '\\-\'');
    lettersOnlyLive(document.getElementById('xName'), '.');

    // Address fields (street, barangay, city, province, emergency address)
    ['addrStreet', 'addrBarangay'].forEach(id => {
        alphaNumericLive(document.getElementById(id), '\\-.,#\'\\/');
    });
    ['addrCity', 'addrProvince'].forEach(id => {
        alphaNumericLive(document.getElementById(id), '\\-.,\'\\/');
    });
    alphaNumericLive(document.getElementById('eAddress'), '\\-.,#\'\\/');

    // ============================================================
    // ROLE-BASED FIELD TOGGLING + SCHOOL ID FORMAT
    // ============================================================
    const roleSelect = document.getElementById('roleSelect');
    const yearLevelField = document.getElementById('yearLevelField');
    const courseField = document.getElementById('courseField');
    const yearLevelSelect = document.getElementById('yearLevel');
    const courseSelect = document.getElementById('course');

    const departmentField = document.getElementById('departmentField');
    const departmentSelect = document.getElementById('department');
    const deptOthersOption = document.getElementById('deptOthersOption');

    const schoolIdLabel = document.getElementById('schoolIdLabel');
    const schoolIdInput = document.getElementById('schoolId');

    function applyRoleVisibility() {
        if (!roleSelect) return;

        const role = roleSelect.value;
        const isStudent = role === 'Student';
        const isFaculty = role === 'Faculty';
        const isStaff = role === 'Staff';
        const needsDepartment = isFaculty || isStaff;

        // Student-only fields
        if (yearLevelField) yearLevelField.style.display = isStudent ? '' : 'none';
        if (courseField) courseField.style.display = isStudent ? '' : 'none';

        if (yearLevelSelect) {
            yearLevelSelect.required = isStudent;
            if (!isStudent) yearLevelSelect.value = '';
        }
        if (courseSelect) {
            courseSelect.required = isStudent;
            if (!isStudent) courseSelect.value = '';
        }

        // Department (Faculty / Staff)
        if (departmentField) departmentField.style.display = needsDepartment ? '' : 'none';
        if (departmentSelect) {
            departmentSelect.required = needsDepartment;
            if (!needsDepartment) departmentSelect.value = '';
        }

        // "Others" ay para sa Staff lang
        if (deptOthersOption) {
            deptOthersOption.hidden = !isStaff;
            deptOthersOption.disabled = !isStaff;
            if (!isStaff && departmentSelect && departmentSelect.value === 'Others') {
                departmentSelect.value = '';
            }
        }

        // School ID format based on role
        if (isStudent) {
            schoolIdLabel.textContent = 'School ID';
            schoolIdInput.placeholder = '01-2223-037126';
            schoolIdInput.maxLength = 14;
            schoolIdInput.inputMode = 'numeric';
            schoolIdInput.pattern = '^\\d{2}-\\d{4}-\\d{6}$';
            schoolIdInput.title = 'Student School ID must follow the format 01-2223-037126';
        } else if (isFaculty) {
            schoolIdLabel.textContent = 'Employee ID';
            schoolIdInput.placeholder = 'AU2026-073123';
            schoolIdInput.maxLength = 13;
            schoolIdInput.inputMode = 'text';
            schoolIdInput.pattern = '^AU\\d{4}-\\d{6}$';
            schoolIdInput.title = 'Faculty Employee ID must follow the format AU2026-073123';
        } else {
            schoolIdLabel.textContent = 'Employee ID';
            schoolIdInput.placeholder = 'AU2026-073123';
            schoolIdInput.maxLength = 13;
            schoolIdInput.inputMode = 'text';
            schoolIdInput.pattern = '^AU\\d{4}-\\d{6}$';
            schoolIdInput.title = 'Staff Employee ID must follow the format AU2026-073123';
        }

        // Clear old value when switching roles
        schoolIdInput.value = '';
        schoolIdInput.setCustomValidity('');
    }

    // Student School ID format: 01-2223-037126
    function formatStudentSchoolId(value) {
        let digits = value.replace(/\D/g, '').slice(0, 12);
        if (digits.length > 6) {
            return digits.slice(0, 2) + '-' + digits.slice(2, 6) + '-' + digits.slice(6);
        } else if (digits.length > 2) {
            return digits.slice(0, 2) + '-' + digits.slice(2);
        }
        return digits;
    }

    // Live School ID formatting
    schoolIdInput.addEventListener('input', function () {
        const role = roleSelect.value;

        if (role === 'Student') {
            this.value = formatStudentSchoolId(this.value);
        } else if (role === 'Faculty' || role === 'Staff') {
            // Manual typing, uppercase lang
            this.value = this.value.toUpperCase();
        }

        this.setCustomValidity('');
    });

    if (roleSelect) {
        roleSelect.addEventListener('change', applyRoleVisibility);
        applyRoleVisibility();
    }

    // Day: digits only, max 31
    bDayInput.addEventListener('input', () => {
        let raw = bDayInput.value.replace(/[^0-9]/g, '');
        if (raw.length > 2) raw = raw.slice(0, 2);
        if (raw !== '' && Number(raw) > 31) raw = '31';
        bDayInput.value = raw;
    });

    // ============================================================
    // VALIDATION
    // ============================================================

    function showStep(section){
        [step1, step2, step3].forEach(s => s.classList.toggle('active', s === section));
    }

    // Validate all fields inside a section.
    // Tinitingnan ang sariling field (hindi ang section) kung nakatago,
    // kaya gumagana kahit hindi pa active ang section.
    function validateSection(section){
        const inputs = section.querySelectorAll('input, select');
        for (const input of inputs) {
            if (input.type === 'hidden') continue;

            // Laktawan ang field na tinago ng role-based toggling
            const field = input.closest('.field');
            if (field && field.style.display === 'none') continue;

            // Huwag payagan ang puro spaces sa required text fields
            if (input.type === 'text' && input.required && input.value.trim() === '') {
                input.setCustomValidity('Please fill out this field.');
            } else {
                input.setCustomValidity('');
            }

            if (!input.checkValidity()) {
                input.reportValidity();
                input.focus();
                return false;
            }
        }
        return true;
    }

    // Check kung tama ang araw para sa buwan/taon (e.g. walang Feb 30)
    function validateDob(){
        const month = Number(document.getElementById('bMonth').value);
        const day = Number(bDayInput.value);
        const year = Number(document.getElementById('bYear').value);

        dobError.style.display = 'none';
        dobError.textContent = '';

        if (!month || !day || !year) return true;

        const daysInMonth = new Date(year, month, 0).getDate();
        if (day < 1 || day > daysInMonth) {
            dobError.textContent = `That month only has ${daysInMonth} days.`;
            dobError.style.display = 'block';
            bDayInput.focus();
            return false;
        }
        return true;
    }

    // Buuin ang kumpletong address para sa hidden "address" field
    function buildFullAddress() {
        const parts = ['addrStreet', 'addrBarangay', 'addrCity', 'addrProvince']
            .map(id => document.getElementById(id).value.trim().replace(/\s+/g, ' '))
            .filter(Boolean);
        document.getElementById('address').value = parts.join(', ');
    }

    // ============================================================
    // STEP NAVIGATION
    // ============================================================
    document.getElementById('next1').onclick = () => {
        if (!validateSection(step1)) return;
        if (!validateDob()) return;
        showStep(step2);
    };
    document.getElementById('next2').onclick = () => {
        if (!validateSection(step2)) return;
        showStep(step3);
    };
    document.getElementById('prev2').onclick = () => showStep(step1);
    document.getElementById('prev3').onclick = () => showStep(step2);

    // ============================================================
    // SUBMIT
    // ============================================================
    const registrationForm = document.getElementById('registrationForm');
    const notificationBox = document.getElementById('notificationBox');
    const gotItBtn = document.getElementById('gotItBtn');

    registrationForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        // I-validate ang bawat step; ipakita muna ang step bago mag-report ng error
        showStep(step1);
        if (!validateSection(step1) || !validateDob()) return;

        showStep(step2);
        if (!validateSection(step2)) return;

        showStep(step3);
        if (!validateSection(step3)) return;

        buildFullAddress();

        try {
            const formData = new URLSearchParams(new FormData(registrationForm));

            const response = await fetch('/signup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                notificationBox.classList.remove('hidden');
            } else {
                alert(data.message || "Hindi na-submit ang registration. Subukan ulit.");
            }

        } catch (err) {
            console.error('Signup fetch error:', err);
            alert("May error habang nagsu-submit. Subukan ulit.");
        }
    });

    gotItBtn.addEventListener('click', function (e) {
        e.preventDefault();
        window.location.href = '/';
    });
})();
</script>
</body>
</html>