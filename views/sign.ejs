<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="/style.css">
<title>Registration</title>
<style>
    /* Pagination Circle Styles */
    .pagination-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex: 2;
    }
    label{
        margin-top: 5px;
    }
    .step-circle {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        color: #777;
        background-color: #fff;
        transition: all 0.3s ease;
    }
    .step-circle.active {
        background-color: #1f6aba;
        color: white;
        border-color: #1f6aba;
    }
    .nav-arrow {
        color: #ccc;
        font-size: 18px;
        padding: 0 5px;
    }

    /* Core Logic Styles */
    .form-section { display: none; }
    .form-section.active { display: block; }
    .pagination-buttons { 
        display: flex; 
        align-items: center; 
        justify-content: space-between; 
        margin-top: 20px; 
        width: 100%;
    }
    .pagination-buttons button { padding: 8px 16px; cursor: pointer; }
    .side-spacer { flex: 1; display: flex; }
    #notificationBox{
        z-index: 1000;
    }
         @media (max-width: 1024px) {
            body {
                flex-direction: column;
                justify-content: start;
                overflow-y: auto;
                display: block;
                position: relative;
            }
            .left, .right {
                width: 100%;
                height: auto;
            }
            #tnc {
                width: 100%;
                border-radius: 0;
                height: 100%;
                position: absolute;
                top: 0;
                align-items: center;
                p {
                text-align: center;
                }
            }
                #agreeBtn {
                    width: 100% !important;
                    margin-left: 0 !important;
                }
                .kiy {
                    font-size: 16px;
                    text-align: center !important;
                }
                .kix {
                    font-size: 12px;
                    text-align: center;
                }
                .kiz {
                    height: auto !important;
                    padding: 0;
                    text-align: center;
                    label {
                        margin-right: 0 !important;
                    }
                    input {
                        width: auto;
                    }
                }
            #lC, #rC {
                height: auto;
                width: 100%;
                padding: 5px;
            }
            #h1 {
                height: auto;
                gap: 0;
                padding: 5px;
                flex-direction: column;
            }
            #h2 {
                display: none;
            }
            #h3, #h5 {
                display: none;
            }
            #h4, #h6 {
                display: flex;
            }
            #h6 {
                margin-top: 10px;
            }
            .down, .up {
                width: 100% !important;
            }
            .g {
                width: 100%;
                p {
                    text-align: center;
                }
            }
            #stet {
                display: none;
            }
            .ht {
                font-size: 14px;
            }
            #h8 {
                display: flex;
                height: auto;
                border-radius: 0;
                p {
                    font-size: 12px;
                }
            }
            #dg {
                display: flex;
            }
            #birth {
                height: auto;
                flex-direction: column;
            }
            #step-2, #step-3 {
                height: auto;
            }
            #notificationBox {
                width: 100%;
                height: 100%;
                border-radius: 0;
                p {
                    text-align: center;
                }
                button, a {
                    width: 100%;
                }
                color: white;
                background: 
                    radial-gradient(circle at 50% 90%, var(--tint10), transparent 50%),
                    radial-gradient(circle at 88% 99%,  var(--tint9), transparent 26%),
                    radial-gradient(circle at 20% 1%,  var(--tint8), transparent 70%);
                background-blend-mode: multiply;
                backdrop-filter: blur(50px);
                background-color: white;
                }
                .le2 {
                    font-size: 20px;
                }
                .le1 {
                    font-size: 12px;
                }
        }
</style>
</head>
