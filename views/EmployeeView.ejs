            </section>
        <a class="nav w120 size15" href="javascript:void(0)" id="gotItBtn">Got It!</a>
    </section>


    <!-- ARCHIVE CONFIRM / RESULT CARD (IBANG EMPLOYEE — Super Admin lang) -->
    <% if (canEditOthers) { %>
    <section class="absolute translateCenter shadow3 width30 padding30 gap10 index500 bgWhite col corner15 height0 hidden" id="acCard">
        <img class="h100 w100" src="/images/image.png" alt="">
            <section class="padding0 col alignCenter">
                <p class="size20 str400 textCenter textBalance" id="acCardMsg">Are you sure you want to archive this account? You can restore it later if needed.</p>
            </section>
