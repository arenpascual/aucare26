    <!-- CONFIRM SEND TEMPORARY PASSWORD (IBANG EMPLOYEE — Super Admin lang) -->
    <% if (canEditOthers) { %>
    <section class="width25 bgWhite corner15 col padding20 shadow1 relative hidden" id="passCardOther">
        <div class="nav cnavLG">
            <i class="fas fa-key"></i>
        </div>
