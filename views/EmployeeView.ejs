    // ---- Live clamp: digits only, and cap length (para sa phone number) ----
    function digitsOnlyLive(input, maxLen){
        if (!input) return;
        input.addEventListener('input', () => {
            let raw = input.value.replace(/[^0-9]/g, '');
            if (raw.length > maxLen) raw = raw.slice(0, maxLen);
            input.value = raw;
        });
    }

    // ---- Live clamp: letters, spaces, hyphens, apostrophes only (para sa pangalan) ----
    function lettersOnlyLive(input, extraAllowedChars){
        if (!input) return;
        const allowed = new RegExp(`[^A-Za-z\\s${extraAllowedChars || ''}]`, 'g');
        input.addEventListener('input', () => {
            const start = input.selectionStart;
            const before = input.value;
            const cleaned = before.replace(allowed, '');
            if (cleaned !== before) {
                input.value = cleaned;
                const diff = before.length - cleaned.length;
                const pos = Math.max(0, (start || 0) - diff);
                input.setSelectionRange(pos, pos);
            }
        });
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            const text = (e.clipboardData || window.clipboardData).getData('text');
            const cleanedText = text.replace(allowed, '');
            const startPos = input.selectionStart;
            const endPos = input.selectionEnd;
            const newVal = input.value.slice(0, startPos) + cleanedText + input.value.slice(endPos);
            input.value = newVal;
        });
    }

    digitsOnlyLive(document.getElementById('editPhone'), 11);

    lettersOnlyLive(document.getElementById('editFName'), '\\-\'');
    lettersOnlyLive(document.getElementById('editMName'), '\\-\'');
    lettersOnlyLive(document.getElementById('editLName'), '\\-\'');
    lettersOnlyLive(document.getElementById('editXName'), '.');

    function clearEditFormError(){
        if (!editFormError) return;
        editFormError.style.display = "none";
        editFormError.textContent = "";
    }

    function showEditFormError(msg){
        if (!editFormError) return;
        editFormError.textContent = msg;
        editFormError.style.display = "block";
    }

    const genderSelectEl = document.getElementById('editGender');
    const genderErrorEl = document.getElementById('genderError');

    function clearGenderError(){
        if (!genderErrorEl) return;
        genderErrorEl.style.display = "none";
    }
    function showGenderError(){
        if (!genderErrorEl) return;
        genderErrorEl.style.display = "block";
    }

    if (genderSelectEl) {
        genderSelectEl.addEventListener('change', clearGenderError);
    }

    if (editForm) {
        editForm.addEventListener('submit', function (e) {
            clearEditFormError();
            clearGenderError();

            const inputs = editForm.querySelectorAll('input:not([disabled])');
            for (const input of inputs) {
                if (!input.checkValidity()) {
                    e.preventDefault();
                    input.reportValidity();
                    input.focus();
                    return;
                }
            }

            if (!genderSelectEl || !genderSelectEl.value) {
                e.preventDefault();
                showGenderError();
                if (genderSelectEl) genderSelectEl.focus();
            }
        });
    }

</script>
