    // ==========================
    // ARCHIVE NG IBANG EMPLOYEE (Super Admin lang) — gamit ang acCard modal
    // ==========================
    const archiveOtherBtn = document.getElementById("openArchiveOther");
    const confirmArchiveBtn = document.getElementById("confirmArchiveOther");
    const closeArchiveBtn = document.getElementById("closeArchiveOther");

    if (archiveOtherBtn && acCard) {
        archiveOtherBtn.onclick = () => {
            modal.classList.remove("hidden");
            acCard.classList.remove("hidden");
            if (passCard) passCard.classList.add("hidden");
