<% layout('layout') %>

<style>
    .password-note{
        display:flex;
        flex-direction:column;
        align-items:flex-start;
        gap:8px;
        border:1px solid #444;
        border-radius:12px;
        padding:10px 15px;
        width:100%;
        box-sizing:border-box;
    }

    .password-note p{
        margin:0;
        text-align:left;
    }

    .password-list{
        width:100%;
        list-style: disc;
        padding-left: 20px;
    }

    .password-item{
        margin:4px 0;
        text-align:left;
    }

    .password-input{
        display:flex;
        align-items:center;
        border:1px solid #999;
        border-radius:14px;
        overflow:hidden;
    }

    .password-input input{
        border:none;
        flex:1;
        padding:14px;
        outline:none;
    }

    .password-input i{
        padding:15px;
        cursor:pointer;
    }

    .otp-row{
        display:flex;
        justify-content:space-between;
        align-items:flex-end;
        flex-wrap:nowrap;
        gap:10px;
    }

    #getOtpBtn{
        flex-shrink:0;
        white-space:nowrap;
    }

    #getOtpBtn.disabled{
        opacity:0.5;
        pointer-events:none;
        cursor:not-allowed;
    }

    .otp-resend{
        display:flex;
        align-items:center;
        flex-wrap:wrap;
        gap:6px;
        font-size:12px;
    }

    .otp-resend p{
        margin:0;
    }

    .otp-resend a{
        color:#0d3b66;
        font-weight:600;
        text-decoration:underline;
    }

    #passError{
        color:red;
        display:none;
    }
    #passErrorOther{
        color:red;
        display:none;
    }
    .field-error{
        color:red;
        font-size:12px;
        display:none;
        margin-top:-5px;
    }
    .profile-name{
    width:100%;
    text-align:center !important;
    overflow: hidden;
    font-weight:500;
    margin-top:10px;
    line-height:1.3;
}
.modal{
    position: fixed;
    inset: 0;
    width:100vw;
    height:100vh;
    background:rgba(0,0,0,.45);
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:99999;
    overflow-y: auto;
}

.password-card{
    width:520px;
    max-width:95%;
    padding:25px;
    gap:18px;
    border-radius:18px;
}
.modal.hidden{
    display: none !important;
}
.personal-info-card{
    background:#fff;
    border-radius:16px;
    padding:24px 28px;
    width:100%;
    box-sizing:border-box;
    display:flex;
    flex-direction:column;
    align-items:stretch;
    padding: 10px;
}

.personal-info-card h3{
    font-size:20px;
    font-weight:700;
    margin:0 0 18px 0;
    color:#111;
}

.gender-row{
    display:flex;
    align-items:center;
    gap:24px;
    margin-bottom:18px;
}

.gender-option{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:14px;
    color:#333;
    cursor:pointer;
}

.gender-option input[type="radio"]{
    width:18px;
    height:18px;
    accent-color:#0f12a1;
    cursor:pointer;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
    margin-bottom:16px;
}

.form-group{
    display:flex;
    flex-direction:column;
    gap:25x;
}

.form-group.full{
    grid-column:1 / -1;
}

.form-group label{
    font-size:13px;
    color:#888;
    margin-top: 11px;
}

.form-group .field-value{
    background:#f5f5f7;
    border-radius:10px;
    padding:7px 9px;
    font-size:14px;
    color:#222;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.verified-badge{
    color:#2ecc71;
    font-size:13px;
    font-weight:600;
    display:flex;
    align-items:center;
    gap:5px;
}

.personal-info-buttons{
    display:flex;
    gap:16px;
    margin-top:10px;
}

.btn-discard{
    flex:1;
    padding:14px;
    border-radius:10px;
    border:1.5px solid #f7941d;
    background:#fff;
    color:#f7941d;
    font-weight:600;
    font-size:15px;
    cursor:pointer;
}

.btn-discard:hover{
    background:#fff7ee;
}

.btn-save:hover{
    background:#400291;
}
.mainf {
    padding: 5;
}
</style>

<%
    // True kung ang tinitignan na employee ay ang mismong naka-login (sariling profile).
