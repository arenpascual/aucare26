<% if (isOwnProfile || canEditOthers) { %>
<div id="modal" class="modal hidden">
    <!-- PASSWORD CARD (SARILING PROFILE — may current password + OTP) -->
    <% if (isOwnProfile) { %>
    <form id="passCard" class="password-card bgWhite corner15 shadow1 col padding5 hidden">
        <p class="size24 str500">Change Password</p>

        <div class="password-note padding0">
            <p class="size12"><strong class="str500">Take Note!</strong> Password must contain the following:</p>
            <ul class="password-list padding0">
                <li class="size12 password-item">At least 1 upper case letter</li>
                <li class="size12 password-item">At least 1 special character</li>
                <li class="size12 password-item">Combination of letter and number</li>
                <li class="size12 password-item">Minimum of 8 characters</li>
            </ul>
        </div>

        <div class="field">
            <label>Current Password</label>
            <div class="password-input">
                <input type="password" id="currentPassword">
                <i class="far fa-eye toggle-password"></i>
            </div>
        </div>

        <div class="field">
            <label>New Password</label>
            <div class="password-input">
                <input type="password" id="newPassword">
                <i class="far fa-eye toggle-password"></i>
            </div>
        </div>

        <div class="field">
            <label>Confirm Password</label>
            <div class="password-input">
                <input type="password" id="confirmPassword">
                <i class="far fa-eye-slash toggle-password"></i>
            </div>
        </div>

        <div class="col padding10 borderGray corner10 gap5">
            <div class="otp-row justifyBetween gap10">
                <a href="javascript:void(0)" id="getOtpBtn" class="nav pnav size12">Get OTP</a>
                <div class="field otp-field">
                    <input type="text" id="otpCode" maxlength="6" placeholder="Enter OTP code here">
