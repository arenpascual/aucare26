        passErrorOther.textContent = "";
    }

    document.getElementById("openPasswordOther").onclick = () => {
        modal.classList.remove("hidden");
        passCardOther.classList.remove("hidden");
        notificationBox.classList.add("hidden");
        clearErrorOther();
    };

    document.getElementById("closePasswordOther").onclick = closeModal;

    document.getElementById("submitPasswordOther").onclick = async () => {
