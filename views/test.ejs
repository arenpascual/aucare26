<style>
.popup {
    position: absolute;
    top: -50px;
    left: 0;
    background: #e5e5e5;
    color: #333;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 12px;
    width: 250px;

    box-shadow: 0 4px 10px rgba(0,0,0,0.2);

    opacity: 0;
    visibility: hidden;
    transition: 0.3s ease;
}

/* show */
.field.show-popup .popup {
    opacity: 1;
    visibility: visible;
}
    
.popup:hover{
        visibility:visible;
    }
</style>

