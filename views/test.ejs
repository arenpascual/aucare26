<script>
// =============================
// SHOW MEDICINE FIELD
// =============================
const concern = document.getElementById("concernSelect");
const medicineField = document.getElementById("medicineField");

concern.addEventListener("change", function() {
    if (this.value === "Health Concern / Request Medicines") {
        medicineField.classList.remove("hidden");
    } else {
        medicineField.classList.add("hidden");
    }
});


// =============================
// BUTTONS & MODALS
// =============================
const formBtn = document.getElementById("formBtn");
const tnc = document.getElementById("tnc");
const consultationForm = document.getElementById("Consultationform");
const closeForm = document.getElementById("closeForm");

const agreeBtn = document.getElementById("agreeBtn");
const agreeCheck = document.getElementById("agreeCheck");


// =============================
// STEP 1: CLICK "VISIT NOW"
// =============================
formBtn.addEventListener("click", function(){
    tnc.classList.remove("hidden");
});


// =============================
// STEP 2: ENABLE PROCEED BUTTON
// =============================
agreeCheck.addEventListener("change", function(){
    if(this.checked){
        agreeBtn.style.pointerEvents = "auto";
        agreeBtn.style.opacity = "1";
    } else {
        agreeBtn.style.pointerEvents = "none";
        agreeBtn.style.opacity = "0.5";
    }
});


// =============================
// STEP 3: PROCEED TO FORM
// =============================
agreeBtn.addEventListener("click", function(e){
    e.preventDefault();
    tnc.classList.add("hidden");
    consultationForm.classList.remove("hidden");
});


// =============================
// CLOSE FORM
// =============================
closeForm.addEventListener("click", function(){
    consultationForm.classList.add("hidden");
});


// =============================
// NOTIFICATION
// =============================
const gotItBtn = document.getElementById("gotItBtn");
const notification = document.getElementById("notificationBox");

gotItBtn.addEventListener("click", function(){
    notification.classList.add("hidden");
});
</script>
<script>
const select = document.getElementById("concernSelect");
const popup = document.getElementById("pop");
const field = select.closest(".field");

// show on hover
select.addEventListener("mouseenter", () => {
    field.classList.add("show-popup");
});

// show on click/focus
select.addEventListener("focus", () => {
    field.classList.add("show-popup");
});

// hide when mouse leaves
select.addEventListener("mouseleave", () => {
    field.classList.remove("show-popup");
});

// hide when clicking outside
document.addEventListener("click", (e) => {
    if (!field.contains(e.target)) {
        field.classList.remove("show-popup");
    }
});
</script>
<div style="min-height:600px;background:linear-gradient(135deg,#d4eaf7 0%,#e8f4fd 100%);display:flex;align-items:center;justify-content:center;padding:2rem;border-radius:var(--border-radius-lg);">
<div style="background:var(--color-background-primary);border-radius:var(--border-radius-lg);border:0.5px solid var(--color-border-tertiary);padding:2rem;width:100%;max-width:460px;">
  <p style="font-size:20px;font-weight:500;margin:0 0 1.5rem;color:var(--color-text-primary);">Consultation Request Form:</p>

  <div style="margin-bottom:1.25rem;">
    <label style="font-size:14px;color:var(--color-text-secondary);display:block;margin-bottom:6px;">Concern</label>

    <div style="position:relative;" id="ddWrap">
      <div id="ddTrigger" onclick="toggleDD()" style="width:100%;padding:10px 14px;font-size:15px;border-radius:var(--border-radius-md);border:0.5px solid var(--color-border-secondary);background:var(--color-background-primary);color:var(--color-text-secondary);cursor:pointer;display:flex;justify-content:space-between;align-items:center;box-sizing:border-box;">
        <span id="ddLabel">Select Concern</span>
        <span style="font-size:11px;">▼</span>
      </div>

      <div id="ddMenu" style="display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--color-background-primary);border:0.5px solid var(--color-border-secondary);border-radius:var(--border-radius-md);z-index:100;overflow:visible;">
        <div class="opt" data-val="rest" onmouseenter="showPopup(this)" onmouseleave="hidePopup()" onclick="selectOpt(this)" style="padding:11px 14px;font-size:15px;cursor:pointer;color:var(--color-text-primary);border-radius:var(--border-radius-md) var(--border-radius-md) 0 0;">Rest/Observation</div>
        <div style="height:0.5px;background:var(--color-border-tertiary);"></div>
        <div class="opt" data-val="health" onmouseenter="showPopup(this)" onmouseleave="hidePopup()" onclick="selectOpt(this)" style="padding:11px 14px;font-size:15px;cursor:pointer;color:var(--color-text-primary);">Health Concern / Request Medicines</div>
        <div style="height:0.5px;background:var(--color-border-tertiary);"></div>
        <div class="opt" data-val="consult" onmouseenter="showPopup(this)" onmouseleave="hidePopup()" onclick="selectOpt(this)" style="padding:11px 14px;font-size:15px;cursor:pointer;color:var(--color-text-primary);border-radius:0 0 var(--border-radius-md) var(--border-radius-md);">Health Consultation</div>
      </div>

      <div id="hoverPopup" style="display:none;position:absolute;left:calc(100% + 12px);top:0;width:260px;z-index:200;">
        <div style="position:absolute;left:-7px;top:18px;width:0;height:0;border-top:7px solid transparent;border-bottom:7px solid transparent;border-right:7px solid #1a1a1a;"></div>
        <div style="background:#1a1a1a;border-radius:var(--border-radius-lg);padding:1rem 1.25rem;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;padding-bottom:10px;border-bottom:0.5px solid rgba(255,255,255,0.15);">
            <span id="pIcon" style="font-size:15px;"></span>
            <span id="pTitle" style="font-size:14px;font-weight:500;color:#f0f0f0;"></span>
          </div>
          <p id="pDesc" style="font-size:13px;color:rgba(255,255,255,0.6);margin:0;line-height:1.55;"></p>
        </div>
      </div>
    </div>
  </div>

  <div style="background:#f0f6ff;border-radius:var(--border-radius-md);padding:0.85rem 1rem;margin-bottom:1.5rem;font-size:13px;color:#3a5fa0;line-height:1.5;">
    Your request will be reviewed by the clinic admin or nurse. Please wait for approval before proceeding.
  </div>

  <div style="display:flex;gap:12px;">
    <button style="flex:1;padding:11px;border-radius:var(--border-radius-md);border:0.5px solid var(--color-border-secondary);background:transparent;font-size:15px;cursor:pointer;color:var(--color-text-primary);">Cancel</button>
    <button style="flex:2;padding:11px;border-radius:var(--border-radius-md);border:none;background:#1a3a6e;color:#fff;font-size:15px;font-weight:500;cursor:pointer;">Submit</button>
  </div>
</div>
</div>

<style>
.opt:hover { background: var(--color-background-secondary); }
</style>

<script>
const info = {
  rest:    { icon:'🛏', title:'Rest / Observation',                  desc:'Use a clinic bed or require a quiet space to rest and recover during school hours.' },
  health:  { icon:'💊', title:'Health Concern / Request Medicines',  desc:'Seeking specific medication or basic first aid from clinic staff.' },
  consult: { icon:'🩺', title:'Health Consultation',                 desc:'Speak directly with a health professional for personal advice or assessment.' }
};

function toggleDD() {
  const m = document.getElementById('ddMenu');
  m.style.display = m.style.display === 'none' ? 'block' : 'none';
}

function showPopup(el) {
  const d = info[el.dataset.val];
  if (!d) return;
  document.getElementById('pIcon').textContent = d.icon;
  document.getElementById('pTitle').textContent = d.title;
  document.getElementById('pDesc').textContent = d.desc;
  const popup = document.getElementById('hoverPopup');
  popup.style.top = el.offsetTop + 'px';
  popup.style.display = 'block';
}

function hidePopup() {
  document.getElementById('hoverPopup').style.display = 'none';
}

function selectOpt(el) {
  document.getElementById('ddLabel').textContent = el.textContent.trim();
  document.getElementById('ddLabel').style.color = 'var(--color-text-primary)';
  document.getElementById('ddMenu').style.display = 'none';
  hidePopup();
}

document.addEventListener('click', function(e) {
  if (!document.getElementById('ddWrap').contains(e.target)) {
    document.getElementById('ddMenu').style.display = 'none';
    hidePopup();
  }
});
</script>

