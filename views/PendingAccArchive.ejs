<% layout('layout') %>

<div class="height10 justifyBetween">
    
    <div class="width0 ">
    <a href="/pd" class="nav"><i class="fas fa-chevron-left"></i> Return</a> 
    </div>
    <p class="size40 str400 "> Pending Account Archive</p>
</div>
<div class="height90 col justifyStart padding10">
    <div class="height0 justifyBetween">
        <div class="width0 gap5">
            <div class="selectBar w190">
                <i class="fas fa-user-tag"></i>
                <select id="roleFilter">
                    <option value="">All Roles</option>
                </select>
            </div>
            <div class="selectBar w190">
                <i class="fas fa-building"></i>
                <select id="deptFilter">
                    <option value="">All Departments</option>
                </select>
            </div>
        </div>
        <div class="width0 gap8 ">
            <div class="searchBar w220">
                <i class="fas fa-search"></i>
                <input type="search" id="archiveSearch" placeholder="Search name, ID, email, role...">
            </div>
        </div>
    </div>
    <br>
    <table>
        <thead>
            <tr>
                <th class="width5">#</th>
                <th class="width20">Name</th>
                <th class="width10">School ID</th>
                <th class="width20">Email</th>
                <th class="width15">Role</th>
                <th class="width30">Course</th>
            </tr>
        </thead>
        <tbody id="archiveBody">
            <% if (declinedUsers && declinedUsers.length > 0) { %>
                <% declinedUsers.forEach((u, index) => { %>
                    <tr data-role="<%= u.role || '' %>"
                        data-dept="<%= u.course || '' %>"
                        data-search="<%= [u.fName, u.lName, u.schoolId, u.email, u.role, u.course].filter(Boolean).join(' ').toLowerCase() %>">
                        <td><%= index + 1 %></td>
                        <td><a href="/pav/<%= u._id %>" class="underline navy"><%= u.fName %> <%= u.lName %></a></td>
                        <td><%= u.schoolId || '—' %></td>
                        <td><%= u.email || '—' %></td>
                        <td><%= u.role %></td>
                        <td><%= u.course || '—' %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" class="center">No declined accounts.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
    <p id="noResultsMsg" class="size14 gray hidden" style="padding: 15px 0;">No matching accounts found.</p>
</div>

<script>
(function () {
    const tbody = document.getElementById('archiveBody');
    const roleSel = document.getElementById('roleFilter');
    const deptSel = document.getElementById('deptFilter');
    const searchInput = document.getElementById('archiveSearch');
    const noResults = document.getElementById('noResultsMsg');
    if (!tbody) return;

    const getRows = () => Array.from(tbody.querySelectorAll('tr[data-role]'));

    // Punuin ang dropdowns mula sa laman ng table
    function fillSelect(select, attr, allLabel) {
        select.innerHTML = `<option value="">${allLabel}</option>`;
        [...new Set(getRows().map(r => r.dataset[attr]).filter(Boolean))]
            .sort((a, b) => a.localeCompare(b))
            .forEach(v => select.add(new Option(v, v)));
    }
    fillSelect(roleSel, 'role', 'All Roles');
    fillSelect(deptSel, 'dept', 'All Departments');

    function applyFilters() {
        const role = roleSel.value;
        const dept = deptSel.value;
        const q = searchInput.value.trim().toLowerCase();
        let visible = 0;

        getRows().forEach(row => {
            const ok =
                (!role || row.dataset.role === role) &&
                (!dept || row.dataset.dept === dept) &&
                (!q || row.dataset.search.includes(q));
            row.style.display = ok ? '' : 'none';
            if (ok) row.cells[0].textContent = ++visible; // renumber ang #
        });

        noResults.classList.toggle('hidden', visible > 0 || getRows().length === 0);
    }

    roleSel.addEventListener('change', applyFilters);
    deptSel.addEventListener('change', applyFilters);
    searchInput.addEventListener('input', applyFilters);
})();
</script>