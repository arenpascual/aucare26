<% layout('layout') %>

<div class="height10 justifyBetween">
    
    <div class="width0 ">
    <a href="/pd" class="nav"><i class="fas fa-chevron-left"></i> Return</a> 
    </div>
    <p class="size40 str400 "> Pending Account Archive</p>
</div>
<div class="height90 col justifyStart padding10">
    <div class="height0 justifyBetween">
        <div class="width0">
            <div class="selectBar w190"><i class="fas fa-filter"></i><select name="" id="">
                <option value=""></i> Filter By</option>
            </select></div>
        </div>
        <div class="width0 gap8 ">
            <div class="searchBar w220"><i class="fas fa-search"></i><input type="search" name="" id=""></div>
        </div>
    </div>
    <br>
    <table>
        <thead>
            <tr>
                <th class="width5">#</th>
                <th class="width20">Name</th>
                <th class="width10">School ID</th>
                <th class="width20">Email</th>
                <th class="width15">Role</th>
                <th class="width30">Course</th>
            </tr>
        </thead>
            <tbody>
    <% if (declinedUsers && declinedUsers.length > 0) { %>
        <% declinedUsers.forEach((u, index) => { %>
            <tr>
                <td><%= index + 1 %></td>
                 <td><a href="/pav" class="underline navy"><%= u.fName %> <%= u.lName %></a></td>
                <td><%= u.schoolId || '—' %></td>
                <td><%= u.email || '—' %></td>
                <td><%= u.role %></td>
                <td><%= u.course || '—' %></td>
            </tr>
        <% }) %>
    <% } else { %>
        <tr>
            <td colspan="6" class="center">No declined accounts.</td>
        </tr>
    <% } %>
</tbody>
    </table>
</div>