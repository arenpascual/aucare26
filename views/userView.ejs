<% layout('layout') %>
<style>
    .mainf {
        padding: 0;
    }
    .shape {
        clip-path: polygon(0% 0%, 100% 0%, 80% 100%, 0% 100%);
    }
</style>

<div class=" gap10 polaroid alignStart">
    <div class="padding10 width25 height100 col alignStart gap15">
        <a href="/um" class="nav"><i class="fas fa-chevron-left"></i> Return</a> 
        <div class="bgWhite corner15 justifyStart col padding20">
            <section class="col ">
                <img class="h80 w80 hidden" src="/images/profile.png" alt="">
                <p class="size28 colorPrimary">
                    <%= patient.fName %> <%= patient.mName ? patient.mName + ' ' : '' %><%= patient.lName %>
                </p>
                <p class="size16 blue"><%= patient.schoolId || '—' %></p>
                <p class="size16 gray"><%= patient.email %></p>
            </section>
            <section class="col gap5">
                <a href="/vv1/<%= patient._id %>" class="nav pnav width100">Consultation Record</a>
                <a href="javascript:void(0)" id="exportCard" class="nav pnav width100">Export Health Card</a>
            </section>
        </div>
    </div>
    <div class="width75 col justifyStart padding15 gap15">
        <div class="height0 justifyBetween gap10 padding0">
            <p class="size28 str400 blue ">Patient's Information</p>
            <a href="" class="nav gnav hidden"><i class="fas fa-check-circle"></i> Approve Account</a>
        </div>
    
        <div class="height0 justifyStart gap10 padding0 ">
            <section class="left width100 bgWhite corner14 col alignStart padding15 borderGray relative height0">
                <a href="javascript:void(0)" id="lgBtn" class="nav cnav absolute right16 top10"><i class="fas fa-pen"></i></a>
                <p class="size20 str400">Personal Details</p>
                <p class="size14 gray">Gender: <%= patient.gender || '—' %></p>
                <p class="size14 gray">Address: <%= patient.address || '—' %></p>
                <p class="size14 gray">Date of Birth: <%= dob %></p>
            </section>
        </div>
        
        <section class="left width100 bgWhite corner14 col alignStart gap5 padding10 borderGray relative height0">
            <a href="javascript:void(0)" id="lgBtn" class="nav cnav absolute right16 top10"><i class="fas fa-pen"></i></a>
            <p class="size20 str400">School Information</p>
            <p class="size14 gray">School ID: <%= patient.schoolId || '—' %></p>
            <p class="size14 gray">Year Level: <%= patient.yearLevel || '—' %></p>
            <p class="size14 gray">Course: <%= patient.course || '—' %></p>
        </section>
            
        <div class="height0 gap10">
            <section class="left width50 bgWhite corner14 col alignStart gap5 padding15 borderGray relative height0">
                <a href="javascript:void(0)" id="lgBtn" class="nav cnav absolute right16 top10"><i class="fas fa-pen"></i></a>
                <p class="size20 str400">Allergies</p>
                <p class="size14 gray">Food Allergies: <%= patient.fAllergy || 'None' %></p>
                <p class="size14 gray">Medicines Allergies: <%= patient.mAllergy || 'None' %></p>
                <p class="size14 gray">Other Allergies: <%= patient.oAllergy || 'None' %></p>
            </section>
            <section class="left width50 bgWhite corner14 col alignStart gap5 padding15 borderGray relative height0">
                <a href="javascript:void(0)" id="lgBtn" class="nav cnav absolute right16 top10"><i class="fas fa-pen"></i></a>
                <p class="size20 str400">Emergency Contact</p>
                <p class="size14 gray">Name: <%= patient.eName || '—' %></p>
                <p class="size14 gray">Contact: <%= patient.ePhone || '—' %></p>
                <p class="size14 gray">Address: <%= patient.eAddress || '—' %></p>
            </section>
        </div>
    </div>
</div>

<div class="bgWhite corner200 hidden">
    <div class="bgWhite shadow1 absolute left20 top70 width40 height0 justifyStart col hidden" id="healthCard">
        <section class="justifyBetween padding0 relative">
            <section class="bgIndigo950 justifyStart width60 gap5" style="border-bottom-right-radius: 40px;">
                <img src="/images/logo.png" alt="" class="corner500 h50 w50">
                <div class="section padding0 alignStart col white width0">
                    <p class="size24">AuCare</p>
                    <p class="size10 str300" style="margin-top: -5px !important;">PHINMA Araullo University South Campus</p>
                </div>
            </section>
            <section class="width0">
                <p class="size22 str500">Emergency Card</p>
            </section>
        </section>
        <section class="col alignStart">
            <p class="size16">Name: <%= patient.fName %> <%= patient.lName %></p>
            <p class="size16">Address: <%= patient.address || '—' %></p>
            <p class="size16">Contact Number: <%= patient.phone || '—' %></p>
        </section>
        <section class="bgGray padding5">
            <p class="size18 str500 upperCase">MEDICAL CONCERNS</p>
        </section>
        <section class="">
            <section class="col alignStart padding0">
                <p class="size16">Allergies: <%= [patient.fAllergy, patient.mAllergy, patient.oAllergy].filter(Boolean).join(', ') || 'None' %></p>
            </section>
            <section class="col alignStart padding0">
                <p class="size16">Health History: </p>
            </section>
        </section>
        <section class="bgGray padding5">
            <p class="size18 str500 upperCase">EMERGENCY CONTACT</p>
        </section>
        <section class="t">
            <section class="col alignStart padding0">
                <p class="size16">Contact #1</p>
                <p class="size16">Name: <%= patient.eName || '—' %></p>
                <p class="size16">Address: <%= patient.eAddress || '—' %></p>
                <p class="size16">Contact Number: <%= patient.ePhone || '—' %></p>
                <p class="size16">Relationship: </p>
            </section>
            <section class="col alignStart padding0">
                <p class="size16">Contact #2</p>
                <p class="size16">Name: </p>
                <p class="size16">Address: </p>
                <p class="size16">Contact Number: </p>
                <p class="size16">Relationship: </p>
            </section>
        </section>
        <br>
        <section class="bgIndigo950"></section>
        <br>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
    document.getElementById('exportCard').addEventListener('click', function () {
        const originalCard = document.getElementById('healthCard');
        const clone = originalCard.cloneNode(true);

        Object.assign(clone.style, {
            display: 'flex',
            position: 'absolute',
            top: '-9999px',
            left: '-9999px',
            width: '40%',
            height: 'auto'
        });

        document.body.appendChild(clone);

        html2canvas(clone, {
            useCORS: true,
            scale: 3,
            backgroundColor: null,
            logging: false
        }).then(canvas => {
            const image = canvas.toDataURL("image/png");
            const link = document.createElement('a');
            link.download = 'AuCare-Emergency-Card.png';
            link.href = image;
            link.click();
            document.body.removeChild(clone);
        }).catch(err => {
            console.error("Export failed:", err);
        });
    });
</script>