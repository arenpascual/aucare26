<% layout('layout') %>
<style>
    .mainf {
        padding: 0;
    }
    .shape {
        clip-path: polygon(0% 0%, 100% 0%, 80% 100%, 0% 100%);
    }
        .profile-name{
        width:100%;
        text-align:center;
        overflow: hidden;
        font-weight:600;
        margin-top:10px;
    }
    #modal{
    position:fixed;
    inset:0;
    width:100vw;
    height:100vh;
    background:rgba(0,0,0,.45);
    display:flex;
    justify-content:center;
    align-items:center;
    z-index:99999;
}

.hidden{
    display:none !important;
}
</style>

<div class=" gap10 polaroid alignStart">
    <div class="padding10 width25 height100 col alignStart gap15">
        <a href="/um" class="nav"><i class="fas fa-chevron-left"></i> Return</a> 
        <div class="bgWhite corner15 justifyStart col padding20">
            <section class="col ">
                <img class="h80 w80" src="/images/profile.png" alt="">
                <p class="size28 colorPrimary profile-name">
                    <%= patient.fName %> <%= patient.mName ? patient.mName + ' ' : '' %><%= patient.lName %>
                </p>
                <p class="size16 blue"><%= patient.schoolId || '—' %></p>
                <p class="size16 gray textWrap textCenter"><%= patient.email %></p>
            </section>
            <section class="col gap5">
                <a href="/cr/<%= patient._id %>" class="nav pnav width100">Consultation Record</a>
                <a href="javascript:void(0)" id="exportCard" class="nav pnav width100">Export Health Card</a>
            </section>
        </div>
    </div>
    <div class="width75 col justifyStart padding15 gap15">
        <div class="height0 justifyBetween gap10 padding0">
            <p class="size28 str400 blue ">Patient's Information</p>
            <a href="" class="nav gnav hidden"><i class="fas fa-check-circle"></i> Approve Account</a>
        </div>
    
        <div class="height0 justifyStart gap10 padding0 ">
            <section class="left width100 bgWhite corner14 col alignStart padding15 borderGray relative height0">
                <a href="javascript:void(0)"class="nav cnav absolute right16 top10 lgBtn"data-target="editForm">
                    <i class="fas fa-pen"></i>
                </a>
                <p class="size20 str400">Personal Details</p>
                <p class="size14 gray">Gender: <%= patient.gender || '—' %></p>
                <p class="size14 gray">Address: <%= patient.address || '—' %></p>
                <p class="size14 gray">Date of Birth: <%= dob %></p>
            </section>
        </div>
        
        <section class="left width100 bgWhite corner14 col alignStart gap5 padding10 borderGray relative height0">
            <a href="javascript:void(0)"class="nav cnav absolute right16 top10 lgBtn"data-target="eseditForm">
                <i class="fas fa-pen"></i>
            </a>
            <p class="size20 str400">School Information</p>
            <p class="size14 gray">School ID: <%= patient.schoolId || '—' %></p>
            <p class="size14 gray">Year Level: <%= patient.yearLevel || '—' %></p>
            <p class="size14 gray">Course: <%= patient.course || '—' %></p>
        </section>
            
        <div class="height0 gap10">
            <section class="left width50 bgWhite corner14 col alignStart gap5 padding15 borderGray relative height0">
                <a href="javascript:void(0)"class="nav cnav absolute right16 top10 lgBtn"data-target="eaeditForm">
                    <i class="fas fa-pen"></i>
                </a>
                <p class="size20 str400">Allergies</p>
                <p class="size14 gray">Food Allergies: <%= patient.fAllergy || 'None' %></p>
                <p class="size14 gray">Medicines Allergies: <%= patient.mAllergy || 'None' %></p>
                <p class="size14 gray">Other Allergies: <%= patient.oAllergy || 'None' %></p>
            </section>
            <section class="left width50 bgWhite corner14 col alignStart gap5 padding15 borderGray relative height0">
                <a href="javascript:void(0)"class="nav cnav absolute right16 top10 lgBtn"data-target="eceditForm">
                    <i class="fas fa-pen"></i>
                </a>
                <p class="size20 str400">Emergency Contact</p>
                <p class="size14 gray">Name: <%= patient.eName || '—' %></p>
                <p class="size14 gray">Contact: <%= patient.ePhone || '—' %></p>
                <p class="size14 gray">Address: <%= patient.eAddress || '—' %></p>
            </section>
        </div>
    </div>
</div>

<div id="modal" class="bgWhite corner200 hidden">
    <div class="bgWhite shadow1 absolute left20 top70 width40 height0 justifyStart col hidden" id="healthCard">
        <section class="justifyBetween padding0 relative">
            <section class="bgIndigo950 justifyStart width60 gap5" style="border-bottom-right-radius: 40px;">
                <img src="/images/logo.png" alt="" class="corner500 h50 w50">
                <div class="section padding0 alignStart col white width0">
                    <p class="size24">AuCare</p>
                    <p class="size10 str300" style="margin-top: -5px !important;">PHINMA Araullo University South Campus</p>
                </div>
            </section>
            <section class="width0">
                <p class="size22 str500">Emergency Card</p>
            </section>
        </section>
        <section class="col alignStart">
            <p class="size16">Name: <%= patient.fName %> <%= patient.lName %></p>
            <p class="size16">Address: <%= patient.address || '—' %></p>
            <p class="size16">Contact Number: <%= patient.phone || '—' %></p>
        </section>
        <section class="bgGray padding5">
            <p class="size18 str500 upperCase">MEDICAL CONCERNS</p>
        </section>
        <section class="">
            <section class="col alignStart padding0">
                <p class="size16">Allergies: <%= [patient.fAllergy, patient.mAllergy, patient.oAllergy].filter(Boolean).join(', ') || 'None' %></p>
            </section>
            <section class="col alignStart padding0">
                <p class="size16">Health History: </p>
            </section>
        </section>
        <section class="bgGray padding5">
            <p class="size18 str500 upperCase">EMERGENCY CONTACT</p>
        </section>
        <section class="t">
            <section class="col alignStart padding0">
                <p class="size16">Contact #1</p>
                <p class="size16">Name: <%= patient.eName || '—' %></p>
                <p class="size16">Address: <%= patient.eAddress || '—' %></p>
                <p class="size16">Contact Number: <%= patient.ePhone || '—' %></p>
                <p class="size16">Relationship: </p>
            </section>
            <section class="col alignStart padding0">
                <p class="size16">Contact #2</p>
                <p class="size16">Name: </p>
                <p class="size16">Address: </p>
                <p class="size16">Contact Number: </p>
                <p class="size16">Relationship: </p>
            </section>
        </section>
        <br>
        <section class="bgIndigo950"></section>
        <br>
    </div>
    <!-- EDIT PERSONAL INFORMATION -->
        <form id="editForm" action="/profile2/update" method="POST" class="width40 col justifyStart alignStart padding20 gap5 height0 shadow1 absolute translateCenter hidden" style="z-index:700;" novalidate>
            <p class="size30 str500">Edit Personal Information</p>
            <div class="field">
                <section class="gap10 justifyStart">
                    <label>
                        <input type="radio" name="gender" value="Male" <%= user.gender === 'Male' ? 'checked' : '' %> required> Male
                    </label>
                    <label>
                        <input type="radio" name="gender" value="Female" <%= user.gender === 'Female' ? 'checked' : '' %> required> Female
                    </label>
                </section>
            </div>
                <section class="gap10">
                    <div class="field">
                        <label>First Name</label>
                        <input type="text" name="fName" id="editFName" value="<%= user.fName %>" maxlength="50" pattern="^[A-Za-z\s\-']+$" title="Letters, spaces, hyphens and apostrophes only" required>
                    </div>
                    <div class="field">
                        <label>Middle Name</label>
                        <input type="text" name="mName" id="editMName" value="<%= user.mName %>" maxlength="50" pattern="^[A-Za-z\s\-']*$" title="Letters, spaces, hyphens and apostrophes only">
                    </div>
                </section>
                <section class="gap10">
                    <div class="field">
                        <label>Last Name</label>
                        <input type="text" name="lName" id="editLName" value="<%= user.lName %>" maxlength="50" pattern="^[A-Za-z\s\-']+$" title="Letters, spaces, hyphens and apostrophes only" required>
                    </div>
                    <div class="field">
                        <label>Extension Name</label>
                        <input type="text" name="xName" id="editXName" value="<%= user.xName %>" maxlength="10" pattern="^[A-Za-z.\s]*$" title="e.g. Jr., Sr., III" placeholder="e.g. Jr., III">
                    </div>
                </section>
                <section class="gap10">
                    <div class="field">
                        <label>Email</label>
                        <input type="email" name="email" id="editEmail" value="<%= user.email %>" maxlength="100" required>
                    </div>
                    <div class="field">
                        <label>Contact Number</label>
                        <input type="tel" name="phone" id="editPhone" value="<%= user.phone %>" placeholder="09XXXXXXXXX" inputmode="numeric" maxlength="11" pattern="^09[0-9]{9}$" title="Enter an 11-digit PH mobile number starting with 09" required>
                    </div>
                </section>
                <section>
                    <div class="field">
                        <label>Address</label>
                        <input type="text" name="address" id="editAddress" value="<%= user.address %>" maxlength="150" required>
                    </div>
                </section>
                <div class="field padding10">
                    <label>Date of Birth</label>
                    <div class="row gap5">
                        <div class="selectBar">
                            <select name="bMonth" id="bMonth" required>
                                <option value="" selected disabled>--Month--</option>
                                <option value="1">01</option>
                                <option value="2">02</option>
                                <option value="3">03</option>
                                <option value="4">04</option>
                                <option value="5">05</option>
                                <option value="6">06</option>
                                <option value="7">07</option>
                                <option value="8">08</option>
                                <option value="9">09</option>
                                <option value="10">10</option>
                                <option value="11">11</option>
                                <option value="12">12</option>
                            </select>
                        </div>
                        <input type="text" name="bDay" id="bDay" placeholder="Day" inputmode="numeric" maxlength="2" required>
                        <div class="selectBar">
                            <select name="bYear" id="bYear" required>
                                <option value="" selected disabled>--Year--</option>
                                <% const currentYear = new Date().getFullYear(); %>
                                <% for (let y = currentYear - 10; y >= currentYear - 80; y--) { %>
                                    <option value="<%= y %>"><%= y %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>
                    <p class="field-error" id="dobError"></p>
                </div>
                <p class="field-error"></p>
                <section class="gap20">
                    <a href="javascript:void(0)" class="nav width100 closeEditBtn">Cancel</a>
                    <button type="submit" class="nav pnav width100">Save Changes</button>
                </section>
    </form>

    <!-- EDIT SCHOOL INFORMATION -->
    <form id="eseditForm" action="/profile2/update" method="POST" class="width40 col justifyStart alignStart padding20 gap5 height0 shadow1 absolute translateCenter hidden" style="z-index:700;" novalidate>
            <p class="size30 str500">Edit School Information</p>
                <div class="field">
                    <label>School ID</label>
                    <input type="text" name="schoolId" id="editSchoolId" value="<%= user.schoolId %>" maxlength="20" pattern="^[A-Za-z0-9\-]+$" title="Letters, numbers and hyphens only" required>
                </div>
                <div class="field">
                    <label>Year Level</label>
                    <div class="selectBar">
                        <select name="yearLevel" required>
                            <option value="" disabled <%= !user.yearLevel ? 'selected' : '' %>>--Select--</option>
                            <option value="4th Year" <%= user.yearLevel === '4th Year' ? 'selected' : '' %>>4th Year</option>
                            <option value="3rd Year" <%= user.yearLevel === '3rd Year' ? 'selected' : '' %>>3rd Year</option>
                            <option value="2nd Year" <%= user.yearLevel === '2nd Year' ? 'selected' : '' %>>2nd Year</option>
                            <option value="1st Year" <%= user.yearLevel === '1st Year' ? 'selected' : '' %>>1st Year</option>
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label>Course</label>
                    <div class="selectBar">
                        <select name="course" id="editCourse" required>
                            <option value="" disabled <%= !user.course ? 'selected' : '' %>>--Select--</option>
                            <option value="BS Architecture">BS Architecture (BSArch)</option>
                            <option value="BS Accountancy">BS Accountancy (BSA)</option>
                            <option value="BS Accounting Information System">BS Accounting Information System (BSAIS)</option>
                            <option value="BS Biology">BS Biology (BS Bio)</option>
                            <option value="BS Business Administration">BS Business Administration (BSBA)</option>
                            <option value="BS Civil Engineering">BS Civil Engineering (BSCE)</option>
                            <option value="BS Computer Engineering">BS Computer Engineering (BSCpE)</option>
                            <option value="BS Computer Science">BS Computer Science (BSCS)</option>
                            <option value="BS Criminology">BS Criminology (BSCrim)</option>
                            <option value="BS Dentistry">BS Dentistry (DMD)</option>
                            <option value="BS Education">BS Education (BSEd)</option>
                            <option value="BS Electrical Engineering">BS Electrical Engineering (BSEE)</option>
                            <option value="BS Electronics Engineering">BS Electronics Engineering (BSECE)</option>
                            <option value="BS Hospitality Management">BS Hospitality Management (BSHM)</option>
                            <option value="BS Hotel and Restaurant Management">BS Hotel and Restaurant Management (BSHRM)</option>
                            <option value="BS Information Systems">BS Information Systems (BSIS)</option>
                            <option value="BS Information Technology">BS Information Technology (BSIT)</option>
                            <option value="BS Industrial Engineering">BS Industrial Engineering (BSIE)</option>
                            <option value="BS Mechanical Engineering">BS Mechanical Engineering (BSME)</option>
                            <option value="BS Medical Technology">BS Medical Technology (BSMT)</option>
                            <option value="BS Midwifery">BS Midwifery</option>
                            <option value="BS Nursing">BS Nursing (BSN)</option>
                            <option value="BS Pharmacy">BS Pharmacy</option>
                            <option value="BS Physical Therapy">BS Physical Therapy (BSPT)</option>
                            <option value="BS Psychology">BS Psychology (BSPsych)</option>
                            <option value="BS Public Administration">BS Public Administration (BSPA)</option>
                            <option value="BS Tourism Management">BS Tourism Management (BSTM)</option>
                            <option value="Doctor of Medicine">Doctor of Medicine (MD)</option>
                            <option value="Juris Doctor">Juris Doctor (JD)</option>
                            <option value="Others">Others</option>
                        </select>
                    </div>
                </div>
                <p class="field-error"></p>
                <section class="gap20">
                    <a href="javascript:void(0)" class="nav width100 closeEditBtn">Cancel</a>
                    <button type="submit" class="nav pnav width100">Save Changes</button>
                </section>
    </form>

    <!-- EDIT EMERGENCY CONTACT -->
    <form id="eceditForm" action="/profile2/update" method="POST" class="width40 col justifyStart alignStart padding20 gap5 height0 shadow1 absolute translateCenter hidden" style="z-index:700;" novalidate>
            <p class="size30 str500">Edit Emergency Contact</p>
                <section class="gap10">
                    <div class="field">
                        <label>Full Name</label>
                        <input type="text" name="eName" id="editEName" value="<%= user.eName %>" maxlength="100" pattern="^[A-Za-z\s\-']+$" title="Letters, spaces, hyphens and apostrophes only" required>
                    </div>
                    <div class="field">
                        <label>Contact Number</label>
                        <input type="tel" name="ePhone" id="editEPhone" value="<%= user.ePhone %>" placeholder="09XXXXXXXXX" inputmode="numeric" maxlength="11" pattern="^09[0-9]{9}$" title="Enter an 11-digit PH mobile number starting with 09" required>
                    </div>
                </section>
                <section>
                    <div class="field">
                        <label>Address</label>
                        <input type="text" name="eAddress" id="editEAddress" value="<%= user.eAddress %>" maxlength="150" required>
                    </div>
                </section>
                <p class="field-error"></p>
                <section class="gap20">
                    <a href="javascript:void(0)" class="nav width100 closeEditBtn">Cancel</a>
                    <button type="submit" class="nav pnav width100">Save Changes</button>
                </section>
    </form>

    <!-- EDIT ALLERGIES -->
    <form id="eaeditForm" action="/profile2/update" method="POST" class="width40 col justifyStart alignStart padding20 gap5 height0 shadow1 absolute translateCenter hidden" style="z-index:700;" novalidate>
            <p class="size30 str500">Edit Allergies</p>
                <div class="field">
                    <label>Any Food Allergies?</label>
                    <div class="selectBar">
                        <select name="fAllergy" id="editFAllergy" required>
                            <option value="" disabled <%= !user.fAllergy ? 'selected' : '' %>>--Select--</option>
                            <option value="Yes" <%= user.fAllergy === 'Yes' ? 'selected' : '' %>>Yes</option>
                            <option value="No" <%= user.fAllergy === 'No' ? 'selected' : '' %>>No</option>
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label>Any Allergies to Medicines?</label>
                    <div class="selectBar">
                        <select name="mAllergy" id="editMAllergy" required>
                            <option value="" disabled <%= !user.mAllergy ? 'selected' : '' %>>--Select--</option>
                            <option value="Yes" <%= user.mAllergy === 'Yes' ? 'selected' : '' %>>Yes</option>
                            <option value="No" <%= user.mAllergy === 'No' ? 'selected' : '' %>>No</option>
                        </select>
                    </div>
                </div>
                <p class="field-error"></p>
                <section class="gap20">
                    <a href="javascript:void(0)" class="nav width100 closeEditBtn">Cancel</a>
                    <button type="submit" class="nav pnav width100">Save Changes</button>
                </section>
    </form>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
    document.getElementById('exportCard').addEventListener('click', function () {
        const originalCard = document.getElementById('healthCard');
        const clone = originalCard.cloneNode(true);

        Object.assign(clone.style, {
            display: 'flex',
            position: 'absolute',
            top: '-9999px',
            left: '-9999px',
            width: '40%',
            height: 'auto'
        });

        document.body.appendChild(clone);

        html2canvas(clone, {
            useCORS: true,
            scale: 3,
            backgroundColor: null,
            logging: false
        }).then(canvas => {
            const image = canvas.toDataURL("image/png");
            const link = document.createElement('a');
            link.download = 'AuCare-Emergency-Card.png';
            link.href = image;
            link.click();
            document.body.removeChild(clone);
        }).catch(err => {
            console.error("Export failed:", err);
        });
    });
    const modal = document.getElementById("modal");

const editForms = [
    document.getElementById("editForm"),
    document.getElementById("eseditForm"),
    document.getElementById("eceditForm"),
    document.getElementById("eaeditForm")
];

function closeModal(){

    modal.classList.add("hidden");

    editForms.forEach(form=>{
        if(form){
            form.classList.add("hidden");
        }
    });

}

document.querySelectorAll(".lgBtn").forEach(btn=>{

    btn.addEventListener("click",function(){

        modal.classList.remove("hidden");

        editForms.forEach(form=>{
            if(form){
                form.classList.add("hidden");
            }
        });

        const target=document.getElementById(this.dataset.target);

        if(target){
            target.classList.remove("hidden");
        }

    });

});

document.querySelectorAll(".closeEditBtn").forEach(btn=>{

    btn.addEventListener("click",function(e){

        e.preventDefault();

        closeModal();

    });

});

modal.addEventListener("click",function(e){

    if(e.target===modal){
        closeModal();
    }

});
</script>
