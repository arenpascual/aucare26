<form id="editForm"
      action="/uv/update/<%= patient._id %>"
      method="POST"
      class="width40 col justifyStart alignStart padding20 gap5 height0 shadow1 absolute translateCenter hidden"
      style="z-index:700;"
      novalidate>

    <p class="size30 str500">Edit Personal Information</p>

    <!-- GENDER -->
    <div class="field">
        <section class="gap10 justifyStart">

            <label>
                <input type="radio"
                       name="gender"
                       value="Male"
                       <%= patient.gender === 'Male' ? 'checked' : '' %>
                       required>
                Male
            </label>

            <label>
                <input type="radio"
                       name="gender"
                       value="Female"
                       <%= patient.gender === 'Female' ? 'checked' : '' %>
                       required>
                Female
            </label>

        </section>
    </div>


    <!-- FIRST + MIDDLE NAME -->
    <section class="gap10">

        <div class="field">
            <label>First Name</label>

            <input type="text"
                   name="fName"
                   id="editFName"
                   value="<%= patient.fName || '' %>"
                   maxlength="50"
                   pattern="^[A-Za-z\s\-']+$"
                   title="Letters, spaces, hyphens and apostrophes only"
                   required>
        </div>


        <div class="field">
            <label>Middle Name</label>

            <input type="text"
                   name="mName"
                   id="editMName"
                   value="<%= patient.mName || '' %>"
                   maxlength="50"
                   pattern="^[A-Za-z\s\-']*$"
                   title="Letters, spaces, hyphens and apostrophes only">
        </div>

    </section>


    <!-- LAST + EXTENSION NAME -->
    <section class="gap10">

        <div class="field">
            <label>Last Name</label>

            <input type="text"
                   name="lName"
                   id="editLName"
                   value="<%= patient.lName || '' %>"
                   maxlength="50"
                   pattern="^[A-Za-z\s\-']+$"
                   title="Letters, spaces, hyphens and apostrophes only"
                   required>
        </div>


        <div class="field">
            <label>Extension Name</label>

            <input type="text"
                   name="xName"
                   id="editXName"
                   value="<%= patient.xName || '' %>"
                   maxlength="10"
                   pattern="^[A-Za-z.\s]*$"
                   title="e.g. Jr., Sr., III"
                   placeholder="e.g. Jr., III">
        </div>

    </section>


    <!-- EMAIL + PHONE -->
    <section class="gap10">

        <div class="field">
            <label>Email</label>

            <input type="email"
                   name="email"
                   id="editEmail"
                   value="<%= patient.email || '' %>"
                   maxlength="100"
                   required>
        </div>


        <div class="field">
            <label>Contact Number</label>

            <input type="tel"
                   name="phone"
                   id="editPhone"
                   value="<%= patient.phone || '' %>"
                   placeholder="09XXXXXXXXX"
                   inputmode="numeric"
                   maxlength="11"
                   pattern="^09[0-9]{9}$"
                   title="Enter an 11-digit PH mobile number starting with 09"
                   required>
        </div>

    </section>


    <!-- ADDRESS -->
    <section>

        <div class="field">
            <label>Address</label>

            <input type="text"
                   name="address"
                   id="editAddress"
                   value="<%= patient.address || '' %>"
                   maxlength="150"
                   required>
        </div>

    </section>


    <!-- DATE OF BIRTH -->
    <div class="field padding10">

        <label>Date of Birth</label>

        <div class="row gap5">

            <!-- MONTH -->
            <div class="selectBar">

                <select name="bMonth"
                        id="bMonth"
                        required>

                    <option value=""
                            disabled
                            <%= !patient.bMonth ? 'selected' : '' %>>
                        --Month--
                    </option>

                    <option value="1"
                        <%= String(patient.bMonth) === '1' ? 'selected' : '' %>>
                        01
                    </option>

                    <option value="2"
                        <%= String(patient.bMonth) === '2' ? 'selected' : '' %>>
                        02
                    </option>

                    <option value="3"
                        <%= String(patient.bMonth) === '3' ? 'selected' : '' %>>
                        03
                    </option>

                    <option value="4"
                        <%= String(patient.bMonth) === '4' ? 'selected' : '' %>>
                        04
                    </option>

                    <option value="5"
                        <%= String(patient.bMonth) === '5' ? 'selected' : '' %>>
                        05
                    </option>

                    <option value="6"
                        <%= String(patient.bMonth) === '6' ? 'selected' : '' %>>
                        06
                    </option>

                    <option value="7"
                        <%= String(patient.bMonth) === '7' ? 'selected' : '' %>>
                        07
                    </option>

                    <option value="8"
                        <%= String(patient.bMonth) === '8' ? 'selected' : '' %>>
                        08
                    </option>

                    <option value="9"
                        <%= String(patient.bMonth) === '9' ? 'selected' : '' %>>
                        09
                    </option>

                    <option value="10"
                        <%= String(patient.bMonth) === '10' ? 'selected' : '' %>>
                        10
                    </option>

                    <option value="11"
                        <%= String(patient.bMonth) === '11' ? 'selected' : '' %>>
                        11
                    </option>

                    <option value="12"
                        <%= String(patient.bMonth) === '12' ? 'selected' : '' %>>
                        12
                    </option>

                </select>

            </div>


            <!-- DAY -->
            <input type="text"
                name="bDay"
                id="bDay"
                value="<%= patient.bDay || '' %>"
                placeholder="Day"
                inputmode="numeric"
                maxlength="2"
                pattern="^(0?[1-9]|[12][0-9]|3[01])$"
                title="Enter a valid day from 1 to 31"
                required>


            <!-- YEAR -->
            <div class="selectBar">

                <select name="bYear"
                        id="bYear"
                        required>

                    <option value=""
                            disabled
                            <%= !patient.bYear ? 'selected' : '' %>>
                        --Year--
                    </option>

                    <% const currentYear = new Date().getFullYear(); %>

                    <% for (let y = currentYear - 10; y >= currentYear - 80; y--) { %>

                        <option value="<%= y %>"
                            <%= String(patient.bYear) === String(y) ? 'selected' : '' %>>
                            <%= y %>
                        </option>

                    <% } %>

                </select>

            </div>

        </div>

        <p class="field-error" id="dobError"></p>

    </div>


    <p class="field-error"></p>


    <!-- BUTTONS -->
    <section class="gap20">

        <a href="javascript:void(0)"
           class="nav width100 closeEditBtn">
            Cancel
        </a>

        <button type="submit"
                class="nav pnav width100">
            Save Changes
        </button>

    </section>

</form>



