                <p class="size14 gray">Contact: <%= patient.ePhone || '—' %></p>
                <p class="size14 gray">Address: <%= patient.eAddress || '—' %></p>
            </section>
        </div>
    </div>
</div>

<div id="modal" class="bgWhite corner200 hidden">
