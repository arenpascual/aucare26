<% layout('layout') %>

<div class="height10 justifyBetween">
    <div class="width0 gap15">
        <a href="/um" class="nav "><i class="fas fa-chevron-left"></i> Return</a>
        <p class="size40 str400">Pending Accounts</p>
    </div>
    <div class="width0 gap8 ">
        <a href="" class="nav w100 marginTop5">Archive</a>
    </div>
</div>
<div class="height90 col justifyStart padding10">
    <div class="height0 justifyBetween">
        <div class="width0">
            <div class="selectBar w190"><i class="fas fa-filter"></i><select name="" id="">
                <option value=""></i> Filter By</option>
            </select></div>
        </div>
        <div class="width0 gap8 ">
            <div class="searchBar w220"><i class="fas fa-search"></i><input type="search" name="" id="pendingSearchInput" placeholder="Search name, ID, role, dept..."></div>
        </div>
    
    </div>
    <br>
    <table id="pendingTable">
        <thead>
            <tr>
                <th class="width10 bgTint10">#</th>
                <th class="width20 bgTint10"><i class="marginRight5 fa-solid fa-user"></i>Name</th>
                <th class="width15 bgTint10"><i class="marginRight5 fa-solid fa-id-card"></i>School ID</th>
                <th class="width15 bgTint10"><i class="marginRight5 fa-solid fa-user-gear"></i>Role</th>
                <th class="width20 bgTint10"><i class="marginRight5 fa-solid fa-building"></i>Department</th>
                <th class="width20 bgTint10">Actions</th>
            </tr>
        </thead>
        <tbody id="pendingTableBody">
            <% if (pendingUsers && pendingUsers.length > 0) { %>
                <% pendingUsers.forEach((u, index) => { %>
                    <tr id="row-<%= u._id %>">
                        <td><%= index + 1 %></td>
                        <td><a href="/uv?id=<%= u._id %>" class="underline navy"><%= u.fName %> <%= u.lName %></a></td>
                        <td><%= u.schoolId || '' %></td>
                        <td><%= u.role %></td>
                        <td><%= u.course || u.department || '' %></td>
                        <td class="gap8 row">
                            <section class="padding0 width100 gap10">
                                <a href="javascript:void(0)" class="approveBtn nav pnav" data-id="<%= u._id %>" title="Approve">
                                    <i class="fas fa-check"></i> Approve
                                </a>
                                <a href="javascript:void(0)" class="rejectBtn nav" data-id="<%= u._id %>" title="Reject">
                                    <i class="fas fa-times"></i>Decline
                                </a>
                            </section>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" class="alignCenter gray">No pending accounts.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
    <p id="noResultsMsg" class="size14 gray hidden" style="padding: 15px 0;">No matching pending accounts found.</p>

    <section class="absolute translateCenter shadow3 width30 padding30 gap10 index500 bgWhite col corner15 height0 hidden" id="appnotif">
        <img class="h100 w100" src="/images/like.png" alt="">
            <section class="padding0 col alignCenter">
                <p class="size20 str500 textCenter textBalance ">Everything looks in order -Ready to approve.</p>
            </section>
            <section class="justifyBetween gap10 padding0 ">
                <a class="nav width50 " href="javascript:void(0)">Cancel</a>
                <button class="nav pnav width50">Approve</button>
            </section>
    </section>

    <section class="absolute translateCenter shadow3 width30 padding30 gap10 index500 bgWhite col corner15 height0 hidden" id="rejnotif">
        <img class="h100 w100" src="/images/ekis.svg" alt="">
            <section class="padding0 col alignCenter">
                <p class="size20 str500 textCenter textBalance ">Are you sure you want to reject this account request?</p>
            </section>
            <section class="justifyBetween gap10 padding0 ">
                <a class="nav width50 " href="javascript:void(0)">Cancel</a>
                <button class="nav pnav width50">Decline</button>
            </section>
    </section>

</div>

<script>
// =============================
// LIVE SEARCH (Pending Accounts)
// =============================
const pendingSearchInput = document.getElementById('pendingSearchInput');
const pendingTableBody = document.getElementById('pendingTableBody');
const noResultsMsg = document.getElementById('noResultsMsg');

if (pendingSearchInput && pendingTableBody) {
    pendingSearchInput.addEventListener('input', function () {
        const query = this.value.trim().toLowerCase();
        const rows = Array.from(pendingTableBody.querySelectorAll('tr'));
        let visibleCount = 0;

        rows.forEach(row => {
            const rowText = row.textContent.toLowerCase();
            const matches = rowText.includes(query);
            row.style.display = matches ? '' : 'none';
            if (matches) visibleCount++;
        });

        if (noResultsMsg) {
            noResultsMsg.classList.toggle('hidden', visibleCount > 0);
        }
    });
}

// =============================
// APPROVE MODAL
// =============================
const appnotif = document.getElementById('appnotif');
const appCancelBtn = appnotif.querySelector('a.nav');
const appApproveBtn = appnotif.querySelector('button');

let selectedApproveId = null;

document.querySelectorAll('.approveBtn').forEach(btn => {
    btn.addEventListener('click', function () {
        selectedApproveId = this.dataset.id;
        appnotif.classList.remove('hidden');
    });
});

appCancelBtn.addEventListener('click', function (e) {
    e.preventDefault();
    appnotif.classList.add('hidden');
    selectedApproveId = null;
});

appApproveBtn.addEventListener('click', async function () {
    if (!selectedApproveId) return;

    try {
        const response = await fetch(`/api/users/approve/${selectedApproveId}`, {
            method: 'POST'
        });

        const data = await response.json();

        if (data.success) {
            const row = document.getElementById(`row-${selectedApproveId}`);
            if (row) row.remove();

            appnotif.classList.add('hidden');
            selectedApproveId = null;
        } else {
            alert(data.message || 'Failed to approve account.');
        }
    } catch (err) {
        console.error('Approve error:', err);
        alert('An error occurred while approving.');
    }
});

// =============================
// REJECT MODAL
// =============================
const rejnotif = document.getElementById('rejnotif');
const rejCancelBtn = rejnotif.querySelector('a.nav');
const rejDeclineBtn = rejnotif.querySelector('button');

let selectedRejectId = null;

document.querySelectorAll('.rejectBtn').forEach(btn => {
    btn.addEventListener('click', function () {
        selectedRejectId = this.dataset.id;
        rejnotif.classList.remove('hidden');
    });
});

rejCancelBtn.addEventListener('click', function (e) {
    e.preventDefault();
    rejnotif.classList.add('hidden');
    selectedRejectId = null;
});

rejDeclineBtn.addEventListener('click', async function () {
    if (!selectedRejectId) return;

    try {
        const response = await fetch(`/api/users/reject/${selectedRejectId}`, {
            method: 'POST'
        });

        const data = await response.json();

        if (data.success) {
            const row = document.getElementById(`row-${selectedRejectId}`);
            if (row) row.remove();

            rejnotif.classList.add('hidden');
            selectedRejectId = null;
        } else {
            alert(data.message || 'Failed to reject account.');
        }
    } catch (err) {
        console.error('Reject error:', err);
        alert('An error occurred while rejecting.');
    }
});
</script>