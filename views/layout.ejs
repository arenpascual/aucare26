<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .empCard:hover {
            box-shadow: var(--shadow1);
        }
        .empCard:hover img {
            border: 1px solid var(--blue500);
        }
        .empCard:hover p {
            color: var(--blue500);
        }
        .stCard:hover {
            cursor: pointer;
            box-shadow: var(--shadow2);
        }
        .stCard:hover img {
            border: 1px solid var(--blue500);
        }
        .stCard:hover p {
            color: var(--blue500);
        }
    </style>
</head>
<body>
    <% if ( user.reset === true ) { %>
    <div class="fgCard bgWhite absolute left0 top0 index100">
        <section class="height0 width30 bgWhite shadow1 col padding30 corner30 gap10">
            <p class="size30">Reset Password</p>
            <section class="height0 bgWhite alignStart col borderGray corner12">
                <p>Take Note! Password must contain the following:</p>
                <p>&bull; Minimum of 8 characters</p>
                <p>&bull; Combination of letter and number</p>
                <p>&bull; At least 1 upper case letter</p>
                <p>&bull; At least 1 special character</p>
            </section> 
            <br>
            <section class="field">
                <label class="str500 col alignStart" for="">Temporary Password</label>
                <input type="password" id="tempPassword" required>
                <i class="far fa-eye toggle-password"></i>
            </section>
            <section class="field">
                <label class="str500 col" for="">Create Password</label>
                <input type="password" id="newPassword" required>
                <i class="far fa-eye toggle-password"></i>
            </section>
            <section class="field">
                <label class="str500 col" for="">Confirm Password</label>
                <input type="password" id="confirmPassword" required>
                <i class="far fa-eye toggle-password"></i>
            </section>
            <p id="resetPassError" class="size13" style="color:red; display:none;"></p>
            <br>
            <section class="justifyBetween padding0">
                <button type="button" id="resetUpdateBtn" class="nav pnav w150" style="margin:0 auto;">Update</button>
            </section>
        </section>
    </div>

    <script>
        const resetPassError = document.getElementById('resetPassError');

        function showResetError(msg){
            resetPassError.textContent = msg;
            resetPassError.style.display = "block";
        }
        function clearResetError(){
            resetPassError.style.display = "none";
            resetPassError.textContent = "";
        }

        document.getElementById('resetUpdateBtn').onclick = async () => {
            clearResetError();

            const currentPassword = document.getElementById('tempPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (!currentPassword || !newPassword || !confirmPassword) {
                return showResetError("Please fill in all fields.");
            }
            if (newPassword !== confirmPassword) {
                return showResetError("New password and confirm password do not match.");
            }

            try {
                const res = await fetch('/api/account/reset-temp-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
                });
                const data = await res.json();

                if (data.success) {
                    alert("Password updated successfully!");
                    window.location.href = data.redirect || '/h';
                } else {
                    showResetError(data.message || "Failed to update password.");
                }
            } catch (err) {
                showResetError("Something went wrong. Please try again.");
            }
        };
    </script>
<% } %>
    <div class="sidef">
        <div class="height16 geo corner15 borderPrimary">
            <img src="/images/logo.png" alt="" class="corner500 h95 ">
        </div>
        <div class="height74 menu">
            <hr class="marginTop10">
            
            <% if (user.role === 'Super Admin' || user.role === 'Admin' ) { %>
            <a href="/d" class="nav mnav <% if ( active === 'd' ) { %> active <% } %>"><i class="bi bi-grid-fill"></i>Dashboard</a>
            <% } %>

            <a href="/r" class="nav mnav <% if ( active === 'r' ) { %> active <% } %>"><i class="fa-solid fa-file"></i>Requests</a>
            <a href="/v2" class="nav mnav <% if ( active === 'v2' ) { %> active <% } %>"><i class="fa-solid fa-stethoscope"></i>Visits</a>


            <% if (user.role === 'Super Admin' || user.role === 'Admin' ) { %>
            <a href="/st" class="nav mnav <% if ( active === 'st' ) { %> active <% } %>"><i class="fa-solid fa-boxes-stacked"></i>Stocks</a>
            <a href="/e" class="nav mnav <% if ( active === 'e' ) { %> active <% } %>"><i class="fa-solid fa-user-tie"></i>Admin</a>
            <a href="/um" class="nav mnav <% if ( active === 'um' ) { %> active <% } %>"><i class="fa-solid fa-user-friends"></i>Patients</a>
            <% } %>

            <% if (user.role === 'Super Admin') { %>
            <a href="/l" class="nav mnav <% if ( active === 'l' ) { %> active <% } %>"><i class="fa-solid fa-cog"></i>Activity Logs</a>
            <% } %>
        </div>
        <div class="height10 justifyStart corner15 bgTint12 padding10 gap10">
            <div class="width0">
                <a href="/p" class="height0 width0"><img src="/images/profile.png" alt="" class="h50 w50 corner500"></a>
            </div>
            <div class="width0 col alignStart">
                <% if ( active === 'p') { %>
                <p class="size14 str500">Profile Page</p>
                <p class="opacity0"><%= user.role %></p>
                <% } else { %>
                <p class="size14 str500" >Hi, <%= user.fName %></p>
                <p><%= user.role %></p>
                <% } %>
            </div>
        </div>
    </div>


    <div class="mainf shadow2">
        <%- body %>
    </div>
</body>
</html>6